# Ignore list for KiCAD Projects
# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.sch-bak
*~
*.lck
_autosave-*
\#*\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
# Netlist files (exported from Eeschema)
*.net
# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

#backups
*-backups/
.history/

# macOS
.DS_Store

# Firmware build scratch
# The committed out/*.bin etc. are kept on purpose (shipping ROM images);
# these are regenerable scratch outputs we do not need in the repo.
firmware/out/*.hex
