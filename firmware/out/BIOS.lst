000000r 1               ; simple6502 BIOS ROM
000000r 1               ; Written by Mariano Luna, 2024
000000r 1               ; License: BSD-3-Clause
000000r 1               ; https://opensource.org/license/bsd-3-clause
000000r 1               
000000r 1               .setcpu "65C02"           ; Thats what we got
000000r 1               .debuginfo +
000000r 1               
000000r 1               .define VERSION "0.9.0"   ; Define the version number
000000r 1               
000000r 1               .include "defines_simple6502.s" ; Include HW Constants and Labels
000000r 2               ; Herdware for the simple6502 SBC board
000000r 2               ;
000000r 2               ; This file has the common labels, variables and costants that define the
000000r 2               ; herdware of my simple6502 SBC https://github.com/marianol/simple6502/
000000r 2               ; is ment to be included in source files and keep hardware related data
000000r 2               ; separated from the main assembly code.
000000r 2               
000000r 2               ; simple6502 SBC
000000r 2               ; Memory Map Address Space
000000r 2               ; 0x0000 - 0x7EFF : RAM 32K - 256 bytes (31.75K)
000000r 2               ; 0x7F00 - 0x7FFF : I/O 256 bytes decoded to 8 IO lines
000000r 2               ; 0x8000 - 0xFFFF : ROM 32K
000000r 2               ; Clock is @1.8432MHz so 0.542534722us per cycle
000000r 2               
000000r 2               ; I/O Space
000000r 2               IO_1    = $7F00 ; Slot #1 0x7F00 - 0x7F0F
000000r 2               IO_2    = $7F10 ; Slot #2 0x7F10 - 0x7F1F
000000r 2               IO_3    = $7F20 ; VIA #1  0x7F20 - 0x7F2F
000000r 2               IO_4    = $7F30 ; Available 0x7F30 - 0x7F3F
000000r 2               IO_5    = $7F40 ; Available 0x7F40 - 0x7F4F
000000r 2               IO_6    = $7F50 ; Available 0x7F50 - 0x7F5F
000000r 2               IO_7    = $7F60 ; Available 0x7F60 - 0x7F6F
000000r 2               IO_8    = $7F70 ; MC68B50 ACIA  0x7F70 - 0x7F7F
000000r 2               ;  0x7F80 - 0x7FFF : This section is not decoded 127 bytes
000000r 2               
000000r 2               ; -----------
000000r 2               ; ACIA MC68B50
000000r 2               ; The simple6502 has an serial interface on board at IO_8
000000r 2               ; the ACIA is driven by the main clock (CLK) @ 1.8432Mhz
000000r 2               ; RS is tied to A0 and CS0 is tied to A1
000000r 2               ; The 68B50 Control register is as follows:
000000r 2               ; - Bit 0-1: Config clock Divider & Reset > 00: ÷1, 01: ÷16, 10: ÷64, 11: Master reset
000000r 2               ; - Bit 2-4: Config bit length, parity & stop >
000000r 2               ; - Bit 5-6: TX control bits
000000r 2               ;               > 00: RTSB low, TDRE IRQ disabled
000000r 2               ;               > 01: RTSB low, TDRE IRQ enabled
000000r 2               ;               > 10: RTSB high, TDRE IRQ disabled
000000r 2               ;               > 11: RTSB low, transmits brake level, TDRE disabled
000000r 2               ; - Bit 7: RX IRQ 0 Disabled / 1 Enabled
000000r 2               
000000r 2               ACIA_BASE     = IO_8
000000r 2               ACIA_STATUS   = ACIA_BASE + 2   ; Read RS 0 + R
000000r 2               ACIA_CONTROL  = ACIA_BASE + 2   ; Write RS 0 + W
000000r 2               ACIA_DATA     = ACIA_BASE + 3   ; RS 1 + R/W > RX/TX
000000r 2               
000000r 2               ; ACIA Preset Configurations
000000r 2               ; This are intended to simplify config of the CTRL register
000000r 2               ACIA_CFG_115    = %00010101    ; 8-N-1, 115200bps, no IRQ - /16 CLK
000000r 2               ACIA_CFG_115I   = %10010101    ; 8-N-1, 115200bps, IRQ - /16 CLK
000000r 2               ACIA_CFG_28     = %00010110    ; 8-N-1, 28800bps, no IRQ - /64 CLK
000000r 2               ACIA_CFG_28I    = %10010110    ; 8-N-1, 28800bps, IRQ - /64 CLK
000000r 2               
000000r 2               ; ACIA Helper Constants
000000r 2               ACIA_TDRE       = %00000010    ; bitmask for TRDE
000000r 2               ACIA_RDRF       = %00000001    ; bitmask for RDRF
000000r 2               ACIA_RESET      = %00000011    ; 6850 reset
000000r 2               
000000r 2               ; 6522 VIA
000000r 2               ; The VIA is not onboard in Rev 1.6 PCB
000000r 2               ; but reserving this I/O for the main VIA
000000r 2               ;
000000r 2               ; VIA Interrupt Flag Register (IFR) Reference
000000r 2               ; BIT   |  0  |  1  |  2       |  3  |  4  |   5    |   6    |  7  |
000000r 2               ; Desc  | CA2 | CA1 | Shift    | CB2 | CB1 | Timer2 | Timer2 | IRQ |
000000r 2               ;                     Register
000000r 2               VIA1_BASE   = IO_3
000000r 2               VIA1_PORTB  = VIA1_BASE         ; $7F20
000000r 2               VIA1_PORTA  = VIA1_BASE + 1     ; $7F21
000000r 2               VIA1_DDRB   = VIA1_BASE + 2     ; $7F22
000000r 2               VIA1_DDRA   = VIA1_BASE + 3     ; $7F23
000000r 2               VIA1_T1CL   = VIA1_BASE + 4     ; $7F24 T1C-L Timer 1 Counter (low byte)
000000r 2               VIA1_T1CH   = VIA1_BASE + 5     ; $7F25 T1C-H Timer 1 Counter (high byte)
000000r 2               VIA1_T1L    = VIA1_BASE + 6     ; $7F26 T1L-L
000000r 2               VIA1_T1H    = VIA1_BASE + 7     ; $7F27 T1L-H
000000r 2               VIA1_T2CL   = VIA1_BASE + 8     ; $7F28 T2C-L
000000r 2               VIA1_T2CH   = VIA1_BASE + 9     ; $7F29 T2C-H
000000r 2               VIA1_SR     = VIA1_BASE + 10    ; $7F2A SR Shift Register
000000r 2               VIA1_ACR    = VIA1_BASE + 11    ; $7F2B Auxiliary Control register @
000000r 2               VIA1_PCR    = VIA1_BASE + 12    ; PCR Peripheral Control Register
000000r 2               VIA1_IFR    = VIA1_BASE + 13    ; $7F2D IFR > Interrupt Flag Register
000000r 2               VIA1_IER    = VIA1_BASE + 14    ; $7F2E ; Interrupt Enable Register
000000r 2               
000000r 2               ; VIA helper constants
000000r 2               ; ACR (Auxiliary Control Register): bit7=T1 PB7 output, bit6=T1 continuous.
000000r 2               ; $40 = Timer 1 free-run (continuous interrupts), PB7 disabled, shift reg off.
000000r 2               VIA_ACR_T1_FREERUN = %01000000
000000r 2               ; IER (Interrupt Enable Register): bit7=set/clear flag, bit6=Timer 1.
000000r 2               ; Writing $C0 sets (enables) the Timer 1 interrupt; $7F clears all enables.
000000r 2               VIA_IER_T1_ENABLE  = %11000000
000000r 2               VIA_IER_CLR_ALL    = %01111111
000000r 2               ; IFR (Interrupt Flag Register): bit6 = Timer 1.
000000r 2               VIA_IFR_T1         = %01000000
000000r 2               
000000r 2               ; Timer 1 reload value for a ~10ms periodic tick at 1.8432 MHz.
000000r 2               ; 10ms = 18432 cycles. In free-run the effective period is (N+2) cycles,
000000r 2               ; so load N = 18432 - 2 = 18430 = $47FE.
000000r 2               VIA_T1_10MS        = 18430
000000r 2               
000000r 2               
000000r 2               ; ### Zero Page ###
000000r 2               ; The zero page variables are declared in zeropage.s (the zero page map), not here.
000000r 2               ; Include zeropage.s next to this file in the sources that use them.
000000r 2               
000000r 2               
000000r 2               ; ### Useful Constants ###
000000r 2               ; ASCII
000000r 2               CR      = $0D
000000r 2               LF      = $0A
000000r 2               BS      = $08
000000r 2               DEL     = $7F
000000r 2               SPACE   = $20
000000r 2               ESC     = $1B
000000r 2               NULL    = $00
000000r 2               
000000r 1               .include "zeropage.s"           ; Zero page map (all ZP variables are declared there)
000000r 2               ; simple6502 zero page map
000000r 2               ;
000000r 2               ; This is the one place where zero page variables are declared. Do NOT add
000000r 2               ; "NAME = $xx" equates for zero page variables to a defines file: declare the
000000r 2               ; variable here with .res inside the block it belongs to. That way the
000000r 2               ; assembler allocates the bytes, a block that grows is caught by the .assert
000000r 2               ; at the end of the block, and the whole map can be read in one file.
000000r 2               ; See docs/ZEROPAGE_MAP.md for the full map with the BASIC variables.
000000r 2               ;
000000r 2               ; Layout rules:
000000r 2               ;  - Each block is anchored with .org at a FIXED address and its variables
000000r 2               ;    follow each other with .res. Do not move a block: programs (and the jump
000000r 2               ;    table, e.g. BIOS_SERIAL_STR reads PTR_TX) rely on these addresses.
000000r 2               ;  - Several labels in front of one .res are aliases of the same bytes
000000r 2               ;    (TOCKS and TOCKS_L, PTR_TX and PTR_TX_L ...).
000000r 2               ;  - WozMon relies on XAML/XAMH, STL/STH and L/H being adjacent, in that order.
000000r 2               ;  - BASIC owns BASIC_ZP_START..BASIC_ZP_END. It declares its variables in
000000r 2               ;    basic/zeropage_basic.s. It shares RAM_SIZE with the BIOS (BASIC's MEMSIZ).
000000r 2               ;
000000r 2               ; This file is included by BIOS.s and by basic/msbasic.s, so both builds check
000000r 2               ; their blocks against the same map.
000000r 2               
000000r 2               ; The zero page range reserved for BASIC. Its variables are declared in
000000r 2               ; basic/zeropage_basic.s, which checks that they stay inside this range.
000000r 2               ; $4A-$DD: the BASIC variables, the copy of the CHRGET code and RNDSEED.
000000r 2               ; $DE-$DF stay free as spare.
000000r 2               BASIC_ZP_START = $4A
000000r 2               BASIC_ZP_END   = $DD
000000r 2               
000000r 2               .feature org_per_seg
000000r 2               .zeropage
000000r 2               
000000r 2               ; ----------------------------------------------------------------------------
000000r 2               ; $00 fault beacon scratch
000000r 2               ; post_fail writes $01/$00 here to toggle D0 on the data bus.
000000r 2               ; ----------------------------------------------------------------------------
000000r 2               .org $00
000000  2               ZP_START:
000000  2  xx             .res 1
000001  2               .assert * <= $24, error, "zero page: block at $00 runs into WozMon variables"
000001  2               
000001  2               ; ----------------------------------------------------------------------------
000001  2               ; $24-$2B WozMon
000001  2               ; ----------------------------------------------------------------------------
000001  2               .org $24
000024  2               XAML:                   ; Last "opened" location Low
000024  2  xx             .res 1
000025  2               XAMH:                   ; Last "opened" location High
000025  2  xx             .res 1
000026  2               STL:                    ; Store address Low
000026  2  xx             .res 1
000027  2               STH:                    ; Store address High
000027  2  xx             .res 1
000028  2               L:                      ; Hex value parsing Low
000028  2  xx             .res 1
000029  2               H:                      ; Hex value parsing High
000029  2  xx             .res 1
00002A  2               YSAV:                   ; Used to see if hex value is given
00002A  2  xx             .res 1
00002B  2               MODE:                   ; $00=XAM, $7F=STOR, $AE=BLOCK XAM
00002B  2  xx             .res 1
00002C  2               .assert * <= $30, error, "zero page: WozMon block runs into the Intel HEX variables"
00002C  2               
00002C  2               ; ----------------------------------------------------------------------------
00002C  2               ; $30-$35 Intel HEX load/save scratch
00002C  2               ; ----------------------------------------------------------------------------
00002C  2               .org $30
000030  2               IHEX_ADDR:              ; record load address (LO/HI)
000030  2               IHEX_ADDR_L:
000030  2  xx             .res 1
000031  2               IHEX_ADDR_H:
000031  2  xx             .res 1
000032  2               IHEX_LEN:               ; record byte count
000032  2  xx             .res 1
000033  2               IHEX_TYPE:              ; record type (00 data, 01 EOF)
000033  2  xx             .res 1
000034  2               IHEX_SUM:               ; running checksum accumulator
000034  2  xx             .res 1
000035  2               IHEX_TMP:               ; general scratch
000035  2  xx             .res 1
000036  2               .assert * <= $40, error, "zero page: Intel HEX block runs into the register print variables"
000036  2               
000036  2               ; ----------------------------------------------------------------------------
000036  2               ; $40-$46 monitor register print
000036  2               ; ----------------------------------------------------------------------------
000036  2               .org $40
000040  2               P_STATUS:
000040  2               PC_REG_H:
000040  2  xx             .res 1
000041  2               PC_REG_L:
000041  2  xx             .res 1
000042  2               SP_REG:
000042  2  xx             .res 1
000043  2               A_REG:
000043  2  xx             .res 1
000044  2               X_REG:
000044  2  xx             .res 1
000045  2               Y_REG:
000045  2  xx             .res 1
000046  2               SR_REG:
000046  2  xx             .res 1
000047  2               .assert * <= BASIC_ZP_START, error, "zero page: register print block runs into the BASIC variables"
000047  2               
000047  2               ; ----------------------------------------------------------------------------
000047  2               ; BASIC_ZP_START-BASIC_ZP_END: reserved for BASIC, see the top of this file.
000047  2               ; ----------------------------------------------------------------------------
000047  2               
000047  2               ; ----------------------------------------------------------------------------
000047  2               ; $E0-$EC BIOS system variables
000047  2               ; ----------------------------------------------------------------------------
000047  2               .org $E0
0000E0  2               TOCKS:                  ; Jiffy-like clock, 3 bytes, ~10ms per tick
0000E0  2               TOCKS_L:
0000E0  2  xx             .res 1
0000E1  2               TOCKS_M:
0000E1  2  xx             .res 1
0000E2  2               TOCKS_H:
0000E2  2  xx             .res 1
0000E3  2               RAM_SIZE:               ; RAM size, 2 bytes: top usable RAM address + 1.
0000E3  2               RAM_SIZE_L:             ; The POST writes it, BASIC reads it as MEMSIZ.
0000E3  2  xx             .res 1
0000E4  2               RAM_SIZE_H:
0000E4  2  xx             .res 1
0000E5  2               PTR_RD_RX_BUF:          ; RX Read Buffer Pointer
0000E5  2  xx             .res 1
0000E6  2               PTR_WR_RX_BUF:          ; RX Write Buffer Pointer
0000E6  2  xx             .res 1
0000E7  2               PTR_TX:                 ; Transmit string pointer (used by BIOS_SERIAL_STR)
0000E7  2               PTR_TX_L:
0000E7  2  xx             .res 1
0000E8  2               PTR_TX_H:
0000E8  2  xx             .res 1
0000E9  2               POST_PTR:               ; POST RAM-walk pointer, 2 bytes
0000E9  2  xx xx          .res 2
0000EB  2               VIA_PRESENT:            ; non-zero if VIA1 was detected and initialized
0000EB  2  xx             .res 1
0000EC  2               BASIC_STARTED:          ; non-zero once BASIC has been cold started. The BIOS reset clears it and
0000EC  2  xx             .res 1                ; BASIC's cold start sets it. The monitor X command warm starts BASIC only
0000ED  2                                       ; if it is set, because a warm start needs what the cold start sets up.
0000ED  2               .assert * <= $100, error, "zero page: BIOS system block runs past the end of the zero page"
0000ED  2               .assert TOCKS > BASIC_ZP_END, error, "zero page: BIOS system block overlaps the BASIC variables"
0000ED  2               
0000ED  1               
0000ED  1               ; -- ROM START --
0000ED  1               ;.org $8000
0000ED  1               
0000ED  1               ; ## BIOS Jump Table (public ABI) ##
0000ED  1               ; The fixed-address jump table at the start of ROM is in bios_header.s (the HEADER
0000ED  1               ; segment). Its entries are APPEND-ONLY, read the contract at the top of that file.
0000ED  1               ; bios_jumptable.inc has the public equates and is checked against the table.
0000ED  1               .include "bios_jumptable.inc"
0000ED  2               ; simple6502 BIOS - Public Jump Table (ABI)
0000ED  2               ;
0000ED  2               ; Fixed entry-point addresses for the BIOS routines. External programs that run
0000ED  2               ; on the simple6502 (user programs, loaders, future BASIC, etc.) should call
0000ED  2               ; these addresses rather than the BIOS's internal labels, which move whenever
0000ED  2               ; the BIOS is rebuilt.
0000ED  2               ;
0000ED  2               ; The table lives at the start of ROM ($8000); each entry is a 3-byte JMP.
0000ED  2               ;
0000ED  2               ; CONTRACT: the table is APPEND-ONLY. Addresses here are frozen. New routines
0000ED  2               ; are added at the end (next free slot). Never insert or reorder.
0000ED  2               ;
0000ED  2               ; Usage from an assembly program:
0000ED  2               ;     .include "bios_jumptable.inc"
0000ED  2               ;     lda #'A'
0000ED  2               ;     jsr BIOS_SERIAL_OUT
0000ED  2               
0000ED  2               BIOS_JUMPTABLE = $8000              ; base address of the table
0000ED  2               
0000ED  2               BIOS_COLD_START = BIOS_JUMPTABLE + 0*3   ; $8000 cold start / reset
0000ED  2               BIOS_MONITOR    = BIOS_JUMPTABLE + 1*3   ; $8003 enter WozMon
0000ED  2               BIOS_SERIAL_OUT = BIOS_JUMPTABLE + 2*3   ; $8006 transmit A over serial
0000ED  2               BIOS_SERIAL_IN  = BIOS_JUMPTABLE + 3*3   ; $8009 receive byte (carry set if data in A)
0000ED  2               BIOS_SERIAL_STR = BIOS_JUMPTABLE + 4*3   ; $800C transmit null-terminated string @ PTR_TX
0000ED  2               BIOS_SERIAL_HEX = BIOS_JUMPTABLE + 5*3   ; $800F transmit A as two ASCII hex digits
0000ED  2               BIOS_OUT_CRLF   = BIOS_JUMPTABLE + 6*3   ; $8012 transmit CR + LF
0000ED  2               BIOS_SERIAL_POLL = BIOS_JUMPTABLE + 7*3  ; $8015 receive byte, no echo (carry set if data in A)
0000ED  2               BIOS_BASIC_COLD = BIOS_JUMPTABLE + 8*3   ; $8018 cold start MS BASIC (new program, memory cleared)
0000ED  2               BIOS_BASIC_WARM = BIOS_JUMPTABLE + 9*3   ; $801B warm start MS BASIC (keeps the program and variables)
0000ED  2               BIOS_LOAD       = BIOS_JUMPTABLE + 10*3  ; $801E BASIC LOAD (stub for now, just RTS)
0000ED  2               BIOS_SAVE       = BIOS_JUMPTABLE + 11*3  ; $8021 BASIC SAVE (stub for now, just RTS)
0000ED  2               
0000ED  2               ; MS BASIC's own entry points, the two JMPs at the start of its ROM region
0000ED  2               ; (basic/header.s, BASROM at $DC00 in simple6502.cfg). The jump table slots above
0000ED  2               ; go there. basic/header.s checks at link time that BASIC really starts at these.
0000ED  2               BASIC_COLD_START = $DC00            ; cold start
0000ED  2               BASIC_WARM_START = $DC03            ; warm start (RESTART)
0000ED  2               
0000ED  1               .include "bios_header.s"
0000ED  2               ; simple6502 BIOS header: the jump table (public ABI)
0000ED  2               ;
0000ED  2               ; Fixed-address entry points so external programs can call BIOS routines at
0000ED  2               ; stable addresses that never change as the BIOS internals grow.
0000ED  2               ;
0000ED  2               ; The table lives at the very start of ROM ($8000) and each entry is a 3-byte
0000ED  2               ; JMP. CONTRACT: entries are APPEND-ONLY. Never insert, reorder, or remove a
0000ED  2               ; slot - that would shift every entry below it and break existing binaries.
0000ED  2               ; Add new routines to the end only.
0000ED  2               ;
0000ED  2               ; Slot  Address  Routine
0000ED  2               ; ----  -------  ----------------------------------------------------------
0000ED  2               ;  0    $8000    J_COLD_START  - cold start / reset entry
0000ED  2               ;  1    $8003    J_MONITOR     - enter WozMon monitor
0000ED  2               ;  2    $8006    J_SERIAL_OUT  - transmit A over serial
0000ED  2               ;  3    $8009    J_SERIAL_IN   - receive a byte (carry set if data)
0000ED  2               ;  4    $800C    J_SERIAL_STR  - transmit null-terminated string @ PTR_TX
0000ED  2               ;  5    $800F    J_SERIAL_HEX  - transmit A as two ASCII hex digits
0000ED  2               ;  6    $8012    J_OUT_CRLF    - transmit CR+LF
0000ED  2               ;  7    $8015    J_SERIAL_POLL - receive a byte, no echo (carry set if data)
0000ED  2               ;  8    $8018    J_BASIC_COLD  - cold start MS BASIC (new program, memory cleared)
0000ED  2               ;  9    $801B    J_BASIC_WARM  - warm start MS BASIC (keeps the program and variables)
0000ED  2               ; 10    $801E    J_LOAD        - BASIC LOAD (stub for now, just RTS)
0000ED  2               ; 11    $8021    J_SAVE        - BASIC SAVE (stub for now, just RTS)
0000ED  2               ;
0000ED  2               ; The equates for these addresses live in bios_jumptable.inc for programs to
0000ED  2               ; include. The .asserts at the end of this file stop the build if the two get
0000ED  2               ; out of sync, so when you append an entry here also add its equate there.
0000ED  2               ;
0000ED  2               ; Included by BIOS.s. The routines the entries jump to are in BIOS.s and
0000ED  2               ; wozmon_sbc.s. BIOS.s includes bios_jumptable.inc before this file.
0000ED  2               
0000ED  2               .segment "HEADER"
000000r 2  4C rr rr     J_COLD_START:  jmp reset            ; slot 0  $8000
000003r 2  4C rr rr     J_MONITOR:     jmp WOZMON           ; slot 1  $8003
000006r 2  4C rr rr     J_SERIAL_OUT:  jmp serial_out       ; slot 2  $8006
000009r 2  4C rr rr     J_SERIAL_IN:   jmp serial_in        ; slot 3  $8009
00000Cr 2  4C rr rr     J_SERIAL_STR:  jmp serial_out_str   ; slot 4  $800C
00000Fr 2  4C rr rr     J_SERIAL_HEX:  jmp serial_out_hex   ; slot 5  $800F
000012r 2  4C rr rr     J_OUT_CRLF:    jmp out_crlf         ; slot 6  $8012
000015r 2  4C rr rr     J_SERIAL_POLL: jmp serial_poll      ; slot 7  $8015
000018r 2  4C 00 DC     J_BASIC_COLD:  jmp BASIC_COLD_START ; slot 8  $8018  BASIC's own entry, $DC00
00001Br 2  4C 03 DC     J_BASIC_WARM:  jmp BASIC_WARM_START ; slot 9  $801B  BASIC's own entry, $DC03
00001Er 2  4C rr rr     J_LOAD:        jmp bios_load        ; slot 10 $801E
000021r 2  4C rr rr     J_SAVE:        jmp bios_save        ; slot 11 $8021
000024r 2               
000024r 2               ; Keep MONITOR as an alias for existing code that referenced it.
000024r 2               MONITOR = J_MONITOR
000024r 2               
000024r 2               ; The table must match bios_jumptable.inc. The table is in a relocatable segment,
000024r 2               ; so the linker checks these once it has placed HEADER at $8000.
000024r 2               .assert J_COLD_START  = BIOS_COLD_START,  lderror, "jump table slot 0 does not match bios_jumptable.inc"
000024r 2               .assert J_MONITOR     = BIOS_MONITOR,     lderror, "jump table slot 1 does not match bios_jumptable.inc"
000024r 2               .assert J_SERIAL_OUT  = BIOS_SERIAL_OUT,  lderror, "jump table slot 2 does not match bios_jumptable.inc"
000024r 2               .assert J_SERIAL_IN   = BIOS_SERIAL_IN,   lderror, "jump table slot 3 does not match bios_jumptable.inc"
000024r 2               .assert J_SERIAL_STR  = BIOS_SERIAL_STR,  lderror, "jump table slot 4 does not match bios_jumptable.inc"
000024r 2               .assert J_SERIAL_HEX  = BIOS_SERIAL_HEX,  lderror, "jump table slot 5 does not match bios_jumptable.inc"
000024r 2               .assert J_OUT_CRLF    = BIOS_OUT_CRLF,    lderror, "jump table slot 6 does not match bios_jumptable.inc"
000024r 2               .assert J_SERIAL_POLL = BIOS_SERIAL_POLL, lderror, "jump table slot 7 does not match bios_jumptable.inc"
000024r 2               .assert J_BASIC_COLD  = BIOS_BASIC_COLD,  lderror, "jump table slot 8 does not match bios_jumptable.inc"
000024r 2               .assert J_BASIC_WARM  = BIOS_BASIC_WARM,  lderror, "jump table slot 9 does not match bios_jumptable.inc"
000024r 2               .assert J_LOAD        = BIOS_LOAD,        lderror, "jump table slot 10 does not match bios_jumptable.inc"
000024r 2               .assert J_SAVE        = BIOS_SAVE,        lderror, "jump table slot 11 does not match bios_jumptable.inc"
000024r 2               
000024r 1               
000024r 1               ; ## BIOS Start ##
000024r 1               .segment "BIOS"
000000r 1  73 69 6D 70    .byte "simple6502 BIOS Ver: "
000004r 1  6C 65 36 35  
000008r 1  30 32 20 42  
000015r 1  30 2E 39 2E    .byte VERSION
000019r 1  30           
00001Ar 1               
00001Ar 1               ; Reset Vector Start
00001Ar 1               reset:
00001Ar 1  78             sei               ; 78      disable interrupts
00001Br 1  D8             cld               ; D8      turn decimal mode off
00001Cr 1               
00001Cr 1                 ; --- Memory Check: Zero Page and Stack (Page 1) ---
00001Cr 1                 ; These run BEFORE the stack is used so we can test Page 1
00001Cr 1                 ; Using ONLY the A and X and immediate values - no ZP variables, no stack.
00001Cr 1                 ; A mismatch jumps to post_fail.
00001Cr 1               
00001Cr 1                 ; Test Zero Page ($0000-$00FF): checkerboard $55 then $AA
00001Cr 1  A2 00          ldx #0
00001Er 1               @zp_55:
00001Er 1  A9 55          lda #$55
000020r 1  95 00          sta $00,x
000022r 1  D5 00          cmp $00,x
000024r 1  D0 4A          bne post_fail
000026r 1  E8             inx
000027r 1  D0 F5          bne @zp_55
000029r 1               @zp_aa:
000029r 1  A9 AA          lda #$AA
00002Br 1  95 00          sta $00,x         ; x wrapped back to 0
00002Dr 1  D5 00          cmp $00,x
00002Fr 1  D0 3F          bne post_fail
000031r 1  E8             inx
000032r 1  D0 F5          bne @zp_aa
000034r 1               
000034r 1                 ; Test Stack page / Page 1 ($0100-$01FF): safe to clobber, nothing pushed yet
000034r 1  A2 00          ldx #0
000036r 1               @sp_55:
000036r 1  A9 55          lda #$55
000038r 1  9D 00 01       sta $0100,x
00003Br 1  DD 00 01       cmp $0100,x
00003Er 1  D0 30          bne post_fail
000040r 1  E8             inx
000041r 1  D0 F3          bne @sp_55
000043r 1               @sp_aa:
000043r 1  A9 AA          lda #$AA
000045r 1  9D 00 01       sta $0100,x       ; x wrapped back to 0
000048r 1  DD 00 01       cmp $0100,x
00004Br 1  D0 23          bne post_fail
00004Dr 1  E8             inx
00004Er 1  D0 F3          bne @sp_aa
000050r 1               
000050r 1                 ; ZP and stack are good - establish the stack pointer and carry on.
000050r 1  A2 FF          ldx #$FF          ; A2 FF
000052r 1  9A             txs               ; 9A      set the stack start
000053r 1  64 EC          stz BASIC_STARTED ; BASIC has not been started (the ZP test left $AA here)
000055r 1  20 rr rr       jsr post          ; do the rest of POST (RAM walk)
000058r 1  20 rr rr       jsr init_serial   ; init ACIA # IO_8
00005Br 1  20 rr rr       jsr via_init      ; detect + init VIA1 (sets carry if present)
00005Er 1                 ; Print startup message (BIOS banner)
00005Er 1  A9 rr          lda #<startupMessage
000060r 1  85 E7          sta PTR_TX
000062r 1  A9 rr          lda #>startupMessage
000064r 1  85 E8          sta PTR_TX_H
000066r 1  20 rr rr       jsr serial_out_str
000069r 1                 ; If VIA1 was detected, announce it under the banner: "## VIA1 on $7F20"
000069r 1  20 rr rr       jsr via_report
00006Cr 1  58             cli               ; enable IRQs now that handlers/VIA are set up
00006Dr 1  4C rr rr       jmp WOZMON_COLD   ; go to the monitor
000070r 1               
000070r 1               
000070r 1               
000070r 1               ; ### Subrutines ###
000070r 1               
000070r 1               ; post_fail:
000070r 1               ; Reached when the early ZP or Stack test fails. Serial is NOT up yet and we
000070r 1               ; have no onboard failure indicator (LED/beeper) in rev 1.6 - that hardware is
000070r 1               ; TODO. As a placeholder, we signal the fault on the DATA BUS: repeatedly
000070r 1               ; writing $01 then $00 to a Zero Page location drives D0 with a steady ~1 kHz
000070r 1               ; pattern (D1-D7 idle low) that can be caught with a scope or logic probe.
000070r 1               ; This never returns - a failed ZP/stack test is terminal.
000070r 1               ; Placed right before the POST tests so the reset-vector ZP/stack checks can
000070r 1               ; reach it with a direct conditional branch (no trampoline needed).
000070r 1               ;
000070r 1               ; Timing: target ~1 kHz (1 ms period, 500 us per half) at 1.8432 MHz
000070r 1               ; (~922 cycles per half-period). Each half is a write (~5 cyc) plus the
000070r 1               ; delay loop dex/bne (5 cyc per iteration): X=$B6 (182) -> ~910 loop cycles
000070r 1               ; + overhead ~= 920 cycles ~= 499 us -> ~1.0 kHz. Exact frequency is not
000070r 1               ; important for a fault beacon; this just lands it near 1 kHz on a probe.
000070r 1               ; Uses only the A and X registers - no ZP variables, no stack (it may be
000070r 1               ; entered before the stack is trusted).
000070r 1               post_fail:
000070r 1  A9 01          lda #$01
000072r 1  85 00          sta ZP_START          ; write 1 -> D0 high on the bus
000074r 1  A2 B6          ldx #$B6              ; 182 -> ~half period delay (~500 us)
000076r 1               @fh:
000076r 1  CA             dex
000077r 1  D0 FD          bne @fh
000079r 1  A9 00          lda #$00
00007Br 1  85 00          sta ZP_START          ; write 0 -> D0 low on the bus
00007Dr 1  A2 B6          ldx #$B6
00007Fr 1               @fl:
00007Fr 1  CA             dex
000080r 1  D0 FD          bne @fl
000082r 1  80 EC          bra post_fail         ; loop forever (fault beacon)
000084r 1               
000084r 1               ; post:
000084r 1               ; Power on Self Test
000084r 1               ; post runs after the early ZP/stack test, so the
000084r 1               ; stack is already trusted here and we may use subroutines/registers freely.
000084r 1               post:
000084r 1                 ; --- Walk RAM from $0200 up, store top of RAM in RAM_SIZE ---
000084r 1                 ; Checkerboard-test each byte ($55 then $AA) and read it back. Stop at the
000084r 1                 ; first byte that fails or when we reach the I/O space at $7F00 (we must
000084r 1                 ; NOT write into $7F00+ which would hit real hardware registers). RAM_SIZE
000084r 1                 ; holds the first non-RAM address, i.e. (top usable RAM address + 1).
000084r 1                 ; This is destructive, which is fine at cold boot (RAM is undefined anyway).
000084r 1  A9 00          lda #$00
000086r 1  85 E9          sta POST_PTR          ; pointer low  = $00
000088r 1  A9 02          lda #$02
00008Ar 1  85 EA          sta POST_PTR+1        ; pointer high = $02  -> start at $0200
00008Cr 1               @ram_walk:
00008Cr 1                 ; stop once we reach I/O space ($7F00)
00008Cr 1  A5 EA          lda POST_PTR+1
00008Er 1  C9 7F          cmp #$7F
000090r 1  F0 1E          beq @ram_done         ; high byte $7F and low byte $00 -> at $7F00
000092r 1  A0 00          ldy #0
000094r 1  A9 55          lda #$55              ; pattern 1
000096r 1  91 E9          sta (POST_PTR),y
000098r 1  B1 E9          lda (POST_PTR),y
00009Ar 1  C9 55          cmp #$55
00009Cr 1  D0 12          bne @ram_done         ; readback failed -> end of RAM
00009Er 1  A9 AA          lda #$AA              ; pattern 2
0000A0r 1  91 E9          sta (POST_PTR),y
0000A2r 1  B1 E9          lda (POST_PTR),y
0000A4r 1  C9 AA          cmp #$AA
0000A6r 1  D0 08          bne @ram_done         ; readback failed -> end of RAM
0000A8r 1                 ; byte good, advance pointer
0000A8r 1  E6 E9          inc POST_PTR
0000AAr 1  D0 E0          bne @ram_walk
0000ACr 1  E6 EA          inc POST_PTR+1
0000AEr 1  80 DC          bra @ram_walk
0000B0r 1               @ram_done:
0000B0r 1                 ; POST_PTR now points one past the last good RAM byte -> store as RAM_SIZE
0000B0r 1  A5 E9          lda POST_PTR
0000B2r 1  85 E3          sta RAM_SIZE_L
0000B4r 1  A5 EA          lda POST_PTR+1
0000B6r 1  85 E4          sta RAM_SIZE_H
0000B8r 1               
0000B8r 1                 ; --- VIA1 Timer 1 periodic tick (TOCKS jiffy clock) ---
0000B8r 1                 ; STUB: left for when the VIA routines are implemented. This will configure
0000B8r 1                 ; VIA1 Timer 1 for a ~10ms periodic IRQ and the IRQ handler will increment
0000B8r 1                 ; the 3-byte TOCKS counter. The VIA is on the external I/O card (not onboard
0000B8r 1                 ; in rev 1.6), so this stays a stub for now.
0000B8r 1  EA             nop
0000B9r 1  60             rts
0000BAr 1               
0000BAr 1               ; ### VIA Routines ###
0000BAr 1               
0000BAr 1               ; via_init:
0000BAr 1               ; Detect VIA1 (on the external I/O card, $7F20) and, if present, set up
0000BAr 1               ; Timer 1 as a free-running ~10ms periodic interrupt that drives the TOCKS
0000BAr 1               ; jiffy clock (incremented in the IRQ handler).
0000BAr 1               ;
0000BAr 1               ; Detection: DDRB is a plain read/write register with no external side effect
0000BAr 1               ; on the value stored, so we write two patterns ($55, $AA) and read them back.
0000BAr 1               ; An absent card reads back open-bus / mirror values and will fail one of the
0000BAr 1               ; two checks. (Writing DDRB only sets pin directions, harmless for detection.)
0000BAr 1               ;
0000BAr 1               ; Sets VIA_PRESENT (and returns carry set) if the VIA responded; clears both
0000BAr 1               ; otherwise. Leaves IRQs enabled on the VIA only when present.
0000BAr 1               ; Overwrites A, X.
0000BAr 1               via_init:
0000BAr 1  64 EB          stz VIA_PRESENT       ; assume absent until proven
0000BCr 1                 ; --- presence check on DDRB ---
0000BCr 1  A9 55          lda #$55
0000BEr 1  8D 22 7F       sta VIA1_DDRB
0000C1r 1  CD 22 7F       cmp VIA1_DDRB
0000C4r 1  D0 37          bne @absent
0000C6r 1  A9 AA          lda #$AA
0000C8r 1  8D 22 7F       sta VIA1_DDRB
0000CBr 1  CD 22 7F       cmp VIA1_DDRB
0000CEr 1  D0 2D          bne @absent
0000D0r 1                 ; --- VIA present: configure Timer 1 free-run tick ---
0000D0r 1  A9 00          lda #$00
0000D2r 1  8D 22 7F       sta VIA1_DDRB         ; leave Port B as inputs (benign default)
0000D5r 1  8D 23 7F       sta VIA1_DDRA         ; leave Port A as inputs too
0000D8r 1                 ; clear the 3-byte TOCKS jiffy counter
0000D8r 1  64 E0          stz TOCKS_L
0000DAr 1  64 E1          stz TOCKS_M
0000DCr 1  64 E2          stz TOCKS_H
0000DEr 1                 ; disable all VIA interrupt sources first
0000DEr 1  A9 7F          lda #VIA_IER_CLR_ALL
0000E0r 1  8D 2E 7F       sta VIA1_IER
0000E3r 1                 ; ACR: Timer 1 continuous (free-run), PB7 output off
0000E3r 1  A9 40          lda #VIA_ACR_T1_FREERUN
0000E5r 1  8D 2B 7F       sta VIA1_ACR
0000E8r 1                 ; load Timer 1 latch/counter for the ~10ms period
0000E8r 1  A9 FE          lda #<VIA_T1_10MS
0000EAr 1  8D 24 7F       sta VIA1_T1CL         ; writing T1C-L loads the low latch
0000EDr 1  A9 47          lda #>VIA_T1_10MS
0000EFr 1  8D 25 7F       sta VIA1_T1CH         ; writing T1C-H loads high latch + starts T1
0000F2r 1                 ; enable the Timer 1 interrupt
0000F2r 1  A9 C0          lda #VIA_IER_T1_ENABLE
0000F4r 1  8D 2E 7F       sta VIA1_IER
0000F7r 1                 ; mark present
0000F7r 1  A9 01          lda #$01
0000F9r 1  85 EB          sta VIA_PRESENT
0000FBr 1  38             sec                   ; carry set = present
0000FCr 1  60             rts
0000FDr 1               @absent:
0000FDr 1  9C 22 7F       stz VIA1_DDRB         ; restore a benign DDRB (inputs)
000100r 1  64 EB          stz VIA_PRESENT
000102r 1  18             clc                   ; carry clear = absent
000103r 1  60             rts
000104r 1               
000104r 1               ; via_report:
000104r 1               ; If VIA1 was detected, print a line under the BIOS banner:
000104r 1               ;   ## VIA1 on $7F20
000104r 1               ; Does nothing if the VIA is absent. Overwrites A, Y.
000104r 1               via_report:
000104r 1  A5 EB          lda VIA_PRESENT
000106r 1  F0 0B          beq @done
000108r 1  A9 rr          lda #<viaMessage
00010Ar 1  85 E7          sta PTR_TX
00010Cr 1  A9 rr          lda #>viaMessage
00010Er 1  85 E8          sta PTR_TX_H
000110r 1  20 rr rr       jsr serial_out_str
000113r 1               @done:
000113r 1  60             rts
000114r 1               
000114r 1               
000114r 1               ; ### Serial Routines ###
000114r 1               ; Initializes the on board serial interface
000114r 1               ; Reset and set config for the ACIA. Init the RX buffer pointer
000114r 1               init_serial:
000114r 1  A9 03          lda #ACIA_RESET
000116r 1  8D 72 7F       sta ACIA_CONTROL
000119r 1  A9 16          lda #ACIA_CFG_28    ; 28800 8,N,1, see defines file for options
00011Br 1  8D 72 7F       sta ACIA_CONTROL
00011Er 1                 ; Init the RX buffer pointers
00011Er 1  A9 00          lda #0
000120r 1  85 E5          sta PTR_RD_RX_BUF
000122r 1  85 E6          sta PTR_WR_RX_BUF
000124r 1  60             rts
000125r 1               
000125r 1               
000125r 1               ; serial_out:
000125r 1               ; Transmit the char in the A Register via the on board
000125r 1               ; serial ACIA TTL-RS232
000125r 1               ; This routine uses pooling mode and will wait until the ACIA
000125r 1               ; TX Data Register (TXDR) bit 1 is Empty to send the character.
000125r 1               serial_out:
000125r 1  48             pha
000126r 1                 pool_acia: ; pulling mode until ready to TX
000126r 1  AD 72 7F         lda ACIA_STATUS
000129r 1  29 02            and #ACIA_TDRE     ; looking at Bit 1 TX Data Register Empty > High = Empty
00012Br 1  F0 F9            beq pool_acia     ; pooling loop if empty
00012Dr 1  68             pla
00012Er 1  8D 73 7F       sta ACIA_DATA       ; output char in A to TDRE
000131r 1  60             rts
000132r 1               
000132r 1               ; serial_poll:
000132r 1               ; Non-blocking, NON-echoing read of the ACIA. Checks whether a byte is
000132r 1               ; waiting and returns immediately either way.
000132r 1               ; - Byte waiting: byte in A, Carry set
000132r 1               ; - Nothing waiting: Carry clear (A is undefined)
000132r 1               ; - X, Y preserved
000132r 1               ; Intended for programs that poll the keyboard (BASIC GET / Ctrl-C check,
000132r 1               ; games, editors) and do their own echoing.
000132r 1               serial_poll:
000132r 1  AD 72 7F       lda ACIA_STATUS
000135r 1  29 01          and #ACIA_RDRF    ; look at Bit 0 RX Data Register Full > High = Full
000137r 1  F0 05          beq @no_data      ; nothing in the RX Buffer
000139r 1  AD 73 7F       lda ACIA_DATA     ; load the byte to A
00013Cr 1  38             sec               ; we have data set Carry
00013Dr 1  60             rts
00013Er 1               @no_data:
00013Er 1  18             clc               ; no data RX clear carry
00013Fr 1  60             rts
000140r 1               
000140r 1               ; serial_in:
000140r 1               ; Takes the byte recived by that ACIA and returns it in A (acumulator)
000140r 1               ; if a byte was received sets the Carry Flag, if not it clears it
000140r 1               ; Same as serial_poll, but echoes the received byte back to the terminal.
000140r 1               ;
000140r 1               serial_in:
000140r 1  20 rr rr       jsr serial_poll   ; non-blocking read, no echo
000143r 1  90 04          bcc @no_data      ; nothing received, carry already clear
000145r 1  20 rr rr       jsr serial_out    ; echo back (returns the byte in A)
000148r 1  38             sec               ; we have data set Carry
000149r 1               @no_data:
000149r 1  60             rts
00014Ar 1               
00014Ar 1               ; serial_in_raw:
00014Ar 1               ; Blocking read of one byte from the ACIA into A. No echo, no buffering.
00014Ar 1               ; Spins until a byte is available in the RX Data Register.
00014Ar 1               ; Used by the Intel HEX loader where we parse before echoing.
00014Ar 1               ; - A holds the received byte on return
00014Ar 1               ; - X, Y preserved
00014Ar 1               serial_in_raw:
00014Ar 1  AD 72 7F       lda ACIA_STATUS
00014Dr 1  29 01          and #ACIA_RDRF    ; Bit 0 RX Data Register Full > High = Full
00014Fr 1  F0 F9          beq serial_in_raw ; wait for a byte
000151r 1  AD 73 7F       lda ACIA_DATA     ; load the byte to A
000154r 1  60             rts
000155r 1               
000155r 1               ; serial_out_str:
000155r 1               ; Sends the a null terminated string via serial
000155r 1               ; uses the ZP variable PTR_TX (PTR_TX_L + PTR_TX_H) as the pointer
000155r 1               ; to the string memory location
000155r 1               ; - Y register is not preserved
000155r 1               serial_out_str:
000155r 1  A0 00          ldy #0
000157r 1                 @loop:
000157r 1  B1 E7            lda (PTR_TX),y
000159r 1  F0 06            beq @null_found
00015Br 1  20 rr rr         jsr serial_out
00015Er 1  C8               iny
00015Fr 1  80 F6            bra @loop
000161r 1                 @null_found:
000161r 1  60             rts
000162r 1               
000162r 1               ; # Helper Routines for Serial comms
000162r 1               
000162r 1               ; serial_out_hex:
000162r 1               ; Transmit the value of the A Register as ASCII HEX byte
000162r 1               ; Need to check this routine, can be optimized
000162r 1               serial_out_hex:
000162r 1  48             pha             ; keep the register for further manipulation
000163r 1  4A             lsr             ; process the high nibble (MSD) shifting it to the low nibble
000164r 1  4A             lsr
000165r 1  4A             lsr
000166r 1  4A             lsr
000167r 1  29 0F          and #$0F        ; Mask LSD for hex print.
000169r 1  09 30          ora #$30        ; this is like adding $30 > ASCII numbers start at $30 the OR %00110000 sets the high bits shifting the hex value to the right place.
00016Br 1  C9 3A          cmp #$3A        ; is less than '9' $39
00016Dr 1  90 02          bcc @done       ; A is < 9 ($3A) so we already have the ASCII of the number
00016Fr 1  69 06          adc #$06        ; A is > 9 ($3A) so add 6 + carry (carry is set by CMP) to offset for letters (A $41 - F $46)
000171r 1               @done:
000171r 1  20 rr rr       jsr serial_out  ; send the MSD since its ready
000174r 1  68             pla             ; get the original value back
000175r 1  29 0F          and #$0F        ; process the low nibble (LSD)
000177r 1  09 30          ora #$30
000179r 1  C9 3A          cmp #$3A
00017Br 1  90 02          bcc @done2
00017Dr 1  69 06          adc #$06
00017Fr 1               @done2:
00017Fr 1  20 rr rr       jsr serial_out
000182r 1  60             rts
000183r 1               
000183r 1               ; out_crlf
000183r 1               ; Transmit a CR+LF > $0D,$0A
000183r 1               ; Preserves all registers
000183r 1               out_crlf:
000183r 1  48             pha
000184r 1  A9 0D          lda #CR
000186r 1  20 rr rr       jsr serial_out
000189r 1  A9 0A          lda #LF
00018Br 1  20 rr rr       jsr serial_out
00018Er 1  68             pla
00018Fr 1  60             rts
000190r 1               
000190r 1               ; ### Monitor Helper Routines ###
000190r 1               
000190r 1               ; ### Command Dispatch ###
000190r 1               ; This enables adding commands to WozMon preventing the core code to grow in size
000190r 1               ;
000190r 1               ; cmd_dispatch:
000190r 1               ; Called from WozMon's command parser with the current input char in A.
000190r 1               ; Decodes the single-letter commands R (run), L (load Intel HEX),
000190r 1               ; S (save Intel HEX) and X (exit to BASIC, like the PET monitor). If the char
000190r 1               ; is none of these, returns with A and X unchanged so WozMon can continue its
000190r 1               ; normal hex parse.
000190r 1               ; For R/L/S the command is executed and control returns to WozMon
000190r 1               ; (WARMWOZ) rather than back to the caller. X does not return.
000190r 1               ; - On no match: A and X preserved, RTS
000190r 1               cmd_dispatch:
000190r 1  C9 52          cmp #'R'          ; run program at XAM address?
000192r 1  F0 0D          beq @run
000194r 1  C9 4C          cmp #'L'          ; load Intel HEX?
000196r 1  F0 12          beq @load
000198r 1  C9 53          cmp #'S'          ; save Intel HEX?
00019Ar 1  F0 14          beq @save
00019Cr 1  C9 58          cmp #'X'          ; exit to BASIC?
00019Er 1  F0 16          beq @basic
0001A0r 1  60             rts               ; not a command, back to WozMon hex parse (A,X intact)
0001A1r 1               @run:
0001A1r 1  20 rr rr       jsr @run_sub      ; JSR so an RTS from the user program returns here
0001A4r 1  4C rr rr       jmp WARMWOZ       ; then warm-start the monitor
0001A7r 1               @run_sub:
0001A7r 1  6C 24 00       jmp (XAML)        ; run at the last XAM address
0001AAr 1               @load:
0001AAr 1  20 rr rr       jsr load_ihex
0001ADr 1  4C rr rr       jmp WARMWOZ
0001B0r 1               @save:
0001B0r 1  20 rr rr       jsr save_ihex
0001B3r 1  4C rr rr       jmp WARMWOZ
0001B6r 1               @basic:
0001B6r 1                 ; BASIC resets the stack itself, so the return address of the JSR to cmd_dispatch can stay.
0001B6r 1  A5 EC          lda BASIC_STARTED ; has BASIC been started since reset?
0001B8r 1  F0 03          beq @basic_cold   ; no, its variables are not set up, a warm start would crash
0001BAr 1  4C rr rr       jmp J_BASIC_WARM  ; yes, back to the READY prompt, program and variables kept
0001BDr 1               @basic_cold:
0001BDr 1  4C rr rr       jmp J_BASIC_COLD  ; first time, start BASIC
0001C0r 1               
0001C0r 1               ; ### Intel HEX Load/Save ###
0001C0r 1               
0001C0r 1               ; load_ihex:
0001C0r 1               ; Receive an Intel HEX stream from the serial port and store it in memory.
0001C0r 1               ; Each data record (type 00) is written at the 16-bit address carried in the
0001C0r 1               ; record itself, so no manual deposit address is needed. A record checksum is
0001C0r 1               ; verified; on mismatch the load aborts with an error message. An EOF record
0001C0r 1               ; (type 01) ends the load with "OK".
0001C0r 1               ; Record: ':' LL AAAA TT <data...> CC   (all hex ASCII)
0001C0r 1               ; Uses IHEX_* zero page scratch. Overwrites A, X, Y.
0001C0r 1               load_ihex:
0001C0r 1                 ; prompt
0001C0r 1  A9 rr          lda #<loadMsg
0001C2r 1  85 E7          sta PTR_TX
0001C4r 1  A9 rr          lda #>loadMsg
0001C6r 1  85 E8          sta PTR_TX_H
0001C8r 1  20 rr rr       jsr serial_out_str
0001CBr 1               @next_record:
0001CBr 1  20 rr rr       jsr serial_in_raw     ; wait for start-of-record
0001CEr 1  C9 3A          cmp #':'
0001D0r 1  D0 F9          bne @next_record      ; ignore anything until a ':' (CR/LF between records)
0001D2r 1  64 34          stz IHEX_SUM          ; reset running checksum (65C02 stz)
0001D4r 1  20 rr rr       jsr get_hex_byte      ; LL  byte count
0001D7r 1  85 32          sta IHEX_LEN
0001D9r 1  20 rr rr       jsr get_hex_byte      ; AAAA high byte of address
0001DCr 1  85 31          sta IHEX_ADDR_H
0001DEr 1  20 rr rr       jsr get_hex_byte      ; AAAA low byte of address
0001E1r 1  85 30          sta IHEX_ADDR_L
0001E3r 1  20 rr rr       jsr get_hex_byte      ; TT  record type
0001E6r 1  85 33          sta IHEX_TYPE
0001E8r 1                 ; data bytes. Only type 00 records are written to memory; any other record
0001E8r 1                 ; type (e.g. 04 extended linear address) is still read so its checksum is
0001E8r 1                 ; validated, but the bytes are discarded.
0001E8r 1  A0 00          ldy #0
0001EAr 1               @data_loop:
0001EAr 1  C4 32          cpy IHEX_LEN
0001ECr 1  F0 0C          beq @read_checksum
0001EEr 1  20 rr rr       jsr get_hex_byte      ; one data byte (also folds into IHEX_SUM)
0001F1r 1  A6 33          ldx IHEX_TYPE         ; store only for data records (type 00)
0001F3r 1  D0 02          bne @skip_store
0001F5r 1  91 30          sta (IHEX_ADDR),y     ; store at record address + index
0001F7r 1               @skip_store:
0001F7r 1  C8             iny
0001F8r 1  80 F0          bra @data_loop
0001FAr 1               @read_checksum:
0001FAr 1  20 rr rr       jsr get_hex_byte      ; CC  record checksum byte
0001FDr 1                 ; At this point IHEX_SUM = (sum of all record bytes incl checksum) & $FF.
0001FDr 1                 ; A valid record makes that total zero.
0001FDr 1  A5 34          lda IHEX_SUM
0001FFr 1  D0 14          bne @bad_checksum
000201r 1                 ; record good - was it the EOF record?
000201r 1  A5 33          lda IHEX_TYPE
000203r 1  C9 01          cmp #$01
000205r 1  F0 02          beq @done
000207r 1  80 C2          bra @next_record
000209r 1               @done:
000209r 1  A9 rr          lda #<okMsg
00020Br 1  85 E7          sta PTR_TX
00020Dr 1  A9 rr          lda #>okMsg
00020Fr 1  85 E8          sta PTR_TX_H
000211r 1  20 rr rr       jsr serial_out_str
000214r 1  60             rts
000215r 1               @bad_checksum:
000215r 1  A9 rr          lda #<errMsg
000217r 1  85 E7          sta PTR_TX
000219r 1  A9 rr          lda #>errMsg
00021Br 1  85 E8          sta PTR_TX_H
00021Dr 1  20 rr rr       jsr serial_out_str
000220r 1  60             rts
000221r 1               
000221r 1               ; save_ihex:
000221r 1               ; Emit memory as an Intel HEX stream over the serial port.
000221r 1               ; Range comes from WozMon's parsed block syntax: type "START.END" then "S".
000221r 1               ;   XAML/XAMH = start address, L/H = end address (inclusive).
000221r 1               ; Writes 16-byte type 00 data records followed by a type 01 EOF record.
000221r 1               ; Uses IHEX_* zero page scratch. Overwrites A, X, Y.
000221r 1               save_ihex:
000221r 1                 ; WozMon's block-XAM ("START.END") leaves the start address in STL/STH and
000221r 1                 ; the end address in L/H, but it advances XAML/XAMH to the end while dumping.
000221r 1                 ; Re-seed our working pointer (XAML/XAMH) from STL/STH so we start at START.
000221r 1  A5 26          lda STL
000223r 1  85 24          sta XAML
000225r 1  A5 27          lda STH
000227r 1  85 25          sta XAMH
000229r 1  20 rr rr       jsr out_crlf
00022Cr 1               @line:
00022Cr 1                 ; bytes remaining = end - start ; stop once start > end
00022Cr 1  A5 25          lda XAMH
00022Er 1  C5 29          cmp H
000230r 1  90 0C          bcc @emit_line        ; start high < end high -> more to do
000232r 1  D0 4E          bne @eof              ; start high > end high -> done
000234r 1  A5 24          lda XAML
000236r 1  C5 28          cmp L
000238r 1  F0 04          beq @emit_line        ; equal: still one byte to emit this pass
00023Ar 1  90 02          bcc @emit_line        ; start low < end low -> more to do
00023Cr 1  80 44          bra @eof              ; start > end -> done
00023Er 1               @emit_line:
00023Er 1                 ; decide this record's length: min(16, end-start+1)
00023Er 1                 ; compute remaining low estimate; simplest robust approach: emit up to 16
00023Er 1                 ; bytes but stop at end address inside the loop.
00023Er 1  64 34          stz IHEX_SUM
000240r 1  A9 3A          lda #':'
000242r 1  20 rr rr       jsr serial_out
000245r 1                 ; byte count placeholder handling: we count as we go, so first figure length
000245r 1  20 rr rr       jsr @calc_len         ; -> IHEX_LEN (1..16)
000248r 1  A5 32          lda IHEX_LEN
00024Ar 1  20 rr rr       jsr put_hex_byte      ; LL
00024Dr 1  A5 25          lda XAMH
00024Fr 1  20 rr rr       jsr put_hex_byte      ; AAAA hi
000252r 1  A5 24          lda XAML
000254r 1  20 rr rr       jsr put_hex_byte      ; AAAA lo
000257r 1  A9 00          lda #$00
000259r 1  20 rr rr       jsr put_hex_byte      ; TT = 00 data
00025Cr 1  A0 00          ldy #0
00025Er 1               @save_data:
00025Er 1  C4 32          cpy IHEX_LEN
000260r 1  F0 08          beq @save_cksum
000262r 1  B1 24          lda (XAML),y
000264r 1  20 rr rr       jsr put_hex_byte
000267r 1  C8             iny
000268r 1  80 F4          bra @save_data
00026Ar 1               @save_cksum:
00026Ar 1                 ; checksum = two's complement of sum so far
00026Ar 1  A5 34          lda IHEX_SUM
00026Cr 1  49 FF          eor #$FF
00026Er 1  1A             inc
00026Fr 1  20 rr rr       jsr put_hex_byte
000272r 1  20 rr rr       jsr out_crlf
000275r 1                 ; advance start by IHEX_LEN
000275r 1  A5 24          lda XAML
000277r 1  18             clc
000278r 1  65 32          adc IHEX_LEN
00027Ar 1  85 24          sta XAML
00027Cr 1  90 AE          bcc @line
00027Er 1  E6 25          inc XAMH
000280r 1  80 AA          bra @line
000282r 1               @eof:
000282r 1                 ; EOF record :00000001FF
000282r 1  A9 rr          lda #<eofRec
000284r 1  85 E7          sta PTR_TX
000286r 1  A9 rr          lda #>eofRec
000288r 1  85 E8          sta PTR_TX_H
00028Ar 1  20 rr rr       jsr serial_out_str
00028Dr 1  60             rts
00028Er 1               ; @calc_len: how many bytes to emit this record (1..16), bounded by end addr
00028Er 1               @calc_len:
00028Er 1                 ; remaining = end - start (16-bit). If remaining+1 >= 16 use 16 else remaining+1
00028Er 1                 ; compute end - start
00028Er 1  A5 28          lda L
000290r 1  38             sec
000291r 1  E5 24          sbc XAML
000293r 1  85 35          sta IHEX_TMP          ; low of (end-start)
000295r 1  A5 29          lda H
000297r 1  E5 25          sbc XAMH              ; high of (end-start)
000299r 1  D0 06          bne @full             ; high byte nonzero -> at least 256 left, use 16
00029Br 1  A5 35          lda IHEX_TMP
00029Dr 1  C9 0F          cmp #15               ; remaining low >= 15 ? (remaining+1 >= 16)
00029Fr 1  90 05          bcc @partial
0002A1r 1               @full:
0002A1r 1  A9 10          lda #16
0002A3r 1  85 32          sta IHEX_LEN
0002A5r 1  60             rts
0002A6r 1               @partial:
0002A6r 1  A5 35          lda IHEX_TMP          ; remaining (end-start), bytes left-1
0002A8r 1  1A             inc                   ; +1 to make it inclusive count
0002A9r 1  85 32          sta IHEX_LEN
0002ABr 1  60             rts
0002ACr 1               
0002ACr 1               ; ### Hex & ASCII Helpers ###
0002ACr 1               
0002ACr 1               ; get_hex_byte:
0002ACr 1               ; Read two ASCII hex characters from serial (raw, no echo) and return the
0002ACr 1               ; assembled byte in A. The byte is also added into IHEX_SUM for checksum
0002ACr 1               ; verification. Overwrites A; preserves X, Y.
0002ACr 1               get_hex_byte:
0002ACr 1  DA             phx
0002ADr 1  20 rr rr       jsr serial_in_raw     ; high nibble char
0002B0r 1  20 rr rr       jsr ascii_to_nib
0002B3r 1  0A             asl
0002B4r 1  0A             asl
0002B5r 1  0A             asl
0002B6r 1  0A             asl
0002B7r 1  85 35          sta IHEX_TMP          ; high nibble in place
0002B9r 1  20 rr rr       jsr serial_in_raw     ; low nibble char
0002BCr 1  20 rr rr       jsr ascii_to_nib
0002BFr 1  05 35          ora IHEX_TMP          ; combine nibbles
0002C1r 1  AA             tax                   ; keep byte in X
0002C2r 1  18             clc
0002C3r 1  65 34          adc IHEX_SUM          ; fold into running checksum
0002C5r 1  85 34          sta IHEX_SUM
0002C7r 1  8A             txa                   ; return byte in A
0002C8r 1  FA             plx
0002C9r 1  60             rts
0002CAr 1               
0002CAr 1               ; ascii_to_nib:
0002CAr 1               ; Convert ASCII hex char in A ('0'-'9','A'-'F','a'-'f') to nibble value 0-15.
0002CAr 1               ; No validation - assumes well-formed input. Overwrites A.
0002CAr 1               ascii_to_nib:
0002CAr 1  C9 3A          cmp #'9'+1
0002CCr 1  90 04          bcc @digit            ; '0'-'9'
0002CEr 1  29 DF          and #$DF              ; fold lower to upper case
0002D0r 1  E9 07          sbc #$07              ; 'A'(after carry) maps to 10 ; carry set from cmp path
0002D2r 1               @digit:
0002D2r 1  29 0F          and #$0F
0002D4r 1  60             rts
0002D5r 1               
0002D5r 1               ; put_hex_byte:
0002D5r 1               ; Transmit the byte in A as two ASCII hex chars and fold it into IHEX_SUM.
0002D5r 1               ; Overwrites A; preserves X, Y.
0002D5r 1               put_hex_byte:
0002D5r 1  48             pha
0002D6r 1  18             clc
0002D7r 1  65 34          adc IHEX_SUM          ; checksum tracks raw byte value
0002D9r 1  85 34          sta IHEX_SUM
0002DBr 1  68             pla
0002DCr 1  20 rr rr       jsr serial_out_hex    ; reuse BIOS hex printer
0002DFr 1  60             rts
0002E0r 1               
0002E0r 1               ; ### LOAD / SAVE for BASIC  ###
0002E0r 1               
0002E0r 1               ; bios_load, bios_save: (stubs)
0002E0r 1               ; The BASIC LOAD and SAVE statements call these through the jump table
0002E0r 1               ; (BIOS_LOAD, BIOS_SAVE). They are STUBS for now: they return without doing
0002E0r 1               ; anything. They are meant for the SD card routines. What they take (file name
0002E0r 1               ; and so on) is not defined yet, it will be documented here when they are written.
0002E0r 1               ; They are not the monitor's L and S commands (load_ihex and save_ihex).
0002E0r 1               bios_load:
0002E0r 1  60             rts
0002E1r 1               bios_save:
0002E1r 1  60             rts
0002E2r 1               
0002E2r 1               
0002E2r 1               ; ### ROM Data ###
0002E2r 1               
0002E2r 1               ; Startup Messages
0002E2r 1               startupMessage:
0002E2r 1  0C 0D 0A 23    .byte	$0C,CR,LF,"## Simple6502 ##",CR,LF,"BIOS v"
0002E6r 1  23 20 53 69  
0002EAr 1  6D 70 6C 65  
0002FDr 1  30 2E 39 2E    .byte VERSION
000301r 1  30           
000302r 1                 ;.byte	$0D,$0A,"OK"
000302r 1  0D 0A          .byte CR,LF
000304r 1  00             .byte $00
000305r 1               wozmonMessage:
000305r 1  0D 0A 3E 20    .byte	CR,LF,"> WozMon <"
000309r 1  57 6F 7A 4D  
00030Dr 1  6F 6E 20 3C  
000311r 1  0D 0A 00       .byte CR,LF,$00
000314r 1               viaMessage:
000314r 1  23 23 20 56    .byte "## VIA1 on $7F20"
000318r 1  49 41 31 20  
00031Cr 1  6F 6E 20 24  
000324r 1  0D 0A 00       .byte CR,LF,$00
000327r 1               ; Intel HEX loader/saver messages
000327r 1               loadMsg:
000327r 1  0D 0A 50 61    .byte CR,LF,"Paste Intel HEX..",CR,LF,$00
00032Br 1  73 74 65 20  
00032Fr 1  49 6E 74 65  
00033Dr 1               okMsg:
00033Dr 1  0D 0A 4F 4B    .byte CR,LF,"OK",CR,LF,$00
000341r 1  0D 0A 00     
000344r 1               errMsg:
000344r 1  0D 0A 43 4B    .byte CR,LF,"CKSUM ERR",CR,LF,$00
000348r 1  53 55 4D 20  
00034Cr 1  45 52 52 0D  
000352r 1               eofRec:
000352r 1  3A 30 30 30    .byte ":00000001FF",CR,LF,$00
000356r 1  30 30 30 30  
00035Ar 1  31 46 46 0D  
000360r 1               
000360r 1               ; ### Interrupt Handlers ###
000360r 1               
000360r 1               ; # IRQ Handler
000360r 1               ; Services VIA1 Timer 1 (the ~10ms tick) by incrementing the 3-byte TOCKS
000360r 1               ; jiffy counter. Only A is used, so only A is preserved. Other sources (ACIA
000360r 1               ; RX, etc.) can be added here later; unrecognised IRQs simply return.
000360r 1               irq_handler:
000360r 1  48               pha                   ; preserve A (X,Y untouched below)
000361r 1                   ; Was it VIA1 Timer 1? Check IFR bit 6. (If the VIA is absent this reads
000361r 1                   ; open bus, but then it is not an IRQ source so the board won't assert IRQ.)
000361r 1  AD 2D 7F         lda VIA1_IFR
000364r 1  29 40            and #VIA_IFR_T1
000366r 1  F0 0D            beq @not_t1           ; not Timer 1 -> nothing we handle
000368r 1                   ; Clear the Timer 1 interrupt flag by reading T1C-L.
000368r 1  AD 24 7F         lda VIA1_T1CL
00036Br 1                   ; Increment the 24-bit TOCKS counter (little-endian).
00036Br 1  E6 E0            inc TOCKS_L
00036Dr 1  D0 06            bne @done
00036Fr 1  E6 E1            inc TOCKS_M
000371r 1  D0 02            bne @done
000373r 1  E6 E2            inc TOCKS_H
000375r 1               @done:
000375r 1               @not_t1:
000375r 1  68               pla         ; restore A
000376r 1  40               rti         ; 40
000377r 1               
000377r 1               ; # NMI Handler Vector
000377r 1               nmi_handler:
000377r 1  EA               nop       ; EA
000378r 1  40               rti       ; 40
000379r 1               
000379r 1               ; -- MONITOR --
000379r 1               ; ## WozMon ##
000379r 1               
000379r 1               WOZMON_COLD:    ; Need to move this to a WozMon COLD_Start of sorts
000379r 1               ; Print woz message
000379r 1  A9 rr        lda #<wozmonMessage
00037Br 1  85 E7        sta PTR_TX
00037Dr 1  A9 rr        lda #>wozmonMessage
00037Fr 1  85 E8        sta PTR_TX_H
000381r 1  20 rr rr     jsr serial_out_str
000384r 1  4C rr rr     jmp WOZMON      ; go to the monitor (without this it runs into the empty ROM after the BIOS)
000387r 1               ; .segment "WOZMON"   ; .org $FF00
000387r 1               .include "wozmon_sbc.s"
000387r 2               ;  The WOZ Monitor for the Apple 1
000387r 2               ;  Written by Steve Wozniak in 1976
000387r 2               ;  Adapted to the simple6502 SBC with MC60B50 ACIA by Mariano Luna
000387r 2               ;
000387r 2               ; Changelog:
000387r 2               ; - 5 bytes less
000387r 2               ; - updated to use BIOS ruitines for Serial int and some I/O
000387r 2               ; - moved Variables to defines_[platfrom].s
000387r 2               ; - updates to use standard ASCII (not Apple 1 bit 7 set)
000387r 2               ; - input now case insensitive
000387r 2               ; -
000387r 2               
000387r 2               ; TEST PROGRAM
000387r 2               ; 0400: A9 20 20 77 80 18 69 01 C9 7F 30 F6 4C 00 04
000387r 2               ;
000387r 2               ;                            * = $0400
000387r 2               ; 0400   A9 20      L0400     LDA #$20
000387r 2               ; 0402   20 77 80   L0402     JSR $8077
000387r 2               ; 0405   18                   CLC
000387r 2               ; 0406   69 01                ADC #$01
000387r 2               ; 0408   C9 7F                CMP #$7F
000387r 2               ; 040A   30 F6                BMI L0402
000387r 2               ; 040C   4C 00 04             JMP L0400
000387r 2               ;                             .END
000387r 2               ; Page 0 Variables (XAML..MODE) are declared in zeropage.s so that
000387r 2               ; the BIOS Intel HEX routines can share them as zero page.
000387r 2               
000387r 2               ; Other Variables
000387r 2               
000387r 2               IN              = $0200         ;  Input buffer is 128 bytes, $0200–$027F,
000387r 2               
000387r 2               .segment "WOZMON"
000000r 2               WOZMON:
000000r 2                               ; Run out of mem so assuming serial is inizialized by BIOS
000000r 2                               ; with only one of this JSRs 'WOZMON' overflows the
000000r 2                               ; 'MONITOR' segment memory area by 1 byte
000000r 2                               ; if you are running this independently of the bios you
000000r 2                               ; will need to uncomment the next line or 2 lines if you fancy a CR + LF
000000r 2                               ; JSR     init_serial    ; Initialize ACIA
000000r 2                               ; JSR     out_crlf       ; send CR+LF
000000r 2  A9 1B        WARMWOZ:        LDA     #$1B           ; Begin with escape.
000002r 2               NOTCR:
000002r 2  C9 08                        CMP     #$08           ; Backspace key? * Changed to the actual BS key
000004r 2  F0 11                        BEQ     BACKSPACE      ; Yes.
000006r 2  C9 1B                        CMP     #$1B           ; ESC?
000008r 2  F0 03                        BEQ     ESCAPE         ; Yes.
00000Ar 2  C8                           INY                    ; Advance text index.
00000Br 2  10 0D                        BPL     NEXTCHAR       ; Auto ESC if line longer than 127.
00000Dr 2               ESCAPE:
00000Dr 2  A9 5C                        LDA     #$5C           ; "\".
00000Fr 2  20 rr rr                     JSR     ECHO           ; Output it.
000012r 2               GETLINE:
000012r 2  20 rr rr                     JSR     out_crlf       ; * Send CR+LF
000015r 2  A0 01                        LDY     #$01           ; Initialize text index.
000017r 2  88           BACKSPACE:      DEY                    ; Back up text index.
000018r 2  30 F8                        BMI     GETLINE        ; Beyond start of line, reinitialize.
00001Ar 2               NEXTCHAR:
00001Ar 2  AD 72 7F                     LDA     ACIA_STATUS    ; Check AICIA status.
00001Dr 2  29 01                        AND     #ACIA_RDRF     ; Key ready?
00001Fr 2  F0 F9                        BEQ     NEXTCHAR       ; Loop until ready.
000021r 2  AD 73 7F                     LDA     ACIA_DATA      ; Load character. B7 will be '0'.
000024r 2  C9 60                        CMP     #$60           ;* Lower case?
000026r 2  30 02                        BMI     GO_ON          ;* Nope, go on
000028r 2  29 5F                        AND     #$5F           ;* convert to Upper case ASCII
00002Ar 2  99 00 02     GO_ON:          STA     IN,Y           ; Add to text buffer.
00002Dr 2  20 rr rr                     JSR     ECHO           ; Display character.
000030r 2  C9 0D                        CMP     #$0D           ; CR?
000032r 2  D0 CE                        BNE     NOTCR          ; No.
000034r 2  A0 FF                        LDY     #$FF           ; Reset text index.
000036r 2  A9 00                        LDA     #$00           ; For XAM mode.
000038r 2  AA                           TAX                    ; 0->X.
000039r 2               SETBLOCK:
000039r 2  0A                           ASL
00003Ar 2               SETSTOR:
00003Ar 2  0A                           ASL                    ; Leaves $7B if setting STOR mode.
00003Br 2  85 2B                        STA     MODE           ; $00 = XAM, $74 = STOR, $B8 = BLOCK XAM.
00003Dr 2               BLSKIP:
00003Dr 2  C8                           INY                    ; Advance text index.
00003Er 2               NEXTITEM:
00003Er 2  B9 00 02                     LDA     IN,Y           ; Get character.
000041r 2  C9 0D                        CMP     #$0D           ; CR?
000043r 2  F0 CD                        BEQ     GETLINE        ; Yes, done this line.
000045r 2  C9 2E                        CMP     #$2E           ; "."?
000047r 2  90 F4                        BCC     BLSKIP         ; Skip delimiter.
000049r 2  F0 EE                        BEQ     SETBLOCK       ; Set BLOCK XAM mode.
00004Br 2  C9 3A                        CMP     #$3A           ; ":"?
00004Dr 2  F0 EB                        BEQ     SETSTOR        ; Yes, set STOR mode.
00004Fr 2  20 rr rr                     JSR     cmd_dispatch   ;* Handle R/L/S letter commands in BIOS.
000052r 2                                                      ;* Returns (A,X preserved) if not a command.
000052r 2  86 28                        STX     L              ; $00 -> L. * Woz is relying on X being zero
000054r 2  86 29                        STX     H              ;    and H.
000056r 2  84 2A                        STY     YSAV           ; Save Y for comparison
000058r 2               NEXTHEX:
000058r 2  B9 00 02                     LDA     IN,Y           ; Get character for hex test.
00005Br 2  49 30                        EOR     #$30           ; Map digits to $0-9.
00005Dr 2  C9 0A                        CMP     #$0A           ; Digit?
00005Fr 2  90 06                        BCC     DIG            ; Yes.
000061r 2  69 88                        ADC     #$88           ; Map letter "A"-"F" to $FA-FF.
000063r 2  C9 FA                        CMP     #$FA           ; Hex letter?
000065r 2  90 11                        BCC     NOTHEX         ; No, character not hex.
000067r 2               DIG:
000067r 2  0A                           ASL
000068r 2  0A                           ASL                    ; Hex digit to MSD of A.
000069r 2  0A                           ASL
00006Ar 2  0A                           ASL
00006Br 2  A2 04                        LDX     #$04           ; Shift count.
00006Dr 2               HEXSHIFT:
00006Dr 2  0A                           ASL                    ; Hex digit left, MSB to carry.
00006Er 2  26 28                        ROL     L              ; Rotate into LSD.
000070r 2  26 29                        ROL     H              ; Rotate into MSD's.
000072r 2  CA                           DEX                    ; Done 4 shifts?
000073r 2  D0 F8                        BNE     HEXSHIFT       ; No, loop.
000075r 2  C8                           INY                    ; Advance text index.
000076r 2  D0 E0                        BNE     NEXTHEX        ; Always taken. Check next character for hex.
000078r 2               NOTHEX:
000078r 2  C4 2A                        CPY     YSAV           ; Check if L, H empty (no hex digits).
00007Ar 2  F0 91                        BEQ     ESCAPE         ; Yes, generate ESC sequence.
00007Cr 2  24 2B                        BIT     MODE           ; Test MODE byte.
00007Er 2  50 0D                        BVC     NOTSTOR        ; B6=0 is STOR, 1 is XAM and BLOCK XAM.
000080r 2  A5 28                        LDA     L              ; LSD's of hex data.
000082r 2  81 26                        STA     (STL,X)        ; Store current 'store index'.
000084r 2  E6 26                        INC     STL            ; Increment store index.
000086r 2  D0 B6                        BNE     NEXTITEM       ; Get next item (no carry).
000088r 2  E6 27                        INC     STH            ; Add carry to 'store index' high order.
00008Ar 2  4C rr rr     TONEXTITEM:     JMP     NEXTITEM       ; Get next command item.
00008Dr 2               ; R (run), L (Intel HEX load) and S (Intel HEX save) commands are now
00008Dr 2               ; handled by cmd_dispatch in the BIOS segment. This frees WozMon space and
00008Dr 2               ; lets those routines be reused from other code. See BIOS.s.
00008Dr 2               NOTSTOR:
00008Dr 2  30 29                        BMI     XAMNEXT        ; B7 = 0 for XAM, 1 for BLOCK XAM.
00008Fr 2  A2 02                        LDX     #$02           ; Byte count.
000091r 2  B5 27        SETADR:         LDA     L-1,X          ; Copy hex data to
000093r 2  95 25                        STA     STL-1,X        ;  'store index'.
000095r 2  95 23                        STA     XAML-1,X       ; And to 'XAM index'.
000097r 2  CA                           DEX                    ; Next of 2 bytes.
000098r 2  D0 F7                        BNE     SETADR         ; Loop unless X = 0.
00009Ar 2               NXTPRNT:
00009Ar 2  D0 12                        BNE     PRDATA         ; NE means no address to print.
00009Cr 2  20 rr rr                     JSR     out_crlf       ; Send CR+LF
00009Fr 2  A5 25                        LDA     XAMH           ; 'Examine index' high-order byte.
0000A1r 2  20 rr rr                     JSR     PRBYTE         ; Output it in hex format.
0000A4r 2  A5 24                        LDA     XAML           ; Low-order 'examine index' byte.
0000A6r 2  20 rr rr                     JSR     PRBYTE         ; Output it in hex format.
0000A9r 2  A9 3A                        LDA     #$3A           ; ":".
0000ABr 2  20 rr rr                     JSR     ECHO           ; Output it.
0000AEr 2               PRDATA:
0000AEr 2  A9 20                        LDA     #$20           ; Blank.
0000B0r 2  20 rr rr                     JSR     ECHO           ; Output it.
0000B3r 2  A1 24                        LDA     (XAML,X)       ; Get data byte at 'examine index'.
0000B5r 2  20 rr rr                     JSR     PRBYTE         ; Output it in hex format.
0000B8r 2  86 2B        XAMNEXT:        STX     MODE           ; 0 -> MODE (XAM mode).
0000BAr 2  A5 24                        LDA     XAML
0000BCr 2  C5 28                        CMP     L              ; Compare 'examine index' to hex data.
0000BEr 2  A5 25                        LDA     XAMH
0000C0r 2  E5 29                        SBC     H
0000C2r 2  B0 C6                        BCS     TONEXTITEM     ; Not less, so no more data to output.
0000C4r 2  E6 24                        INC     XAML
0000C6r 2  D0 02                        BNE     MOD8CHK        ; Increment 'examine index'.
0000C8r 2  E6 25                        INC     XAMH
0000CAr 2               MOD8CHK:
0000CAr 2  A5 24                        LDA     XAML           ; Check low-order 'examine index' byte
0000CCr 2  29 0F                        AND     #$0F           ; * Changed to diesplay 16 bytes per line AND #$07 ; For MOD 8 = 0  #%0000.0111
0000CEr 2  10 CA                        BPL     NXTPRNT        ; Always taken.
0000D0r 2               PRBYTE:
0000D0r 2  48                           PHA                    ; Save A for LSD.
0000D1r 2  4A                           LSR
0000D2r 2  4A                           LSR
0000D3r 2  4A                           LSR                    ; MSD to LSD position.
0000D4r 2  4A                           LSR
0000D5r 2  20 rr rr                     JSR     PRHEX          ; Output hex digit.
0000D8r 2  68                           PLA                    ; Restore A.
0000D9r 2               PRHEX:
0000D9r 2  29 0F                        AND     #$0F           ; Mask LSD for hex print.
0000DBr 2  09 30                        ORA     #$30           ; Add "0".
0000DDr 2  C9 3A                        CMP     #$3A           ; Digit?
0000DFr 2  90 02                        BCC     ECHO           ; Yes, output it.
0000E1r 2  69 06                        ADC     #$06           ; Add offset for letter.
0000E3r 2               ECHO:
0000E3r 2  48                           PHA                    ; Save A.
0000E4r 2  8D 73 7F                     STA     ACIA_DATA      ; Output character.
0000E7r 2  A9 FF                        LDA     #$FF           ; Initialize delay loop.
0000E9r 2  3A           TXDELAY:        DEC                    ; Decrement A.
0000EAr 2  D0 FD                        BNE     TXDELAY        ; Until A gets to 0.
0000ECr 2  68                           PLA                    ; Restore A.
0000EDr 2  60                           RTS                    ; Return.
0000EEr 2               
0000EEr 2               
0000EEr 2               
0000EEr 1               
0000EEr 1               ; -- VECTORS --
0000EEr 1               ;.org $fffa
0000EEr 1               .segment "RESETVECTORS"
000000r 1  rr rr          .word nmi_handler ; NMI
000002r 1  rr rr          .word reset       ; RESET
000004r 1  rr rr          .word irq_handler ; IRQ/BRK
000004r 1               
