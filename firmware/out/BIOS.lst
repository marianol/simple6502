000000r 1               ; simple6502 BIOS ROM
000000r 1               ; Written by Mariano Luna, 2024
000000r 1               ; License: BSD-3-Clause
000000r 1               ; https://opensource.org/license/bsd-3-clause
000000r 1               
000000r 1               .setcpu "65C02"           ; Thats what we got
000000r 1               .debuginfo +
000000r 1               
000000r 1               .define VERSION "0.11.0"   ; Define the version number
000000r 1               
000000r 1               .include "defines_simple6502.s" ; Include HW Constants and Labels
000000r 2               ; Hardware for the simple6502 SBC board
000000r 2               ;
000000r 2               ; This file has the common labels, variables and constants that define the
000000r 2               ; hardware of my simple6502 SBC https://github.com/marianol/simple6502/
000000r 2               ; is meant to be included in source files and keep hardware related data
000000r 2               ; separated from the main assembly code.
000000r 2               
000000r 2               ; simple6502 SBC
000000r 2               ; Memory Map Address Space
000000r 2               ; 0x0000 - 0x7EFF : RAM 32K - 256 bytes (31.75K)
000000r 2               ; 0x7F00 - 0x7FFF : I/O 256 bytes decoded to 8 IO lines
000000r 2               ; 0x8000 - 0xFFFF : ROM 32K
000000r 2               ; Clock is @1.8432MHz so 0.542534722us per cycle
000000r 2               
000000r 2               ; I/O Space
000000r 2               IO_1    = $7F00 ; Slot #1 0x7F00 - 0x7F0F
000000r 2               IO_2    = $7F10 ; Slot #2 0x7F10 - 0x7F1F
000000r 2               IO_3    = $7F20 ; VIA #1  0x7F20 - 0x7F2F
000000r 2               IO_4    = $7F30 ; Available 0x7F30 - 0x7F3F
000000r 2               IO_5    = $7F40 ; Available 0x7F40 - 0x7F4F
000000r 2               IO_6    = $7F50 ; Available 0x7F50 - 0x7F5F
000000r 2               IO_7    = $7F60 ; Available 0x7F60 - 0x7F6F
000000r 2               IO_8    = $7F70 ; MC68B50 ACIA  0x7F70 - 0x7F7F
000000r 2               ;  0x7F80 - 0x7FFF : This section is not decoded 127 bytes
000000r 2               
000000r 2               ; -----------
000000r 2               ; ACIA MC68B50
000000r 2               ; The simple6502 has an serial interface on board at IO_8
000000r 2               ; the ACIA is driven by the main clock (CLK) @ 1.8432Mhz
000000r 2               ; RS is tied to A0 and CS0 is tied to A1
000000r 2               ; The 68B50 Control register is as follows:
000000r 2               ; - Bit 0-1: Config clock Divider & Reset > 00: ÷1, 01: ÷16, 10: ÷64, 11: Master reset
000000r 2               ; - Bit 2-4: Config bit length, parity & stop >
000000r 2               ; - Bit 5-6: TX control bits
000000r 2               ;               > 00: RTSB low, TDRE IRQ disabled
000000r 2               ;               > 01: RTSB low, TDRE IRQ enabled
000000r 2               ;               > 10: RTSB high, TDRE IRQ disabled
000000r 2               ;               > 11: RTSB low, transmits brake level, TDRE disabled
000000r 2               ; - Bit 7: RX IRQ 0 Disabled / 1 Enabled
000000r 2               
000000r 2               ACIA_BASE     = IO_8
000000r 2               ACIA_STATUS   = ACIA_BASE + 2   ; Read RS 0 + R
000000r 2               ACIA_CONTROL  = ACIA_BASE + 2   ; Write RS 0 + W
000000r 2               ACIA_DATA     = ACIA_BASE + 3   ; RS 1 + R/W > RX/TX
000000r 2               
000000r 2               ; ACIA Preset Configurations
000000r 2               ; This are intended to simplify config of the CTRL register
000000r 2               ACIA_CFG_115    = %00010101    ; 8-N-1, 115200bps, no IRQ - /16 CLK
000000r 2               ACIA_CFG_115I   = %10010101    ; 8-N-1, 115200bps, IRQ - /16 CLK
000000r 2               ACIA_CFG_28     = %00010110    ; 8-N-1, 28800bps, no IRQ - /64 CLK
000000r 2               ACIA_CFG_28I    = %10010110    ; 8-N-1, 28800bps, IRQ - /64 CLK
000000r 2               
000000r 2               ; ACIA Helper Constants
000000r 2               ACIA_TDRE       = %00000010    ; bitmask for TDRE
000000r 2               ACIA_RDRF       = %00000001    ; bitmask for RDRF
000000r 2               ACIA_RESET      = %00000011    ; 6850 reset
000000r 2               
000000r 2               ; 6522 VIA
000000r 2               ; The VIA is not onboard in Rev 1.6 PCB
000000r 2               ; but reserving this I/O for the main VIA
000000r 2               ;
000000r 2               ; VIA Interrupt Flag Register (IFR) Reference
000000r 2               ; BIT   |  0  |  1  |  2       |  3  |  4  |   5    |   6    |  7  |
000000r 2               ; Desc  | CA2 | CA1 | Shift    | CB2 | CB1 | Timer2 | Timer2 | IRQ |
000000r 2               ;                     Register
000000r 2               VIA1_BASE   = IO_3
000000r 2               VIA_COUNT   = 1                 ; VIAs the BIOS port routines know (the VIA index, 0 = VIA1)
000000r 2               VIA1_PORTB  = VIA1_BASE         ; $7F20
000000r 2               VIA1_PORTA  = VIA1_BASE + 1     ; $7F21
000000r 2               VIA1_DDRB   = VIA1_BASE + 2     ; $7F22
000000r 2               VIA1_DDRA   = VIA1_BASE + 3     ; $7F23
000000r 2               VIA1_T1CL   = VIA1_BASE + 4     ; $7F24 T1C-L Timer 1 Counter (low byte)
000000r 2               VIA1_T1CH   = VIA1_BASE + 5     ; $7F25 T1C-H Timer 1 Counter (high byte)
000000r 2               VIA1_T1L    = VIA1_BASE + 6     ; $7F26 T1L-L
000000r 2               VIA1_T1H    = VIA1_BASE + 7     ; $7F27 T1L-H
000000r 2               VIA1_T2CL   = VIA1_BASE + 8     ; $7F28 T2C-L
000000r 2               VIA1_T2CH   = VIA1_BASE + 9     ; $7F29 T2C-H
000000r 2               VIA1_SR     = VIA1_BASE + 10    ; $7F2A SR Shift Register
000000r 2               VIA1_ACR    = VIA1_BASE + 11    ; $7F2B Auxiliary Control register @
000000r 2               VIA1_PCR    = VIA1_BASE + 12    ; PCR Peripheral Control Register
000000r 2               VIA1_IFR    = VIA1_BASE + 13    ; $7F2D IFR > Interrupt Flag Register
000000r 2               VIA1_IER    = VIA1_BASE + 14    ; $7F2E ; Interrupt Enable Register
000000r 2               
000000r 2               ; VIA helper constants
000000r 2               ; ACR (Auxiliary Control Register): bit7=T1 PB7 output, bit6=T1 continuous.
000000r 2               ; $40 = Timer 1 free-run (continuous interrupts), PB7 disabled, shift reg off.
000000r 2               VIA_ACR_T1_FREERUN = %01000000
000000r 2               ; IER (Interrupt Enable Register): bit7=set/clear flag, bit6=Timer 1.
000000r 2               ; Writing $C0 sets (enables) the Timer 1 interrupt; $7F clears all enables.
000000r 2               VIA_IER_T1_ENABLE  = %11000000
000000r 2               VIA_IER_CLR_ALL    = %01111111
000000r 2               ; IFR (Interrupt Flag Register): bit6 = Timer 1.
000000r 2               VIA_IFR_T1         = %01000000
000000r 2               
000000r 2               ; Timer 1 reload value for a ~10ms periodic tick at 1.8432 MHz.
000000r 2               ; 10ms = 18432 cycles. In free-run the effective period is (N+2) cycles,
000000r 2               ; so load N = 18432 - 2 = 18430 = $47FE.
000000r 2               VIA_T1_10MS        = 18430
000000r 2               
000000r 2               
000000r 2               ; ### Zero Page ###
000000r 2               ; The zero page variables are declared in zeropage.s (the zero page map), not here.
000000r 2               ; Include zeropage.s next to this file in the sources that use them.
000000r 2               
000000r 2               
000000r 2               ; ### Useful Constants ###
000000r 2               ; ASCII
000000r 2               CR      = $0D
000000r 2               LF      = $0A
000000r 2               BS      = $08
000000r 2               DEL     = $7F
000000r 2               SPACE   = $20
000000r 2               ESC     = $1B
000000r 2               NULL    = $00
000000r 2               
000000r 1               .include "zeropage.s"           ; Zero page map (all ZP variables are declared there)
000000r 2               ; simple6502 zero page map
000000r 2               ;
000000r 2               ; This is the one place where zero page variables are declared. ZP variables
000000r 2               ; are declared here, reserving the space with .res.
000000r 2               ; A block that grows over the next one is caught by the .assert
000000r 2               ; at the end of the block, and the whole map can be read in one file.
000000r 2               ; See docs/ZEROPAGE_MAP.md for the full map with the BASIC variables.
000000r 2               ; Zero page that is not declared here is scratch, free for any program to use.
000000r 2               ;
000000r 2               ; Layout rules:
000000r 2               ;  - Each block is anchored with .org at a FIXED address and its variables
000000r 2               ;    follow each other with .res. Do not move a block: programs (and the jump
000000r 2               ;    table, e.g. BIOS_SERIAL_STR reads PTR_TX) rely on these addresses.
000000r 2               ;  - Several labels in front of one .res are aliases of the same bytes
000000r 2               ;    (TOCKS and TOCKS_L, PTR_TX and PTR_TX_L ...).
000000r 2               ;  - WozMon relies on XAML/XAMH, STL/STH and L/H being adjacent, in that order.
000000r 2               ;  - BASIC owns BASIC_ZP_START..BASIC_ZP_END. It declares its variables in
000000r 2               ;    basic/zeropage_basic.s. It shares RAM_SIZE with the BIOS (BASIC's MEMSIZ).
000000r 2               ;
000000r 2               ; This file is included by BIOS.s and by basic/msbasic.s, so both builds check
000000r 2               ; their blocks against the same map.
000000r 2               
000000r 2               ; The zero page range reserved for BASIC. Its variables are declared in
000000r 2               ; basic/zeropage_basic.s, which checks that they stay inside this range.
000000r 2               ; $4A-$DD: the BASIC variables, the copy of the CHRGET code and RNDSEED.
000000r 2               ; $DE-$DF stay free as spare.
000000r 2               BASIC_ZP_START = $4A
000000r 2               BASIC_ZP_END   = $DD
000000r 2               
000000r 2               .feature org_per_seg    ; enable segment-Local Scope
000000r 2               .zeropage
000000r 2               
000000r 2               ; ----------------------------------------------------------------------------
000000r 2               ; $00 fault beacon scratch
000000r 2               ; post_fail writes $01/$00 here to toggle D0 on the data bus.
000000r 2               ; ----------------------------------------------------------------------------
000000r 2               .org $00
000000  2               ZP_START:
000000  2  xx             .res 1
000001  2               .assert * <= $24, error, "zero page: block at $00 runs into WozMon variables"
000001  2               
000001  2               ; ----------------------------------------------------------------------------
000001  2               ; $24-$2B WozMon
000001  2               ; ----------------------------------------------------------------------------
000001  2               .org $24
000024  2               XAML:                   ; Last "opened" location Low
000024  2  xx             .res 1
000025  2               XAMH:                   ; Last "opened" location High
000025  2  xx             .res 1
000026  2               STL:                    ; Store address Low
000026  2  xx             .res 1
000027  2               STH:                    ; Store address High
000027  2  xx             .res 1
000028  2               L:                      ; Hex value parsing Low
000028  2  xx             .res 1
000029  2               H:                      ; Hex value parsing High
000029  2  xx             .res 1
00002A  2               YSAV:                   ; Used to see if hex value is given
00002A  2  xx             .res 1
00002B  2               MODE:                   ; $00=XAM, $7F=STOR, $AE=BLOCK XAM
00002B  2  xx             .res 1
00002C  2               .assert * <= $30, error, "zero page: WozMon block runs into the Intel HEX variables"
00002C  2               
00002C  2               ; ----------------------------------------------------------------------------
00002C  2               ; $30-$35 Intel HEX load/save scratch
00002C  2               ; ----------------------------------------------------------------------------
00002C  2               .org $30
000030  2               IHEX_ADDR:              ; record load address (LO/HI)
000030  2               IHEX_ADDR_L:
000030  2  xx             .res 1
000031  2               IHEX_ADDR_H:
000031  2  xx             .res 1
000032  2               IHEX_LEN:               ; record byte count
000032  2  xx             .res 1
000033  2               IHEX_TYPE:              ; record type (00 data, 01 EOF)
000033  2  xx             .res 1
000034  2               IHEX_SUM:               ; running checksum accumulator
000034  2  xx             .res 1
000035  2               IHEX_TMP:               ; general scratch
000035  2  xx             .res 1
000036  2               .assert * <= $40, error, "zero page: Intel HEX block runs into the register print variables"
000036  2               
000036  2               ; ----------------------------------------------------------------------------
000036  2               ; $40-$46 monitor register print
000036  2               ; ----------------------------------------------------------------------------
000036  2               .org $40
000040  2               P_STATUS:
000040  2               PC_REG_H:
000040  2  xx             .res 1
000041  2               PC_REG_L:
000041  2  xx             .res 1
000042  2               SP_REG:
000042  2  xx             .res 1
000043  2               A_REG:
000043  2  xx             .res 1
000044  2               X_REG:
000044  2  xx             .res 1
000045  2               Y_REG:
000045  2  xx             .res 1
000046  2               SR_REG:
000046  2  xx             .res 1
000047  2               .assert * <= BASIC_ZP_START, error, "zero page: register print block runs into the BASIC variables"
000047  2               
000047  2               ; ----------------------------------------------------------------------------
000047  2               ; BASIC_ZP_START-BASIC_ZP_END: reserved for BASIC.
000047  2               ; ----------------------------------------------------------------------------
000047  2               
000047  2               ; ----------------------------------------------------------------------------
000047  2               ; $E0-$EA BIOS system variables
000047  2               ; ----------------------------------------------------------------------------
000047  2               .org $E0
0000E0  2               TOCKS:                  ; Jiffy-like clock, 3 bytes, ~10ms per tick
0000E0  2               TOCKS_L:
0000E0  2  xx             .res 1
0000E1  2               TOCKS_M:
0000E1  2  xx             .res 1
0000E2  2               TOCKS_H:
0000E2  2  xx             .res 1
0000E3  2               RAM_SIZE:               ; RAM size, 2 bytes: top usable RAM address + 1.
0000E3  2               RAM_SIZE_L:             ; The POST writes it, BASIC reads it as MEMSIZ.
0000E3  2  xx             .res 1
0000E4  2               RAM_SIZE_H:
0000E4  2  xx             .res 1
0000E5  2               PTR_RD_RX_BUF:          ; RX Read Buffer Pointer
0000E5  2  xx             .res 1
0000E6  2               PTR_WR_RX_BUF:          ; RX Write Buffer Pointer
0000E6  2  xx             .res 1
0000E7  2               PTR_TX:                 ; Transmit string pointer (used by BIOS_SERIAL_STR)
0000E7  2               PTR_TX_L:
0000E7  2  xx             .res 1
0000E8  2               PTR_TX_H:
0000E8  2  xx             .res 1
0000E9  2               BASIC_STARTED:          ; non-zero once BASIC has been cold started. The BIOS reset clears it and
0000E9  2  xx             .res 1                ; BASIC's cold start sets it. The monitor X command warm starts BASIC only
0000EA  2                                       ; if it is set, because a warm start needs what the cold start sets up.
0000EA  2               MACHINE_CONFIG:         ; One bit per peripheral, set when the BIOS found and initialized it. The BIOS
0000EA  2  xx             .res 1                ; reset clears it. Programs may read it, the bits are BIOS_CFG_* in bios_jumptable.inc.
0000EB  2               .assert * <= $100, error, "zero page: BIOS system block runs past the end of the zero page"
0000EB  2               .assert TOCKS > BASIC_ZP_END, error, "zero page: BIOS system block overlaps the BASIC variables"
0000EB  2               
0000EB  1               
0000EB  1               ; -- ROM START --
0000EB  1               ;.org $8000
0000EB  1               
0000EB  1               ; ## BIOS Jump Table (public ABI) ##
0000EB  1               ; The fixed-address jump table at the start of ROM is in bios_header.s
0000EB  1               .include "bios_jumptable.inc"
0000EB  2               ; simple6502 BIOS - Public Jump Table (ABI)
0000EB  2               ;
0000EB  2               ; Fixed entry-point addresses for the BIOS routines. External programs that run
0000EB  2               ; on the simple6502 (user programs, loaders, future BASIC, etc.) should call
0000EB  2               ; these addresses rather than the BIOS's internal labels, which move whenever
0000EB  2               ; the BIOS is rebuilt.
0000EB  2               ;
0000EB  2               ; The table lives at the start of ROM ($8000); each entry is a 3-byte JMP.
0000EB  2               ;
0000EB  2               ; CONTRACT: the table is APPEND-ONLY. Addresses here are frozen. New routines
0000EB  2               ; are added at the end (next free slot). Never insert or reorder.
0000EB  2               ;
0000EB  2               ; Usage from an assembly program:
0000EB  2               ;     .include "bios_jumptable.inc"
0000EB  2               ;     lda #'A'
0000EB  2               ;     jsr BIOS_SERIAL_OUT
0000EB  2               
0000EB  2               BIOS_JUMPTABLE = $8000              ; base address of the table
0000EB  2               
0000EB  2               BIOS_COLD_START = BIOS_JUMPTABLE + 0*3   ; $8000 cold start / reset
0000EB  2               BIOS_MONITOR    = BIOS_JUMPTABLE + 1*3   ; $8003 enter WozMon
0000EB  2               BIOS_SERIAL_OUT = BIOS_JUMPTABLE + 2*3   ; $8006 transmit A over serial
0000EB  2               BIOS_SERIAL_IN  = BIOS_JUMPTABLE + 3*3   ; $8009 receive byte (carry set if data in A)
0000EB  2               BIOS_SERIAL_STR = BIOS_JUMPTABLE + 4*3   ; $800C transmit null-terminated string @ PTR_TX
0000EB  2               BIOS_SERIAL_HEX = BIOS_JUMPTABLE + 5*3   ; $800F transmit A as two ASCII hex digits
0000EB  2               BIOS_OUT_CRLF   = BIOS_JUMPTABLE + 6*3   ; $8012 transmit CR + LF
0000EB  2               BIOS_SERIAL_POLL = BIOS_JUMPTABLE + 7*3  ; $8015 receive byte, no echo (carry set if data in A)
0000EB  2               BIOS_BASIC_COLD = BIOS_JUMPTABLE + 8*3   ; $8018 cold start MS BASIC (new program, memory cleared)
0000EB  2               BIOS_BASIC_WARM = BIOS_JUMPTABLE + 9*3   ; $801B warm start MS BASIC (keeps the program and variables)
0000EB  2               BIOS_LOAD       = BIOS_JUMPTABLE + 10*3  ; $801E BASIC LOAD (stub for now, just RTS)
0000EB  2               BIOS_SAVE       = BIOS_JUMPTABLE + 11*3  ; $8021 BASIC SAVE (stub for now, just RTS)
0000EB  2               BIOS_GET_TOCKS  = BIOS_JUMPTABLE + 12*3  ; $8024 read the TOCKS jiffy clock: A = low, X = middle, Y = high byte
0000EB  2               ; VIA port routines. The same convention in all four: X = VIA index (0 = VIA1), Y = port (0 = A, 1 = B).
0000EB  2               ; Returns:
0000EB  2               ; Carry clear = done/complete, set = failure (no such VIA, port is not 0 or 1).
0000EB  2               ; BIOS_VIA_READ A = read value
0000EB  2               BIOS_VIA_CONFIG  = BIOS_JUMPTABLE + 13*3 ; $8027 check VIA (X = VIA index), carry clear = found and initialized
0000EB  2               BIOS_VIA_SET_DDR = BIOS_JUMPTABLE + 14*3 ; $802A set DDR (X = VIA index, Y = port 0/1, A = DDR pattern, 1 = output)
0000EB  2               BIOS_VIA_READ    = BIOS_JUMPTABLE + 15*3 ; $802D read port (X = VIA index, Y = port 0/1) -> returns A
0000EB  2               BIOS_VIA_WRITE   = BIOS_JUMPTABLE + 16*3 ; $8030 write port (X = VIA index, Y = port 0/1, A = data)
0000EB  2               
0000EB  2               ; Machine configuration byte, in zero page. One bit per peripheral: the BIOS sets it when it has
0000EB  2               ; found and initialized the peripheral. The BIOS reset clears the byte, so only the peripherals
0000EB  2               ; that are really there are set. Add a bit here when a peripheral is supported.
0000EB  2               ; (zeropage.s declares the byte as MACHINE_CONFIG, bios_header.s checks that they agree.)
0000EB  2               BIOS_MACHINE_CONFIG = $EA
0000EB  2               BIOS_CFG_SERIAL = %00000001         ; bit 0: on board serial port (ACIA) initialized
0000EB  2               BIOS_CFG_VIA1   = %00000010         ; bit 1: VIA 1 found and initialized (the TOCKS clock runs)
0000EB  2               BIOS_CFG_VIA2   = %00000100         ; bit 2: VIA 2 (reserved, nothing sets it yet)
0000EB  2               
0000EB  2               ; MS BASIC's own entry points, the two JMPs at the start of its ROM region
0000EB  2               ; (basic/header.s, BASROM at $DC00 in simple6502.cfg). The jump table slots above
0000EB  2               ; go there. basic/header.s checks at link time that BASIC really starts at these.
0000EB  2               BASIC_COLD_START = $DC00            ; cold start
0000EB  2               BASIC_WARM_START = $DC03            ; warm start (RESTART)
0000EB  2               
0000EB  1               .include "bios_header.s"
0000EB  2               ; simple6502 BIOS header: the jump table (public ABI)
0000EB  2               ;
0000EB  2               ; Fixed-address entry points so external programs can call BIOS routines at
0000EB  2               ; stable addresses that never change as the BIOS internals grow.
0000EB  2               ;
0000EB  2               ; The table lives at the very start of ROM ($8000) and each entry is a 3-byte
0000EB  2               ; JMP. CONTRACT: entries are APPEND-ONLY. Never insert, reorder, or remove a
0000EB  2               ; slot - that would shift every entry below it and break existing binaries.
0000EB  2               ; Add new routines to the end only.
0000EB  2               ;
0000EB  2               ; Slot  Address  Routine
0000EB  2               ; ----  -------  ----------------------------------------------------------
0000EB  2               ;  0    $8000    J_COLD_START  - cold start / reset entry
0000EB  2               ;  1    $8003    J_MONITOR     - enter WozMon monitor
0000EB  2               ;  2    $8006    J_SERIAL_OUT  - transmit A over serial
0000EB  2               ;  3    $8009    J_SERIAL_IN   - receive a byte (carry set if data)
0000EB  2               ;  4    $800C    J_SERIAL_STR  - transmit null-terminated string @ PTR_TX
0000EB  2               ;  5    $800F    J_SERIAL_HEX  - transmit A as two ASCII hex digits
0000EB  2               ;  6    $8012    J_OUT_CRLF    - transmit CR+LF
0000EB  2               ;  7    $8015    J_SERIAL_POLL - receive a byte, no echo (carry set if data)
0000EB  2               ;  8    $8018    J_BASIC_COLD  - cold start MS BASIC (new program, memory cleared)
0000EB  2               ;  9    $801B    J_BASIC_WARM  - warm start MS BASIC (keeps the program and variables)
0000EB  2               ; 10    $801E    J_LOAD        - BASIC LOAD (stub for now, just RTS)
0000EB  2               ; 11    $8021    J_SAVE        - BASIC SAVE (stub for now, just RTS)
0000EB  2               ; 12    $8024    J_GET_TOCKS   - read the TOCKS jiffy clock (A = low, X = middle, Y = high)
0000EB  2               ; 13    $8027    J_VIA_CONFIG  - check VIA (X = VIA index), carry clear = found
0000EB  2               ; 14    $802A    J_VIA_SET_DDR - set DDR (X = VIA index, Y = port 0/1, A = DDR pattern)
0000EB  2               ; 15    $802D    J_VIA_READ    - read port (X = VIA index, Y = port 0/1) -> A
0000EB  2               ; 16    $8030    J_VIA_WRITE   - write port (X = VIA index, Y = port 0/1, A = data)
0000EB  2               ;
0000EB  2               ; The equates for these addresses live in bios_jumptable.inc for programs to
0000EB  2               ; include. The .asserts at the end of this file stop the build if the two get
0000EB  2               ; out of sync, so when you append an entry here also add its equate there.
0000EB  2               ;
0000EB  2               ; Included by BIOS.s. The routines the entries jump to are in BIOS.s and
0000EB  2               ; wozmon_sbc.s. BIOS.s includes bios_jumptable.inc before this file.
0000EB  2               
0000EB  2               .segment "HEADER"
000000r 2  4C rr rr     J_COLD_START:  jmp reset            ; slot 0  $8000
000003r 2  4C rr rr     J_MONITOR:     jmp WOZMON           ; slot 1  $8003
000006r 2  4C rr rr     J_SERIAL_OUT:  jmp serial_out       ; slot 2  $8006
000009r 2  4C rr rr     J_SERIAL_IN:   jmp serial_in        ; slot 3  $8009
00000Cr 2  4C rr rr     J_SERIAL_STR:  jmp serial_out_str   ; slot 4  $800C
00000Fr 2  4C rr rr     J_SERIAL_HEX:  jmp serial_out_hex   ; slot 5  $800F
000012r 2  4C rr rr     J_OUT_CRLF:    jmp out_crlf         ; slot 6  $8012
000015r 2  4C rr rr     J_SERIAL_POLL: jmp serial_poll      ; slot 7  $8015
000018r 2  4C 00 DC     J_BASIC_COLD:  jmp BASIC_COLD_START ; slot 8  $8018  BASIC's own entry, $DC00
00001Br 2  4C 03 DC     J_BASIC_WARM:  jmp BASIC_WARM_START ; slot 9  $801B  BASIC's own entry, $DC03
00001Er 2  4C rr rr     J_LOAD:        jmp bios_load        ; slot 10 $801E
000021r 2  4C rr rr     J_SAVE:        jmp bios_save        ; slot 11 $8021
000024r 2  4C rr rr     J_GET_TOCKS:   jmp bios_get_tocks   ; slot 12 $8024
000027r 2  4C rr rr     J_VIA_CONFIG:  jmp via_config       ; slot 13 $8027
00002Ar 2  4C rr rr     J_VIA_SET_DDR: jmp via_set_ddr      ; slot 14 $802A
00002Dr 2  4C rr rr     J_VIA_READ:    jmp via_read         ; slot 15 $802D
000030r 2  4C rr rr     J_VIA_WRITE:   jmp via_write        ; slot 16 $8030
000033r 2               
000033r 2               ; Keep MONITOR as an alias for existing code that referenced it.
000033r 2               MONITOR = J_MONITOR
000033r 2               
000033r 2               ; The table must match bios_jumptable.inc. The table is in a relocatable segment,
000033r 2               ; so the linker checks these once it has placed HEADER at $8000.
000033r 2               .assert J_COLD_START  = BIOS_COLD_START,  lderror, "jump table slot 0 does not match bios_jumptable.inc"
000033r 2               .assert J_MONITOR     = BIOS_MONITOR,     lderror, "jump table slot 1 does not match bios_jumptable.inc"
000033r 2               .assert J_SERIAL_OUT  = BIOS_SERIAL_OUT,  lderror, "jump table slot 2 does not match bios_jumptable.inc"
000033r 2               .assert J_SERIAL_IN   = BIOS_SERIAL_IN,   lderror, "jump table slot 3 does not match bios_jumptable.inc"
000033r 2               .assert J_SERIAL_STR  = BIOS_SERIAL_STR,  lderror, "jump table slot 4 does not match bios_jumptable.inc"
000033r 2               .assert J_SERIAL_HEX  = BIOS_SERIAL_HEX,  lderror, "jump table slot 5 does not match bios_jumptable.inc"
000033r 2               .assert J_OUT_CRLF    = BIOS_OUT_CRLF,    lderror, "jump table slot 6 does not match bios_jumptable.inc"
000033r 2               .assert J_SERIAL_POLL = BIOS_SERIAL_POLL, lderror, "jump table slot 7 does not match bios_jumptable.inc"
000033r 2               .assert J_BASIC_COLD  = BIOS_BASIC_COLD,  lderror, "jump table slot 8 does not match bios_jumptable.inc"
000033r 2               .assert J_BASIC_WARM  = BIOS_BASIC_WARM,  lderror, "jump table slot 9 does not match bios_jumptable.inc"
000033r 2               .assert J_LOAD        = BIOS_LOAD,        lderror, "jump table slot 10 does not match bios_jumptable.inc"
000033r 2               .assert J_SAVE        = BIOS_SAVE,        lderror, "jump table slot 11 does not match bios_jumptable.inc"
000033r 2               .assert J_GET_TOCKS   = BIOS_GET_TOCKS,   lderror, "jump table slot 12 does not match bios_jumptable.inc"
000033r 2               .assert J_VIA_CONFIG  = BIOS_VIA_CONFIG,  lderror, "jump table slot 13 does not match bios_jumptable.inc"
000033r 2               .assert J_VIA_SET_DDR = BIOS_VIA_SET_DDR, lderror, "jump table slot 14 does not match bios_jumptable.inc"
000033r 2               .assert J_VIA_READ    = BIOS_VIA_READ,    lderror, "jump table slot 15 does not match bios_jumptable.inc"
000033r 2               .assert J_VIA_WRITE   = BIOS_VIA_WRITE,   lderror, "jump table slot 16 does not match bios_jumptable.inc"
000033r 2               .assert MACHINE_CONFIG = BIOS_MACHINE_CONFIG, lderror, "MACHINE_CONFIG in zeropage.s does not match BIOS_MACHINE_CONFIG in bios_jumptable.inc"
000033r 2               
000033r 1               
000033r 1               ; ## BIOS Start ##
000033r 1               .segment "BIOS"
000000r 1                 ; Write an identifier in the rom so it can be identified when dumping the ROM
000000r 1  42 49 4F 53    .byte "BIOS-simple6502-v"
000004r 1  2D 73 69 6D  
000008r 1  70 6C 65 36  
000011r 1  30 2E 31 31    .byte VERSION
000015r 1  2E 30        
000017r 1               
000017r 1               ; Reset Vector Start - BIOS Cold Start
000017r 1               reset:
000017r 1  78             sei               ; 78      disable interrupts
000018r 1  D8             cld               ; D8      turn decimal mode off
000019r 1                 ; Memory Check: Zero Page and Stack (Page 1)
000019r 1                 ; These run BEFORE the stack is used so we can test Page 1
000019r 1                 ; A mismatch jumps to post_fail.
000019r 1               
000019r 1                 ; Test Zero Page ($0000-$00FF): checkerboard $55 then $AA
000019r 1  A2 00          ldx #0
00001Br 1               @zp_55:
00001Br 1  A9 55          lda #$55
00001Dr 1  95 00          sta $00,x
00001Fr 1  D5 00          cmp $00,x
000021r 1  D0 50          bne post_fail
000023r 1  E8             inx
000024r 1  D0 F5          bne @zp_55
000026r 1               @zp_aa:
000026r 1  A9 AA          lda #$AA
000028r 1  95 00          sta $00,x         ; x wrapped back to 0
00002Ar 1  D5 00          cmp $00,x
00002Cr 1  D0 45          bne post_fail
00002Er 1  E8             inx
00002Fr 1  D0 F5          bne @zp_aa
000031r 1               
000031r 1                 ; Test Stack page / Page 1 ($0100-$01FF): checkerboard $55 then $AA
000031r 1  A2 00          ldx #0
000033r 1               @sp_55:
000033r 1  A9 55          lda #$55
000035r 1  9D 00 01       sta $0100,x
000038r 1  DD 00 01       cmp $0100,x
00003Br 1  D0 36          bne post_fail
00003Dr 1  E8             inx
00003Er 1  D0 F3          bne @sp_55
000040r 1               @sp_aa:
000040r 1  A9 AA          lda #$AA
000042r 1  9D 00 01       sta $0100,x       ; x wrapped back to 0
000045r 1  DD 00 01       cmp $0100,x
000048r 1  D0 29          bne post_fail
00004Ar 1  E8             inx
00004Br 1  D0 F3          bne @sp_aa
00004Dr 1               
00004Dr 1                 ; Initialize ZP variables, the ZP test left $AA
00004Dr 1  64 E9          stz BASIC_STARTED   ; BASIC has not been started
00004Fr 1  64 EA          stz MACHINE_CONFIG  ; no peripheral is initialized yet
000051r 1  64 E3          stz RAM_SIZE_L      ; POST will initialize this
000053r 1  64 E4          stz RAM_SIZE_H
000055r 1               
000055r 1                 ; ZP and stack are good - establish the stack pointer and carry on.
000055r 1  A2 FF          ldx #$FF          ; A2 FF
000057r 1  9A             txs               ; 9A      set the stack start
000058r 1  20 rr rr       jsr post          ; do the rest of POST (RAM walk)
00005Br 1  20 rr rr       jsr serial_init   ; init ACIA # IO_8
00005Er 1  20 rr rr       jsr via_init      ; detect + init VIA1 (carry clear = found)
000061r 1                 ; Print startup message (BIOS banner)
000061r 1  A9 rr          lda #<startupMessage
000063r 1  85 E7          sta PTR_TX
000065r 1  A9 rr          lda #>startupMessage
000067r 1  85 E8          sta PTR_TX_H
000069r 1  20 rr rr       jsr serial_out_str
00006Cr 1                 ; If VIA1 was detected, announce it under the banner: "## VIA1 on $7F20"
00006Cr 1  20 rr rr       jsr via_report
00006Fr 1  58             cli               ; enable IRQs now that handlers/VIA are set up
000070r 1  4C rr rr       jmp WOZMON_COLD   ; BIOS starts with the monitor
000073r 1               
000073r 1               
000073r 1               
000073r 1               ; ### Subroutines ###
000073r 1               
000073r 1               ; post_fail:
000073r 1               ; Reached when the early ZP, Stack, or POST Mem test fails.
000073r 1               ; Serial is NOT up yet and we have no onboard failure indicator (LED/beeper)
000073r 1               ; in rev 1.6 of the SBC hardware so as a placeholder, we signal the fault on
000073r 1               ; the DATA BUS: repeatedly writing $01 then $00 to a Zero Page location drives
000073r 1               ; D0 with a steady ~1 kHz pattern (D1-D7 idle low) that can be caught with a scope
000073r 1               ; This never returns - a failed ZP/stack test is terminal.
000073r 1               ;
000073r 1               ; The position of this routine is critical so the ZP/stack and POST checks can
000073r 1               ; reach it with a branch (6502 branch is -128 to +127 bytes from the memory location
000073r 1               ; immediately following the branch instruction.
000073r 1               ; Routine uses no ZP variables and no stack since those may have failed.
000073r 1               post_fail:
000073r 1  A9 01          lda #$01
000075r 1  85 00          sta ZP_START          ; write 1 -> D0 high on the bus
000077r 1  A2 B6          ldx #$B6              ; 182 -> ~half period delay (~500 us)
000079r 1               @fh:
000079r 1  CA             dex
00007Ar 1  D0 FD          bne @fh
00007Cr 1  A9 00          lda #$00
00007Er 1  85 00          sta ZP_START          ; write 0 -> D0 low on the bus
000080r 1  A2 B6          ldx #$B6
000082r 1               @fl:                    ; this is badly written will tighten it up once I test on the board
000082r 1  CA             dex
000083r 1  D0 FD          bne @fl
000085r 1  80 EC          bra post_fail         ; loop forever (fault beacon)
000087r 1               
000087r 1               ; post:
000087r 1               ; Power on Self Test
000087r 1               ; post runs after the early ZP/stack test, so we can trust both
000087r 1               post:
000087r 1                 ; Walk RAM from $0200 up, store top of RAM in RAM_SIZE
000087r 1                 ; RAM_SIZE holds the first non-RAM address (top usable RAM address + 1).
000087r 1                 ; Checkerboard-test each byte ($55 then $AA) and read it back. Stop at the
000087r 1                 ; first byte that fails or when we reach the I/O space at $7F00.
000087r 1                 POST_PTR = $10        ; Use ZP for RAM-walk pointer, 2 bytes
000087r 1  A9 00          lda #$00
000089r 1  85 10          sta POST_PTR          ; pointer low  = $00
00008Br 1  A9 02          lda #$02
00008Dr 1  85 11          sta POST_PTR+1        ; pointer high = $02  -> start at $0200
00008Fr 1               @ram_walk:
00008Fr 1                 ; stop once we reach I/O space ($7F00)
00008Fr 1  A5 11          lda POST_PTR+1
000091r 1  C9 7F          cmp #$7F
000093r 1  F0 1E          beq @ram_done         ; high byte $7F and low byte $00 -> at $7F00
000095r 1  A0 00          ldy #0
000097r 1  A9 55          lda #$55              ; pattern 1
000099r 1  91 10          sta (POST_PTR),y
00009Br 1  B1 10          lda (POST_PTR),y
00009Dr 1  C9 55          cmp #$55
00009Fr 1  D0 12          bne @ram_done         ; readback failed -> end of RAM
0000A1r 1  A9 AA          lda #$AA              ; pattern 2
0000A3r 1  91 10          sta (POST_PTR),y
0000A5r 1  B1 10          lda (POST_PTR),y
0000A7r 1  C9 AA          cmp #$AA
0000A9r 1  D0 08          bne @ram_done         ; readback failed -> end of RAM
0000ABr 1                 ; byte good, advance pointer
0000ABr 1  E6 10          inc POST_PTR
0000ADr 1  D0 E0          bne @ram_walk
0000AFr 1  E6 11          inc POST_PTR+1
0000B1r 1  80 DC          bra @ram_walk
0000B3r 1               @ram_done:
0000B3r 1                 ; POST_PTR now points one past the last good RAM byte -> store as RAM_SIZE
0000B3r 1  A5 10          lda POST_PTR
0000B5r 1  85 E3          sta RAM_SIZE_L
0000B7r 1  A5 11          lda POST_PTR+1
0000B9r 1  85 E4          sta RAM_SIZE_H
0000BBr 1  60             rts
0000BCr 1               
0000BCr 1               ; ### VIA Routines ###
0000BCr 1               
0000BCr 1               ; via_init:
0000BCr 1               ; Detect VIA1 (on the external I/O card, $7F20) and, if present, set up
0000BCr 1               ; Timer 1 as a free-running ~10ms periodic interrupt that drives the TOCKS
0000BCr 1               ; jiffy clock (incremented in the IRQ handler).
0000BCr 1               ;
0000BCr 1               ; Detection: DDRB is a plain read/write register with no external side effect
0000BCr 1               ; on the value stored, so we write two patterns ($55, $AA) and read them back.
0000BCr 1               ; An absent card reads back open-bus / mirror values and will fail one of the
0000BCr 1               ; two checks.
0000BCr 1               ;
0000BCr 1               ; Returns carry clear if the VIA responded, set if not, and sets (or clears)
0000BCr 1               ; BIOS_CFG_VIA1 in MACHINE_CONFIG. Leaves IRQs enabled on the VIA only when present.
0000BCr 1               ; TOCKS is cleared first of all, so it reads 0 even when there is no VIA and the
0000BCr 1               ; clock never runs, instead of whatever the memory tests left there.
0000BCr 1               ; Overwrites A, X.
0000BCr 1               via_init:
0000BCr 1  64 E0          stz TOCKS_L           ; clear the 3-byte TOCKS jiffy counter
0000BEr 1  64 E1          stz TOCKS_M
0000C0r 1  64 E2          stz TOCKS_H
0000C2r 1                 ; --- presence check on DDRB ---
0000C2r 1  A9 55          lda #$55
0000C4r 1  8D 22 7F       sta VIA1_DDRB
0000C7r 1  CD 22 7F       cmp VIA1_DDRB
0000CAr 1  D0 31          bne @absent
0000CCr 1  A9 AA          lda #$AA        ; the complement: every bit is tested as 0 and as 1
0000CEr 1  8D 22 7F       sta VIA1_DDRB
0000D1r 1  CD 22 7F       cmp VIA1_DDRB
0000D4r 1  D0 27          bne @absent
0000D6r 1                 ; --- VIA present: configure Timer 1 free-run tick ---
0000D6r 1  A9 00          lda #$00
0000D8r 1  8D 22 7F       sta VIA1_DDRB         ; leave Port B as inputs (benign default)
0000DBr 1  8D 23 7F       sta VIA1_DDRA         ; leave Port A as inputs too
0000DEr 1                 ; disable all VIA interrupt sources first
0000DEr 1  A9 7F          lda #VIA_IER_CLR_ALL
0000E0r 1  8D 2E 7F       sta VIA1_IER
0000E3r 1                 ; ACR: Timer 1 continuous (free-run), PB7 output off
0000E3r 1  A9 40          lda #VIA_ACR_T1_FREERUN
0000E5r 1  8D 2B 7F       sta VIA1_ACR
0000E8r 1                 ; load Timer 1 latch/counter for the ~10ms period
0000E8r 1  A9 FE          lda #<VIA_T1_10MS
0000EAr 1  8D 24 7F       sta VIA1_T1CL         ; writing T1C-L loads the low latch
0000EDr 1  A9 47          lda #>VIA_T1_10MS
0000EFr 1  8D 25 7F       sta VIA1_T1CH         ; writing T1C-H loads high latch + starts T1
0000F2r 1                 ; enable the Timer 1 interrupt
0000F2r 1  A9 C0          lda #VIA_IER_T1_ENABLE
0000F4r 1  8D 2E 7F       sta VIA1_IER
0000F7r 1  A9 02          lda #BIOS_CFG_VIA1
0000F9r 1  04 EA          tsb MACHINE_CONFIG    ; record that VIA1 is initialized
0000FBr 1  18             clc                   ; carry clear = found
0000FCr 1  60             rts
0000FDr 1               @absent:
0000FDr 1  9C 22 7F       stz VIA1_DDRB         ; restore a benign DDRB (inputs)
000100r 1  A9 02          lda #BIOS_CFG_VIA1
000102r 1  14 EA          trb MACHINE_CONFIG    ; make sure the bit is clear
000104r 1  38             sec                   ; carry set = not found
000105r 1  60             rts
000106r 1               
000106r 1               ; via_report:
000106r 1               ; If VIA1 was detected, print a line under the BIOS banner:
000106r 1               ;   ## VIA1 on $7F20
000106r 1               ; Does nothing if the VIA is absent. Overwrites A, Y.
000106r 1               via_report:
000106r 1  A5 EA          lda MACHINE_CONFIG
000108r 1  29 02          and #BIOS_CFG_VIA1
00010Ar 1  F0 0B          beq @done
00010Cr 1  A9 rr          lda #<viaMessage
00010Er 1  85 E7          sta PTR_TX
000110r 1  A9 rr          lda #>viaMessage
000112r 1  85 E8          sta PTR_TX_H
000114r 1  20 rr rr       jsr serial_out_str
000117r 1               @done:
000117r 1  60             rts
000118r 1               
000118r 1               ; ### VIA ports ###
000118r 1               
000118r 1               ; via_config, via_set_ddr, via_read, via_write:
000118r 1               ; Public VIA port routines, reached through BIOS_VIA_CONFIG, BIOS_VIA_SET_DDR, BIOS_VIA_READ
000118r 1               ; and BIOS_VIA_WRITE.
000118r 1               ; They all use the same convention:
000118r 1               ;   X = VIA index (0 = VIA1, 1 = VIA2, etc.)
000118r 1               ;   Y = Port (0 = port A, 1 = port B)
000118r 1               ;   A = Data (the DDR pattern (via_set_ddr) or the data to write (via_write)
000118r 1               ;   Returns: Carry set = Fail ; clear = complete. On fail the routine does nothing.
000118r 1               ;
000118r 1               ;   Always Fails if the VIA is not one the BIOS found and initialized at boot (MACHINE_CONFIG), or if
000118r 1               ;   the port is not 0 or 1.
000118r 1               
000118r 1               ; via_config:
000118r 1               ; carry set if VIA X was found and initialized at boot, clear if not.
000118r 1               ; An index with no VIA behind it (VIA_COUNT and up) is "not found".
000118r 1               via_config:
000118r 1  48               pha
000119r 1  E0 01            cpx #VIA_COUNT        ; carry set if the index is too high, that is the failure
00011Br 1  B0 0B            bcs @done
00011Dr 1  A5 EA            lda MACHINE_CONFIG
00011Fr 1  3D rr rr         and via_cfg_mask,x    ; this VIA's bit
000122r 1  F0 03            beq @absent
000124r 1  18               clc                   ; found
000125r 1  80 01            bra @done
000127r 1               @absent:
000127r 1  38               sec                   ; no via found
000128r 1               @done:
000128r 1  68               pla                   ; does not touch carry
000129r 1  60               rts
00012Ar 1               
00012Ar 1               ; The MACHINE_CONFIG bit of each VIA, by VIA index
00012Ar 1               via_cfg_mask:
00012Ar 1  02               .byte BIOS_CFG_VIA1
00012Br 1               via_cfg_mask_end:
00012Br 1               .assert via_cfg_mask_end - via_cfg_mask = VIA_COUNT, error, "via_cfg_mask must have VIA_COUNT entries"
00012Br 1               
00012Br 1               ; via_select: carry clear if VIA X exists and Y is a port (0 or 1), set if not.
00012Br 1               via_select:
00012Br 1  20 rr rr         jsr via_config
00012Er 1  B0 02            bcs @done
000130r 1  C0 02            cpy #2                ; carry set if Y is 2 or more
000132r 1               @done:
000132r 1  60               rts
000133r 1               
000133r 1               ; via_set_ddr:
000133r 1               ;   write the DDR pattern in A to port Y of VIA X.
000133r 1               via_set_ddr:
000133r 1  20 rr rr         jsr via_select
000136r 1  B0 0D            bcs @done
000138r 1  C0 01            cpy #1
00013Ar 1  F0 05            beq @port_b
00013Cr 1  8D 23 7F         sta VIA1_DDRA         ; Y = 0
00013Fr 1  18               clc
000140r 1  60               rts
000141r 1               @port_b:
000141r 1  8D 22 7F         sta VIA1_DDRB         ; Y = 1
000144r 1  18               clc
000145r 1               @done:
000145r 1  60               rts
000146r 1               
000146r 1               ; via_read:
000146r 1               ;   read port Y of VIA X, the value comes back in A.
000146r 1               via_read:
000146r 1  20 rr rr         jsr via_select
000149r 1  B0 0D            bcs @done
00014Br 1  C0 01            cpy #1
00014Dr 1  F0 05            beq @port_b
00014Fr 1  AD 21 7F         lda VIA1_PORTA        ; Y = 0
000152r 1  18               clc
000153r 1  60               rts
000154r 1               @port_b:
000154r 1  AD 20 7F         lda VIA1_PORTB        ; Y = 1
000157r 1  18               clc
000158r 1               @done:
000158r 1  60               rts
000159r 1               
000159r 1               ; via_write:
000159r 1               ;   write A to port Y of VIA X.
000159r 1               via_write:
000159r 1  20 rr rr         jsr via_select
00015Cr 1  B0 0D            bcs @done
00015Er 1  C0 01            cpy #1
000160r 1  F0 05            beq @port_b
000162r 1  8D 21 7F         sta VIA1_PORTA        ; Y = 0
000165r 1  18               clc
000166r 1  60               rts
000167r 1               @port_b:
000167r 1  8D 20 7F         sta VIA1_PORTB        ; Y = 1
00016Ar 1  18               clc
00016Br 1               @done:
00016Br 1  60               rts
00016Cr 1               
00016Cr 1               ; ### TOCKS (jiffy clock) ###
00016Cr 1               ; TOCKS are a jiffy like clock that relies on VIA1 Timer 1.
00016Cr 1               ; It generates one IRQ every ~10ms, these ticks are counted by irq_handler and stored
00016Cr 1               ; the 3-byte in the ZP TOCKS variable
00016Cr 1               
00016Cr 1               ; bios_get_tocks:
00016Cr 1               ; Read the 24-bit TOCKS jiffy clock in a safe way. The interrupt can trigger and increment
00016Cr 1               ; TOCKS between two reads of its three bytes if that increment has a carry it will read a
00016Cr 1               ; wrong value. This routine masks the interrupt for the three loads, a few cycles, so the
00016Cr 1               ; three bytes are from the same moment.
00016Cr 1               ; The clock only runs if VIA1 was found (BIOS_CFG_VIA1 in MACHINE_CONFIG).
00016Cr 1               ;
00016Cr 1               ; Returns A = low byte, X = middle byte, Y = high byte.
00016Cr 1               ;
00016Cr 1               bios_get_tocks:
00016Cr 1  08             php               ; keep the caller's interrupt state
00016Dr 1  78             sei               ; no tick between the three loads
00016Er 1  A5 E0          lda TOCKS_L
000170r 1  A6 E1          ldx TOCKS_M
000172r 1  A4 E2          ldy TOCKS_H
000174r 1  28             plp               ; back to the caller's interrupt state
000175r 1  60             rts
000176r 1               
000176r 1               ; ### Serial Routines ###
000176r 1               ; Initializes the on board serial interface
000176r 1               ; Reset and set config for the ACIA. Init the RX buffer pointer.
000176r 1               ; Sets BIOS_CFG_SERIAL in MACHINE_CONFIG.
000176r 1               serial_init:
000176r 1  A9 03          lda #ACIA_RESET
000178r 1  8D 72 7F       sta ACIA_CONTROL
00017Br 1  A9 16          lda #ACIA_CFG_28    ; 28800 8,N,1, see defines file for options
00017Dr 1  8D 72 7F       sta ACIA_CONTROL
000180r 1                 ; Init the RX buffer pointers
000180r 1  A9 00          lda #0
000182r 1  85 E5          sta PTR_RD_RX_BUF
000184r 1  85 E6          sta PTR_WR_RX_BUF
000186r 1  A9 01          lda #BIOS_CFG_SERIAL
000188r 1  04 EA          tsb MACHINE_CONFIG  ; record that the serial port is initialized
00018Ar 1  60             rts
00018Br 1               
00018Br 1               
00018Br 1               ; serial_out:
00018Br 1               ; Transmit the char in the A Register via the on board
00018Br 1               ; serial ACIA TTL-RS232
00018Br 1               ; This routine uses polling mode and will wait until the ACIA
00018Br 1               ; TX Data Register (TXDR) bit 1 is Empty to send the character.
00018Br 1               serial_out:
00018Br 1  48             pha
00018Cr 1                 poll_acia: ; polling mode until ready to TX
00018Cr 1  AD 72 7F         lda ACIA_STATUS
00018Fr 1  29 02            and #ACIA_TDRE     ; looking at Bit 1 TX Data Register Empty > High = Empty
000191r 1  F0 F9            beq poll_acia     ; polling loop if empty
000193r 1  68             pla
000194r 1  8D 73 7F       sta ACIA_DATA       ; output char in A to TDRE
000197r 1  60             rts
000198r 1               
000198r 1               ; serial_poll:
000198r 1               ; Non-blocking, NON-echoing read of the ACIA. Checks whether a byte is
000198r 1               ; waiting and returns immediately either way.
000198r 1               ; - Byte waiting: byte in A, Carry set
000198r 1               ; - Nothing waiting: Carry clear (A is undefined)
000198r 1               ; - X, Y preserved
000198r 1               ; Intended for programs that poll the keyboard (BASIC GET / Ctrl-C check,
000198r 1               ; games, editors) and do their own echoing.
000198r 1               serial_poll:
000198r 1  AD 72 7F       lda ACIA_STATUS
00019Br 1  29 01          and #ACIA_RDRF    ; look at Bit 0 RX Data Register Full > High = Full
00019Dr 1  F0 05          beq @no_data      ; nothing in the RX Buffer
00019Fr 1  AD 73 7F       lda ACIA_DATA     ; load the byte to A
0001A2r 1  38             sec               ; we have data set Carry
0001A3r 1  60             rts
0001A4r 1               @no_data:
0001A4r 1  18             clc               ; no data RX clear carry
0001A5r 1  60             rts
0001A6r 1               
0001A6r 1               ; serial_in:
0001A6r 1               ; Takes the byte received by that ACIA and returns it in A (accumulator)
0001A6r 1               ; if a byte was received sets the Carry Flag, if not it clears it
0001A6r 1               ; Same as serial_poll, but echoes the received byte back to the terminal.
0001A6r 1               ;
0001A6r 1               serial_in:
0001A6r 1  20 rr rr       jsr serial_poll   ; non-blocking read, no echo
0001A9r 1  90 04          bcc @no_data      ; nothing received, carry already clear
0001ABr 1  20 rr rr       jsr serial_out    ; echo back (returns the byte in A)
0001AEr 1  38             sec               ; we have data set Carry
0001AFr 1               @no_data:
0001AFr 1  60             rts
0001B0r 1               
0001B0r 1               ; serial_in_raw:
0001B0r 1               ; Blocking read of one byte from the ACIA into A. No echo, no buffering.
0001B0r 1               ; Spins until a byte is available in the RX Data Register.
0001B0r 1               ; Used by the Intel HEX loader where we parse before echoing.
0001B0r 1               ; - A holds the received byte on return
0001B0r 1               ; - X, Y preserved
0001B0r 1               serial_in_raw:
0001B0r 1  AD 72 7F       lda ACIA_STATUS
0001B3r 1  29 01          and #ACIA_RDRF    ; Bit 0 RX Data Register Full > High = Full
0001B5r 1  F0 F9          beq serial_in_raw ; wait for a byte
0001B7r 1  AD 73 7F       lda ACIA_DATA     ; load the byte to A
0001BAr 1  60             rts
0001BBr 1               
0001BBr 1               ; serial_out_str:
0001BBr 1               ; Sends the a null terminated string via serial
0001BBr 1               ; uses the ZP variable PTR_TX (PTR_TX_L + PTR_TX_H) as the pointer
0001BBr 1               ; to the string memory location
0001BBr 1               ; - Y register is not preserved
0001BBr 1               serial_out_str:
0001BBr 1  A0 00          ldy #0
0001BDr 1                 @loop:
0001BDr 1  B1 E7            lda (PTR_TX),y
0001BFr 1  F0 06            beq @null_found
0001C1r 1  20 rr rr         jsr serial_out
0001C4r 1  C8               iny
0001C5r 1  80 F6            bra @loop
0001C7r 1                 @null_found:
0001C7r 1  60             rts
0001C8r 1               
0001C8r 1               ; # Helper Routines for Serial comms
0001C8r 1               
0001C8r 1               ; serial_out_hex:
0001C8r 1               ; Transmit the value of the A Register as ASCII HEX byte
0001C8r 1               ; Need to check this routine, can be optimized
0001C8r 1               serial_out_hex:
0001C8r 1  48             pha             ; keep the register for further manipulation
0001C9r 1  4A             lsr             ; process the high nibble (MSD) shifting it to the low nibble
0001CAr 1  4A             lsr
0001CBr 1  4A             lsr
0001CCr 1  4A             lsr
0001CDr 1  29 0F          and #$0F        ; Mask LSD for hex print.
0001CFr 1  09 30          ora #$30        ; this is like adding $30 > ASCII numbers start at $30 the OR %00110000 sets the high bits shifting the hex value to the right place.
0001D1r 1  C9 3A          cmp #$3A        ; is less than '9' $39
0001D3r 1  90 02          bcc @done       ; A is < 9 ($3A) so we already have the ASCII of the number
0001D5r 1  69 06          adc #$06        ; A is > 9 ($3A) so add 6 + carry (carry is set by CMP) to offset for letters (A $41 - F $46)
0001D7r 1               @done:
0001D7r 1  20 rr rr       jsr serial_out  ; send the MSD since its ready
0001DAr 1  68             pla             ; get the original value back
0001DBr 1  29 0F          and #$0F        ; process the low nibble (LSD)
0001DDr 1  09 30          ora #$30
0001DFr 1  C9 3A          cmp #$3A
0001E1r 1  90 02          bcc @done2
0001E3r 1  69 06          adc #$06
0001E5r 1               @done2:
0001E5r 1  20 rr rr       jsr serial_out
0001E8r 1  60             rts
0001E9r 1               
0001E9r 1               ; out_crlf
0001E9r 1               ; Transmit a CR+LF > $0D,$0A
0001E9r 1               ; Preserves all registers
0001E9r 1               out_crlf:
0001E9r 1  48             pha
0001EAr 1  A9 0D          lda #CR
0001ECr 1  20 rr rr       jsr serial_out
0001EFr 1  A9 0A          lda #LF
0001F1r 1  20 rr rr       jsr serial_out
0001F4r 1  68             pla
0001F5r 1  60             rts
0001F6r 1               
0001F6r 1               ; ### Monitor Helper Routines ###
0001F6r 1               
0001F6r 1               ; ### Command Dispatch ###
0001F6r 1               ; This enables adding commands to WozMon preventing the core code to grow in size
0001F6r 1               ;
0001F6r 1               ; cmd_dispatch:
0001F6r 1               ; Called from WozMon's command parser with the current input char in A.
0001F6r 1               ; Decodes the single-letter commands R (run), L (load Intel HEX),
0001F6r 1               ; S (save Intel HEX) and X (exit to BASIC, like the PET monitor). If the char
0001F6r 1               ; is none of these, returns with A and X unchanged so WozMon can continue its
0001F6r 1               ; normal hex parse.
0001F6r 1               ; For R/L/S the command is executed and control returns to WozMon
0001F6r 1               ; (WARMWOZ) rather than back to the caller. X does not return.
0001F6r 1               ; - On no match: A and X preserved, RTS
0001F6r 1               cmd_dispatch:
0001F6r 1  C9 52          cmp #'R'          ; run program at XAM address?
0001F8r 1  F0 0D          beq @run
0001FAr 1  C9 4C          cmp #'L'          ; load Intel HEX?
0001FCr 1  F0 12          beq @load
0001FEr 1  C9 53          cmp #'S'          ; save Intel HEX?
000200r 1  F0 14          beq @save
000202r 1  C9 58          cmp #'X'          ; exit to BASIC?
000204r 1  F0 16          beq @basic
000206r 1  60             rts               ; not a command, back to WozMon hex parse (A,X intact)
000207r 1               @run:
000207r 1  20 rr rr       jsr @run_sub      ; JSR so an RTS from the user program returns here
00020Ar 1  4C rr rr       jmp WARMWOZ       ; then warm-start the monitor
00020Dr 1               @run_sub:
00020Dr 1  6C 24 00       jmp (XAML)        ; run at the last XAM address
000210r 1               @load:
000210r 1  20 rr rr       jsr load_ihex
000213r 1  4C rr rr       jmp WARMWOZ
000216r 1               @save:
000216r 1  20 rr rr       jsr save_ihex
000219r 1  4C rr rr       jmp WARMWOZ
00021Cr 1               @basic:
00021Cr 1                 ; BASIC resets the stack itself, so the return address of the JSR to cmd_dispatch can stay.
00021Cr 1  A5 E9          lda BASIC_STARTED ; has BASIC been started since reset?
00021Er 1  F0 03          beq @basic_cold   ; no, its variables are not set up, a warm start would crash
000220r 1  4C rr rr       jmp J_BASIC_WARM  ; yes, back to the READY prompt, program and variables kept
000223r 1               @basic_cold:
000223r 1  4C rr rr       jmp J_BASIC_COLD  ; first time, start BASIC
000226r 1               
000226r 1               ; ### Intel HEX Load/Save ###
000226r 1               
000226r 1               ; load_ihex:
000226r 1               ; Receive an Intel HEX stream from the serial port and store it in memory.
000226r 1               ; Each data record (type 00) is written at the 16-bit address carried in the
000226r 1               ; record itself, so no manual deposit address is needed. A record checksum is
000226r 1               ; verified; on mismatch the load aborts with an error message. An EOF record
000226r 1               ; (type 01) ends the load with "OK".
000226r 1               ; Record: ':' LL AAAA TT <data...> CC   (all hex ASCII)
000226r 1               ; Uses IHEX_* zero page scratch. Overwrites A, X, Y.
000226r 1               load_ihex:
000226r 1                 ; prompt
000226r 1  A9 rr          lda #<loadMsg
000228r 1  85 E7          sta PTR_TX
00022Ar 1  A9 rr          lda #>loadMsg
00022Cr 1  85 E8          sta PTR_TX_H
00022Er 1  20 rr rr       jsr serial_out_str
000231r 1               @next_record:
000231r 1  20 rr rr       jsr serial_in_raw     ; wait for start-of-record
000234r 1  C9 3A          cmp #':'
000236r 1  D0 F9          bne @next_record      ; ignore anything until a ':' (CR/LF between records)
000238r 1  64 34          stz IHEX_SUM          ; reset running checksum (65C02 stz)
00023Ar 1  20 rr rr       jsr get_hex_byte      ; LL  byte count
00023Dr 1  85 32          sta IHEX_LEN
00023Fr 1  20 rr rr       jsr get_hex_byte      ; AAAA high byte of address
000242r 1  85 31          sta IHEX_ADDR_H
000244r 1  20 rr rr       jsr get_hex_byte      ; AAAA low byte of address
000247r 1  85 30          sta IHEX_ADDR_L
000249r 1  20 rr rr       jsr get_hex_byte      ; TT  record type
00024Cr 1  85 33          sta IHEX_TYPE
00024Er 1                 ; data bytes. Only type 00 records are written to memory; any other record
00024Er 1                 ; type (e.g. 04 extended linear address) is still read so its checksum is
00024Er 1                 ; validated, but the bytes are discarded.
00024Er 1  A0 00          ldy #0
000250r 1               @data_loop:
000250r 1  C4 32          cpy IHEX_LEN
000252r 1  F0 0C          beq @read_checksum
000254r 1  20 rr rr       jsr get_hex_byte      ; one data byte (also folds into IHEX_SUM)
000257r 1  A6 33          ldx IHEX_TYPE         ; store only for data records (type 00)
000259r 1  D0 02          bne @skip_store
00025Br 1  91 30          sta (IHEX_ADDR),y     ; store at record address + index
00025Dr 1               @skip_store:
00025Dr 1  C8             iny
00025Er 1  80 F0          bra @data_loop
000260r 1               @read_checksum:
000260r 1  20 rr rr       jsr get_hex_byte      ; CC  record checksum byte
000263r 1                 ; At this point IHEX_SUM = (sum of all record bytes incl checksum) & $FF.
000263r 1                 ; A valid record makes that total zero.
000263r 1  A5 34          lda IHEX_SUM
000265r 1  D0 14          bne @bad_checksum
000267r 1                 ; record good - was it the EOF record?
000267r 1  A5 33          lda IHEX_TYPE
000269r 1  C9 01          cmp #$01
00026Br 1  F0 02          beq @done
00026Dr 1  80 C2          bra @next_record
00026Fr 1               @done:
00026Fr 1  A9 rr          lda #<okMsg
000271r 1  85 E7          sta PTR_TX
000273r 1  A9 rr          lda #>okMsg
000275r 1  85 E8          sta PTR_TX_H
000277r 1  20 rr rr       jsr serial_out_str
00027Ar 1  60             rts
00027Br 1               @bad_checksum:
00027Br 1  A9 rr          lda #<errMsg
00027Dr 1  85 E7          sta PTR_TX
00027Fr 1  A9 rr          lda #>errMsg
000281r 1  85 E8          sta PTR_TX_H
000283r 1  20 rr rr       jsr serial_out_str
000286r 1  60             rts
000287r 1               
000287r 1               ; save_ihex:
000287r 1               ; Emit memory as an Intel HEX stream over the serial port.
000287r 1               ; Range comes from WozMon's parsed block syntax: type "START.END" then "S".
000287r 1               ;   XAML/XAMH = start address, L/H = end address (inclusive).
000287r 1               ; Writes 16-byte type 00 data records followed by a type 01 EOF record.
000287r 1               ; Uses IHEX_* zero page scratch. Overwrites A, X, Y.
000287r 1               save_ihex:
000287r 1                 ; WozMon's block-XAM ("START.END") leaves the start address in STL/STH and
000287r 1                 ; the end address in L/H, but it advances XAML/XAMH to the end while dumping.
000287r 1                 ; Re-seed our working pointer (XAML/XAMH) from STL/STH so we start at START.
000287r 1  A5 26          lda STL
000289r 1  85 24          sta XAML
00028Br 1  A5 27          lda STH
00028Dr 1  85 25          sta XAMH
00028Fr 1  20 rr rr       jsr out_crlf
000292r 1               @line:
000292r 1                 ; bytes remaining = end - start ; stop once start > end
000292r 1  A5 25          lda XAMH
000294r 1  C5 29          cmp H
000296r 1  90 0C          bcc @emit_line        ; start high < end high -> more to do
000298r 1  D0 4E          bne @eof              ; start high > end high -> done
00029Ar 1  A5 24          lda XAML
00029Cr 1  C5 28          cmp L
00029Er 1  F0 04          beq @emit_line        ; equal: still one byte to emit this pass
0002A0r 1  90 02          bcc @emit_line        ; start low < end low -> more to do
0002A2r 1  80 44          bra @eof              ; start > end -> done
0002A4r 1               @emit_line:
0002A4r 1                 ; decide this record's length: min(16, end-start+1)
0002A4r 1                 ; compute remaining low estimate; simplest robust approach: emit up to 16
0002A4r 1                 ; bytes but stop at end address inside the loop.
0002A4r 1  64 34          stz IHEX_SUM
0002A6r 1  A9 3A          lda #':'
0002A8r 1  20 rr rr       jsr serial_out
0002ABr 1                 ; byte count placeholder handling: we count as we go, so first figure length
0002ABr 1  20 rr rr       jsr @calc_len         ; -> IHEX_LEN (1..16)
0002AEr 1  A5 32          lda IHEX_LEN
0002B0r 1  20 rr rr       jsr put_hex_byte      ; LL
0002B3r 1  A5 25          lda XAMH
0002B5r 1  20 rr rr       jsr put_hex_byte      ; AAAA hi
0002B8r 1  A5 24          lda XAML
0002BAr 1  20 rr rr       jsr put_hex_byte      ; AAAA lo
0002BDr 1  A9 00          lda #$00
0002BFr 1  20 rr rr       jsr put_hex_byte      ; TT = 00 data
0002C2r 1  A0 00          ldy #0
0002C4r 1               @save_data:
0002C4r 1  C4 32          cpy IHEX_LEN
0002C6r 1  F0 08          beq @save_cksum
0002C8r 1  B1 24          lda (XAML),y
0002CAr 1  20 rr rr       jsr put_hex_byte
0002CDr 1  C8             iny
0002CEr 1  80 F4          bra @save_data
0002D0r 1               @save_cksum:
0002D0r 1                 ; checksum = two's complement of sum so far
0002D0r 1  A5 34          lda IHEX_SUM
0002D2r 1  49 FF          eor #$FF
0002D4r 1  1A             inc
0002D5r 1  20 rr rr       jsr put_hex_byte
0002D8r 1  20 rr rr       jsr out_crlf
0002DBr 1                 ; advance start by IHEX_LEN
0002DBr 1  A5 24          lda XAML
0002DDr 1  18             clc
0002DEr 1  65 32          adc IHEX_LEN
0002E0r 1  85 24          sta XAML
0002E2r 1  90 AE          bcc @line
0002E4r 1  E6 25          inc XAMH
0002E6r 1  80 AA          bra @line
0002E8r 1               @eof:
0002E8r 1                 ; EOF record :00000001FF
0002E8r 1  A9 rr          lda #<eofRec
0002EAr 1  85 E7          sta PTR_TX
0002ECr 1  A9 rr          lda #>eofRec
0002EEr 1  85 E8          sta PTR_TX_H
0002F0r 1  20 rr rr       jsr serial_out_str
0002F3r 1  60             rts
0002F4r 1               ; @calc_len: how many bytes to emit this record (1..16), bounded by end addr
0002F4r 1               @calc_len:
0002F4r 1                 ; remaining = end - start (16-bit). If remaining+1 >= 16 use 16 else remaining+1
0002F4r 1                 ; compute end - start
0002F4r 1  A5 28          lda L
0002F6r 1  38             sec
0002F7r 1  E5 24          sbc XAML
0002F9r 1  85 35          sta IHEX_TMP          ; low of (end-start)
0002FBr 1  A5 29          lda H
0002FDr 1  E5 25          sbc XAMH              ; high of (end-start)
0002FFr 1  D0 06          bne @full             ; high byte nonzero -> at least 256 left, use 16
000301r 1  A5 35          lda IHEX_TMP
000303r 1  C9 0F          cmp #15               ; remaining low >= 15 ? (remaining+1 >= 16)
000305r 1  90 05          bcc @partial
000307r 1               @full:
000307r 1  A9 10          lda #16
000309r 1  85 32          sta IHEX_LEN
00030Br 1  60             rts
00030Cr 1               @partial:
00030Cr 1  A5 35          lda IHEX_TMP          ; remaining (end-start), bytes left-1
00030Er 1  1A             inc                   ; +1 to make it inclusive count
00030Fr 1  85 32          sta IHEX_LEN
000311r 1  60             rts
000312r 1               
000312r 1               ; ### Hex & ASCII Helpers ###
000312r 1               
000312r 1               ; get_hex_byte:
000312r 1               ; Read two ASCII hex characters from serial (raw, no echo) and return the
000312r 1               ; assembled byte in A. The byte is also added into IHEX_SUM for checksum
000312r 1               ; verification. Overwrites A; preserves X, Y.
000312r 1               get_hex_byte:
000312r 1  DA             phx
000313r 1  20 rr rr       jsr serial_in_raw     ; high nibble char
000316r 1  20 rr rr       jsr ascii_to_nib
000319r 1  0A             asl
00031Ar 1  0A             asl
00031Br 1  0A             asl
00031Cr 1  0A             asl
00031Dr 1  85 35          sta IHEX_TMP          ; high nibble in place
00031Fr 1  20 rr rr       jsr serial_in_raw     ; low nibble char
000322r 1  20 rr rr       jsr ascii_to_nib
000325r 1  05 35          ora IHEX_TMP          ; combine nibbles
000327r 1  AA             tax                   ; keep byte in X
000328r 1  18             clc
000329r 1  65 34          adc IHEX_SUM          ; fold into running checksum
00032Br 1  85 34          sta IHEX_SUM
00032Dr 1  8A             txa                   ; return byte in A
00032Er 1  FA             plx
00032Fr 1  60             rts
000330r 1               
000330r 1               ; ascii_to_nib:
000330r 1               ; Convert ASCII hex char in A ('0'-'9','A'-'F','a'-'f') to nibble value 0-15.
000330r 1               ; No validation - assumes well-formed input. Overwrites A.
000330r 1               ascii_to_nib:
000330r 1  C9 3A          cmp #'9'+1
000332r 1  90 04          bcc @digit            ; '0'-'9'
000334r 1  29 DF          and #$DF              ; fold lower to upper case
000336r 1  E9 07          sbc #$07              ; 'A'(after carry) maps to 10 ; carry set from cmp path
000338r 1               @digit:
000338r 1  29 0F          and #$0F
00033Ar 1  60             rts
00033Br 1               
00033Br 1               ; put_hex_byte:
00033Br 1               ; Transmit the byte in A as two ASCII hex chars and fold it into IHEX_SUM.
00033Br 1               ; Overwrites A; preserves X, Y.
00033Br 1               put_hex_byte:
00033Br 1  48             pha
00033Cr 1  18             clc
00033Dr 1  65 34          adc IHEX_SUM          ; checksum tracks raw byte value
00033Fr 1  85 34          sta IHEX_SUM
000341r 1  68             pla
000342r 1  20 rr rr       jsr serial_out_hex    ; reuse BIOS hex printer
000345r 1  60             rts
000346r 1               
000346r 1               ; ### LOAD / SAVE for BASIC  ###
000346r 1               
000346r 1               ; bios_load, bios_save: (stubs)
000346r 1               ; The BASIC LOAD and SAVE statements call these through the jump table
000346r 1               ; (BIOS_LOAD, BIOS_SAVE). They are STUBS for now: they return without doing
000346r 1               ; anything. They are meant for the SD card routines. What they take (file name
000346r 1               ; and so on) is not defined yet, it will be documented here when they are written.
000346r 1               ; They are not the monitor's L and S commands (load_ihex and save_ihex).
000346r 1               bios_load:
000346r 1  60             rts
000347r 1               bios_save:
000347r 1  60             rts
000348r 1               
000348r 1               
000348r 1               ; ### ROM Data ###
000348r 1               
000348r 1               ; Startup Messages
000348r 1               startupMessage:
000348r 1  0C 0D 0A 23    .byte	$0C,CR,LF,"## Simple6502 ##",CR,LF,"BIOS v"
00034Cr 1  23 20 53 69  
000350r 1  6D 70 6C 65  
000363r 1  30 2E 31 31    .byte VERSION
000367r 1  2E 30        
000369r 1                 ;.byte	$0D,$0A,"OK"
000369r 1  0D 0A          .byte CR,LF
00036Br 1  00             .byte $00
00036Cr 1               wozmonMessage:
00036Cr 1  0D 0A 3E 20    .byte	CR,LF,"> WozMon <"
000370r 1  57 6F 7A 4D  
000374r 1  6F 6E 20 3C  
000378r 1  0D 0A 00       .byte CR,LF,$00
00037Br 1               viaMessage:
00037Br 1  23 23 20 56    .byte "## VIA1 on $7F20"
00037Fr 1  49 41 31 20  
000383r 1  6F 6E 20 24  
00038Br 1  0D 0A 00       .byte CR,LF,$00
00038Er 1               ; Intel HEX loader/saver messages
00038Er 1               loadMsg:
00038Er 1  0D 0A 50 61    .byte CR,LF,"Paste Intel HEX..",CR,LF,$00
000392r 1  73 74 65 20  
000396r 1  49 6E 74 65  
0003A4r 1               okMsg:
0003A4r 1  0D 0A 4F 4B    .byte CR,LF,"OK",CR,LF,$00
0003A8r 1  0D 0A 00     
0003ABr 1               errMsg:
0003ABr 1  0D 0A 43 4B    .byte CR,LF,"CKSUM ERR",CR,LF,$00
0003AFr 1  53 55 4D 20  
0003B3r 1  45 52 52 0D  
0003B9r 1               eofRec:
0003B9r 1  3A 30 30 30    .byte ":00000001FF",CR,LF,$00
0003BDr 1  30 30 30 30  
0003C1r 1  31 46 46 0D  
0003C7r 1               
0003C7r 1               ; ### Interrupt Handlers ###
0003C7r 1               
0003C7r 1               ; # IRQ Handler
0003C7r 1               ; Services VIA1 Timer 1 (the ~10ms tick) by incrementing the 3-byte TOCKS
0003C7r 1               ; jiffy counter. Other sources (ACIA RX, etc.) can be added here later;
0003C7r 1               ; unrecognised IRQs simply return.
0003C7r 1               ; A, X and Y are saved on entry and restored before the RTI, whatever the handler
0003C7r 1               ; does, so any source added here can use all three registers. (The flags are
0003C7r 1               ; restored by the RTI itself.)
0003C7r 1               irq_handler:
0003C7r 1  48               pha                   ; save A, X and Y, in this order
0003C8r 1  DA               phx
0003C9r 1  5A               phy
0003CAr 1                   ; Was it VIA1 Timer 1? Check IFR bit 6. (If the VIA is absent this reads
0003CAr 1                   ; open bus, but then it is not an IRQ source so the board won't assert IRQ.)
0003CAr 1  AD 2D 7F         lda VIA1_IFR
0003CDr 1  29 40            and #VIA_IFR_T1
0003CFr 1  F0 0D            beq @not_t1           ; not Timer 1 -> nothing we handle
0003D1r 1                   ; Clear the Timer 1 interrupt flag by reading T1C-L.
0003D1r 1  AD 24 7F         lda VIA1_T1CL
0003D4r 1                   ; Increment the 24-bit TOCKS counter (little-endian).
0003D4r 1  E6 E0            inc TOCKS_L
0003D6r 1  D0 06            bne @done
0003D8r 1  E6 E1            inc TOCKS_M
0003DAr 1  D0 02            bne @done
0003DCr 1  E6 E2            inc TOCKS_H
0003DEr 1               @done:
0003DEr 1               @not_t1:
0003DEr 1  7A               ply                   ; restore Y, X and A, in the reverse order
0003DFr 1  FA               plx
0003E0r 1  68               pla
0003E1r 1  40               rti         ; 40
0003E2r 1               
0003E2r 1               ; # NMI Handler Vector
0003E2r 1               nmi_handler:
0003E2r 1  EA               nop       ; EA
0003E3r 1  40               rti       ; 40
0003E4r 1               
0003E4r 1               ; -- MONITOR --
0003E4r 1               ; ## WozMon ##
0003E4r 1               
0003E4r 1               WOZMON_COLD:    ; Need to move this to a WozMon COLD_Start of sorts
0003E4r 1               ; Print woz message
0003E4r 1  A9 rr        lda #<wozmonMessage
0003E6r 1  85 E7        sta PTR_TX
0003E8r 1  A9 rr        lda #>wozmonMessage
0003EAr 1  85 E8        sta PTR_TX_H
0003ECr 1  20 rr rr     jsr serial_out_str
0003EFr 1  4C rr rr     jmp WOZMON      ; go to the monitor (without this it runs into the empty ROM after the BIOS)
0003F2r 1               ; .segment "WOZMON"   ; .org $FF00
0003F2r 1               .include "wozmon_sbc.s"
0003F2r 2               ;  The WOZ Monitor for the Apple 1
0003F2r 2               ;  Written by Steve Wozniak in 1976
0003F2r 2               ;  Adapted to the simple6502 SBC with MC68B50 ACIA by Mariano Luna
0003F2r 2               ;
0003F2r 2               ; Changelog:
0003F2r 2               ; - 5 bytes less
0003F2r 2               ; - updated to use BIOS routines for Serial int and some I/O
0003F2r 2               ; - moved Variables to defines_[platform].s
0003F2r 2               ; - updates to use standard ASCII (not Apple 1 bit 7 set)
0003F2r 2               ; - input now case insensitive
0003F2r 2               ; -
0003F2r 2               
0003F2r 2               ; TEST PROGRAM
0003F2r 2               ; 0400: A9 20 20 77 80 18 69 01 C9 7F 30 F6 4C 00 04
0003F2r 2               ;
0003F2r 2               ;                            * = $0400
0003F2r 2               ; 0400   A9 20      L0400     LDA #$20
0003F2r 2               ; 0402   20 77 80   L0402     JSR $8077
0003F2r 2               ; 0405   18                   CLC
0003F2r 2               ; 0406   69 01                ADC #$01
0003F2r 2               ; 0408   C9 7F                CMP #$7F
0003F2r 2               ; 040A   30 F6                BMI L0402
0003F2r 2               ; 040C   4C 00 04             JMP L0400
0003F2r 2               ;                             .END
0003F2r 2               ; Page 0 Variables (XAML..MODE) are declared in zeropage.s so that
0003F2r 2               ; the BIOS Intel HEX routines can share them as zero page.
0003F2r 2               
0003F2r 2               ; Other Variables
0003F2r 2               
0003F2r 2               IN              = $0200         ;  Input buffer is 128 bytes, $0200–$027F,
0003F2r 2               
0003F2r 2               .segment "WOZMON"
000000r 2               WOZMON:
000000r 2                               ; Run out of mem so assuming serial is initialized by BIOS
000000r 2                               ; with only one of this JSRs 'WOZMON' overflows the
000000r 2                               ; 'MONITOR' segment memory area by 1 byte
000000r 2                               ; if you are running this independently of the bios you
000000r 2                               ; will need to uncomment the next line or 2 lines if you fancy a CR + LF
000000r 2                               ; JSR     serial_init    ; Initialize ACIA
000000r 2                               ; JSR     out_crlf       ; send CR+LF
000000r 2  A9 1B        WARMWOZ:        LDA     #$1B           ; Begin with escape.
000002r 2               NOTCR:
000002r 2  C9 08                        CMP     #$08           ; Backspace key? * Changed to the actual BS key
000004r 2  F0 11                        BEQ     BACKSPACE      ; Yes.
000006r 2  C9 1B                        CMP     #$1B           ; ESC?
000008r 2  F0 03                        BEQ     ESCAPE         ; Yes.
00000Ar 2  C8                           INY                    ; Advance text index.
00000Br 2  10 0D                        BPL     NEXTCHAR       ; Auto ESC if line longer than 127.
00000Dr 2               ESCAPE:
00000Dr 2  A9 5C                        LDA     #$5C           ; "\".
00000Fr 2  20 rr rr                     JSR     ECHO           ; Output it.
000012r 2               GETLINE:
000012r 2  20 rr rr                     JSR     out_crlf       ; * Send CR+LF
000015r 2  A0 01                        LDY     #$01           ; Initialize text index.
000017r 2  88           BACKSPACE:      DEY                    ; Back up text index.
000018r 2  30 F8                        BMI     GETLINE        ; Beyond start of line, reinitialize.
00001Ar 2               NEXTCHAR:
00001Ar 2  AD 72 7F                     LDA     ACIA_STATUS    ; Check ACIA status.
00001Dr 2  29 01                        AND     #ACIA_RDRF     ; Key ready?
00001Fr 2  F0 F9                        BEQ     NEXTCHAR       ; Loop until ready.
000021r 2  AD 73 7F                     LDA     ACIA_DATA      ; Load character. B7 will be '0'.
000024r 2  C9 60                        CMP     #$60           ;* Lower case?
000026r 2  30 02                        BMI     GO_ON          ;* Nope, go on
000028r 2  29 5F                        AND     #$5F           ;* convert to Upper case ASCII
00002Ar 2  99 00 02     GO_ON:          STA     IN,Y           ; Add to text buffer.
00002Dr 2  20 rr rr                     JSR     ECHO           ; Display character.
000030r 2  C9 0D                        CMP     #$0D           ; CR?
000032r 2  D0 CE                        BNE     NOTCR          ; No.
000034r 2  A0 FF                        LDY     #$FF           ; Reset text index.
000036r 2  A9 00                        LDA     #$00           ; For XAM mode.
000038r 2  AA                           TAX                    ; 0->X.
000039r 2               SETBLOCK:
000039r 2  0A                           ASL
00003Ar 2               SETSTOR:
00003Ar 2  0A                           ASL                    ; Leaves $7B if setting STOR mode.
00003Br 2  85 2B                        STA     MODE           ; $00 = XAM, $74 = STOR, $B8 = BLOCK XAM.
00003Dr 2               BLSKIP:
00003Dr 2  C8                           INY                    ; Advance text index.
00003Er 2               NEXTITEM:
00003Er 2  B9 00 02                     LDA     IN,Y           ; Get character.
000041r 2  C9 0D                        CMP     #$0D           ; CR?
000043r 2  F0 CD                        BEQ     GETLINE        ; Yes, done this line.
000045r 2  C9 2E                        CMP     #$2E           ; "."?
000047r 2  90 F4                        BCC     BLSKIP         ; Skip delimiter.
000049r 2  F0 EE                        BEQ     SETBLOCK       ; Set BLOCK XAM mode.
00004Br 2  C9 3A                        CMP     #$3A           ; ":"?
00004Dr 2  F0 EB                        BEQ     SETSTOR        ; Yes, set STOR mode.
00004Fr 2  20 rr rr                     JSR     cmd_dispatch   ;* Handle R/L/S letter commands in BIOS.
000052r 2                                                      ;* Returns (A,X preserved) if not a command.
000052r 2  86 28                        STX     L              ; $00 -> L. * Woz is relying on X being zero
000054r 2  86 29                        STX     H              ;    and H.
000056r 2  84 2A                        STY     YSAV           ; Save Y for comparison
000058r 2               NEXTHEX:
000058r 2  B9 00 02                     LDA     IN,Y           ; Get character for hex test.
00005Br 2  49 30                        EOR     #$30           ; Map digits to $0-9.
00005Dr 2  C9 0A                        CMP     #$0A           ; Digit?
00005Fr 2  90 06                        BCC     DIG            ; Yes.
000061r 2  69 88                        ADC     #$88           ; Map letter "A"-"F" to $FA-FF.
000063r 2  C9 FA                        CMP     #$FA           ; Hex letter?
000065r 2  90 11                        BCC     NOTHEX         ; No, character not hex.
000067r 2               DIG:
000067r 2  0A                           ASL
000068r 2  0A                           ASL                    ; Hex digit to MSD of A.
000069r 2  0A                           ASL
00006Ar 2  0A                           ASL
00006Br 2  A2 04                        LDX     #$04           ; Shift count.
00006Dr 2               HEXSHIFT:
00006Dr 2  0A                           ASL                    ; Hex digit left, MSB to carry.
00006Er 2  26 28                        ROL     L              ; Rotate into LSD.
000070r 2  26 29                        ROL     H              ; Rotate into MSD's.
000072r 2  CA                           DEX                    ; Done 4 shifts?
000073r 2  D0 F8                        BNE     HEXSHIFT       ; No, loop.
000075r 2  C8                           INY                    ; Advance text index.
000076r 2  D0 E0                        BNE     NEXTHEX        ; Always taken. Check next character for hex.
000078r 2               NOTHEX:
000078r 2  C4 2A                        CPY     YSAV           ; Check if L, H empty (no hex digits).
00007Ar 2  F0 91                        BEQ     ESCAPE         ; Yes, generate ESC sequence.
00007Cr 2  24 2B                        BIT     MODE           ; Test MODE byte.
00007Er 2  50 0D                        BVC     NOTSTOR        ; B6=0 is STOR, 1 is XAM and BLOCK XAM.
000080r 2  A5 28                        LDA     L              ; LSD's of hex data.
000082r 2  81 26                        STA     (STL,X)        ; Store current 'store index'.
000084r 2  E6 26                        INC     STL            ; Increment store index.
000086r 2  D0 B6                        BNE     NEXTITEM       ; Get next item (no carry).
000088r 2  E6 27                        INC     STH            ; Add carry to 'store index' high order.
00008Ar 2  4C rr rr     TONEXTITEM:     JMP     NEXTITEM       ; Get next command item.
00008Dr 2               ; R (run), L (Intel HEX load) and S (Intel HEX save) commands are now
00008Dr 2               ; handled by cmd_dispatch in the BIOS segment. This frees WozMon space and
00008Dr 2               ; lets those routines be reused from other code. See BIOS.s.
00008Dr 2               NOTSTOR:
00008Dr 2  30 29                        BMI     XAMNEXT        ; B7 = 0 for XAM, 1 for BLOCK XAM.
00008Fr 2  A2 02                        LDX     #$02           ; Byte count.
000091r 2  B5 27        SETADR:         LDA     L-1,X          ; Copy hex data to
000093r 2  95 25                        STA     STL-1,X        ;  'store index'.
000095r 2  95 23                        STA     XAML-1,X       ; And to 'XAM index'.
000097r 2  CA                           DEX                    ; Next of 2 bytes.
000098r 2  D0 F7                        BNE     SETADR         ; Loop unless X = 0.
00009Ar 2               NXTPRNT:
00009Ar 2  D0 12                        BNE     PRDATA         ; NE means no address to print.
00009Cr 2  20 rr rr                     JSR     out_crlf       ; Send CR+LF
00009Fr 2  A5 25                        LDA     XAMH           ; 'Examine index' high-order byte.
0000A1r 2  20 rr rr                     JSR     PRBYTE         ; Output it in hex format.
0000A4r 2  A5 24                        LDA     XAML           ; Low-order 'examine index' byte.
0000A6r 2  20 rr rr                     JSR     PRBYTE         ; Output it in hex format.
0000A9r 2  A9 3A                        LDA     #$3A           ; ":".
0000ABr 2  20 rr rr                     JSR     ECHO           ; Output it.
0000AEr 2               PRDATA:
0000AEr 2  A9 20                        LDA     #$20           ; Blank.
0000B0r 2  20 rr rr                     JSR     ECHO           ; Output it.
0000B3r 2  A1 24                        LDA     (XAML,X)       ; Get data byte at 'examine index'.
0000B5r 2  20 rr rr                     JSR     PRBYTE         ; Output it in hex format.
0000B8r 2  86 2B        XAMNEXT:        STX     MODE           ; 0 -> MODE (XAM mode).
0000BAr 2  A5 24                        LDA     XAML
0000BCr 2  C5 28                        CMP     L              ; Compare 'examine index' to hex data.
0000BEr 2  A5 25                        LDA     XAMH
0000C0r 2  E5 29                        SBC     H
0000C2r 2  B0 C6                        BCS     TONEXTITEM     ; Not less, so no more data to output.
0000C4r 2  E6 24                        INC     XAML
0000C6r 2  D0 02                        BNE     MOD8CHK        ; Increment 'examine index'.
0000C8r 2  E6 25                        INC     XAMH
0000CAr 2               MOD8CHK:
0000CAr 2  A5 24                        LDA     XAML           ; Check low-order 'examine index' byte
0000CCr 2  29 0F                        AND     #$0F           ; * Changed to display 16 bytes per line AND #$07 ; For MOD 8 = 0  #%0000.0111
0000CEr 2  10 CA                        BPL     NXTPRNT        ; Always taken.
0000D0r 2               PRBYTE:
0000D0r 2  48                           PHA                    ; Save A for LSD.
0000D1r 2  4A                           LSR
0000D2r 2  4A                           LSR
0000D3r 2  4A                           LSR                    ; MSD to LSD position.
0000D4r 2  4A                           LSR
0000D5r 2  20 rr rr                     JSR     PRHEX          ; Output hex digit.
0000D8r 2  68                           PLA                    ; Restore A.
0000D9r 2               PRHEX:
0000D9r 2  29 0F                        AND     #$0F           ; Mask LSD for hex print.
0000DBr 2  09 30                        ORA     #$30           ; Add "0".
0000DDr 2  C9 3A                        CMP     #$3A           ; Digit?
0000DFr 2  90 02                        BCC     ECHO           ; Yes, output it.
0000E1r 2  69 06                        ADC     #$06           ; Add offset for letter.
0000E3r 2               ECHO:
0000E3r 2  48                           PHA                    ; Save A.
0000E4r 2  8D 73 7F                     STA     ACIA_DATA      ; Output character.
0000E7r 2  A9 FF                        LDA     #$FF           ; Initialize delay loop.
0000E9r 2  3A           TXDELAY:        DEC                    ; Decrement A.
0000EAr 2  D0 FD                        BNE     TXDELAY        ; Until A gets to 0.
0000ECr 2  68                           PLA                    ; Restore A.
0000EDr 2  60                           RTS                    ; Return.
0000EEr 2               
0000EEr 2               
0000EEr 2               
0000EEr 1               
0000EEr 1               ; -- VECTORS --
0000EEr 1               ;.org $fffa
0000EEr 1               .segment "RESETVECTORS"
000000r 1  rr rr          .word nmi_handler ; NMI
000002r 1  rr rr          .word reset       ; RESET
000004r 1  rr rr          .word irq_handler ; IRQ/BRK
000004r 1               
