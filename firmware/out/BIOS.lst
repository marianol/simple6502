000000r 1               ; simple6502 BIOS ROM
000000r 1               ; Written by Mariano Luna, 2024
000000r 1               ; License: BSD-3-Clause
000000r 1               ; https://opensource.org/license/bsd-3-clause
000000r 1               
000000r 1               .setcpu "65C02"           ; Thats what we got
000000r 1               .debuginfo +
000000r 1               
000000r 1               .define VERSION "0.6.1"   ; Define the version number
000000r 1               
000000r 1               .include "defines_simple6502.s" ; Include HW Constants and Labels
000000r 2               ; Herdware for the simple6502 SBC board
000000r 2               ;
000000r 2               ; This file has the common labels, variables and costants that define the
000000r 2               ; herdware of my simple6502 SBC https://github.com/marianol/simple6502/
000000r 2               ; is ment to be included in source files and keep hardware related data
000000r 2               ; separated from the main assembly code.
000000r 2               
000000r 2               ; simple6502 SBC
000000r 2               ; Memory Map Address Space
000000r 2               ; 0x0000 - 0x7EFF : RAM 32K - 256 bytes (31.75K)
000000r 2               ; 0x7F00 - 0x7FFF : I/O 256 bytes decoded to 8 IO lines
000000r 2               ; 0x8000 - 0xFFFF : ROM 32K
000000r 2               ; Clock is @1.8432MHz so 0.542534722us per cycle
000000r 2               
000000r 2               ; I/O Space
000000r 2               IO_1    = $7F00 ; Slot #1 0x7F00 - 0x7F0F
000000r 2               IO_2    = $7F10 ; Slot #2 0x7F10 - 0x7F1F
000000r 2               IO_3    = $7F20 ; VIA #1  0x7F20 - 0x7F2F
000000r 2               IO_4    = $7F30 ; Available 0x7F30 - 0x7F3F
000000r 2               IO_5    = $7F40 ; Available 0x7F40 - 0x7F4F
000000r 2               IO_6    = $7F50 ; Available 0x7F50 - 0x7F5F
000000r 2               IO_7    = $7F60 ; Available 0x7F60 - 0x7F6F
000000r 2               IO_8    = $7F70 ; MC68B50 ACIA  0x7F70 - 0x7F7F
000000r 2               ;  0x7F80 - 0x7FFF : This section is not decoded 127 bytes
000000r 2               
000000r 2               ; -----------
000000r 2               ; ACIA MC68B50
000000r 2               ; The simple6502 has an serial interface on board at IO_8
000000r 2               ; the ACIA is driven by the main clock (CLK) @ 1.8432Mhz
000000r 2               ; RS is tied to A0 and CS0 is tied to A1
000000r 2               ; The 68B50 Control register is as follows:
000000r 2               ; - Bit 0-1: Config clock Divider & Reset > 00: ÷1, 01: ÷16, 10: ÷64, 11: Master reset
000000r 2               ; - Bit 2-4: Config bit length, parity & stop >
000000r 2               ; - Bit 5-6: TX control bits
000000r 2               ;               > 00: RTSB low, TDRE IRQ disabled
000000r 2               ;               > 01: RTSB low, TDRE IRQ enabled
000000r 2               ;               > 10: RTSB high, TDRE IRQ disabled
000000r 2               ;               > 11: RTSB low, transmits brake level, TDRE disabled
000000r 2               ; - Bit 7: RX IRQ 0 Disabled / 1 Enabled
000000r 2               
000000r 2               ACIA_BASE     = IO_8
000000r 2               ACIA_STATUS   = ACIA_BASE + 2   ; Read RS 0 + R
000000r 2               ACIA_CONTROL  = ACIA_BASE + 2   ; Write RS 0 + W
000000r 2               ACIA_DATA     = ACIA_BASE + 3   ; RS 1 + R/W > RX/TX
000000r 2               
000000r 2               ; ACIA Preset Configurations
000000r 2               ; This are intended to simplify config of the CTRL register
000000r 2               ACIA_CFG_115    = %00010101    ; 8-N-1, 115200bps, no IRQ - /16 CLK
000000r 2               ACIA_CFG_115I   = %10010101    ; 8-N-1, 115200bps, IRQ - /16 CLK
000000r 2               ACIA_CFG_28     = %00010110    ; 8-N-1, 28800bps, no IRQ - /64 CLK
000000r 2               ACIA_CFG_28I    = %10010110    ; 8-N-1, 28800bps, IRQ - /64 CLK
000000r 2               
000000r 2               ; ACIA Helper Constants
000000r 2               ACIA_TDRE       = %00000010    ; bitmask for TRDE
000000r 2               ACIA_RDRF       = %00000001    ; bitmask for RDRF
000000r 2               ACIA_RESET      = %00000011    ; 6850 reset
000000r 2               
000000r 2               ; 6522 VIA
000000r 2               ; The VIA is not onboard in Rev 1.6 PCB
000000r 2               ; but reserving this I/O for the main VIA
000000r 2               ;
000000r 2               ; VIA Interrupt Flag Register (IFR) Reference
000000r 2               ; BIT   |  0  |  1  |  2       |  3  |  4  |   5    |   6    |  7  |
000000r 2               ; Desc  | CA2 | CA1 | Shift    | CB2 | CB1 | Timer2 | Timer2 | IRQ |
000000r 2               ;                     Register
000000r 2               VIA1_BASE   = IO_3
000000r 2               VIA1_PORTB  = VIA1_BASE         ; $7F20
000000r 2               VIA1_PORTA  = VIA1_BASE + 1     ; $7F21
000000r 2               VIA1_DDRB   = VIA1_BASE + 2     ; $7F22
000000r 2               VIA1_DDRA   = VIA1_BASE + 3     ; $7F23
000000r 2               VIA1_T1CL   = VIA1_BASE + 4     ; $7F24 T1C-L Timer 1 Counter (low byte)
000000r 2               VIA1_T1CH   = VIA1_BASE + 5     ; $7F25 T1C-H Timer 1 Counter (high byte)
000000r 2               VIA1_T1L    = VIA1_BASE + 6     ; $7F26 T1L-L
000000r 2               VIA1_T1H    = VIA1_BASE + 7     ; $7F27 T1L-H
000000r 2               VIA1_T2CL   = VIA1_BASE + 8     ; $7F28 T2C-L
000000r 2               VIA1_T2CH   = VIA1_BASE + 9     ; $7F29 T2C-H
000000r 2               VIA1_SR     = VIA1_BASE + 10    ; $7F2A SR Shift Register
000000r 2               VIA1_ACR    = VIA1_BASE + 11    ; $7F2B Auxiliary Control register @
000000r 2               VIA1_PCR    = VIA1_BASE + 12    ; PCR Peripheral Control Register
000000r 2               VIA1_IFR    = VIA1_BASE + 13    ; $7F2D IFR > Interrupt Flag Register
000000r 2               VIA1_IER    = VIA1_BASE + 14    ; $7F2E ; Interrupt Enable Register
000000r 2               
000000r 2               
000000r 2               ; ### ZeroPage Variables ###
000000r 2               ZP_START        = $00
000000r 2               TOCKS           = $E0 ; Jiffy-like clock, 3 bytes ($E0-$E2), ~10ms per tick
000000r 2               TOCKS_L         = $E0 ; low byte
000000r 2               TOCKS_M         = $E1 ; mid byte
000000r 2               TOCKS_H         = $E2 ; high byte
000000r 2               RAM_SIZE        = $E3 ; RAM Size (top usable RAM address + 1), 2 bytes
000000r 2               RAM_SIZE_L      = $E3 ; RAM Size LO Byte
000000r 2               RAM_SIZE_H      = $E4 ; RAM Size HI Byte
000000r 2               PTR_RD_RX_BUF   = $E5 ; RX Read Buffer Pointer
000000r 2               PTR_WR_RX_BUF   = $E6 ; RX Write Buffer Pointer
000000r 2               PTR_TX          = $E7 ; Transmit String Pointer
000000r 2               PTR_TX_L        = $E7 ; LO Byte
000000r 2               PTR_TX_H        = $E8 ; HI Byte
000000r 2               POST_PTR        = $E9 ; POST RAM-walk pointer (2 bytes, $E9-$EA)
000000r 2               
000000r 2               ; Intel HEX load/save (BIOS) scratch
000000r 2               IHEX_ADDR       = $30 ; record load address (LO/HI)
000000r 2               IHEX_ADDR_L     = $30
000000r 2               IHEX_ADDR_H     = $31
000000r 2               IHEX_LEN        = $32 ; record byte count
000000r 2               IHEX_TYPE       = $33 ; record type (00 data, 01 EOF)
000000r 2               IHEX_SUM        = $34 ; running checksum accumulator
000000r 2               IHEX_TMP        = $35 ; general scratch
000000r 2               
000000r 2               ; used by Mon Print Registers
000000r 2               P_STATUS        = $40
000000r 2               PC_REG_H        = P_STATUS
000000r 2               PC_REG_L        = P_STATUS + 1
000000r 2               SP_REG          = P_STATUS + 2
000000r 2               A_REG           = P_STATUS + 3
000000r 2               X_REG           = P_STATUS + 4
000000r 2               Y_REG           = P_STATUS + 5
000000r 2               SR_REG          = P_STATUS + 6
000000r 2               
000000r 2               ; WozMon ZeroPage Variables
000000r 2               ; uses $24 to $2B. Defined here (included first) so BIOS routines that share
000000r 2               ; these locations with WozMon resolve them as zero page.
000000r 2               XAML            = $24           ;  Last "opened" location Low
000000r 2               XAMH            = $25           ;  Last "opened" location High
000000r 2               STL             = $26           ;  Store address Low
000000r 2               STH             = $27           ;  Store address High
000000r 2               L               = $28           ;  Hex value parsing Low
000000r 2               H               = $29           ;  Hex value parsing High
000000r 2               YSAV            = $2A           ;  Used to see if hex value is given
000000r 2               MODE            = $2B           ;  $00=XAM, $7F=STOR, $AE=BLOCK XAM
000000r 2               
000000r 2               
000000r 2               ; ### Useful Constants ###
000000r 2               ; ASCII
000000r 2               CR      = $0D
000000r 2               LF      = $0A
000000r 2               BS      = $08
000000r 2               DEL     = $7F
000000r 2               SPACE   = $20
000000r 2               ESC     = $1B
000000r 2               NULL    = $00
000000r 2               
000000r 1               
000000r 1               ; -- ROM START --
000000r 1               ;.org $8000
000000r 1               
000000r 1               ; ## BIOS Jump Table (public ABI) ##
000000r 1               ; Fixed-address entry points so external programs can call BIOS routines at
000000r 1               ; stable addresses that never change as the BIOS internals grow.
000000r 1               ;
000000r 1               ; The table lives at the very start of ROM ($8000) and each entry is a 3-byte
000000r 1               ; JMP. CONTRACT: entries are APPEND-ONLY. Never insert, reorder, or remove a
000000r 1               ; slot - that would shift every entry below it and break existing binaries.
000000r 1               ; Add new routines to the end only.
000000r 1               ;
000000r 1               ; Slot  Address  Routine
000000r 1               ; ----  -------  ----------------------------------------------------------
000000r 1               ;  0    $8000    J_COLD_START  - cold start / reset entry
000000r 1               ;  1    $8003    J_MONITOR     - enter WozMon monitor
000000r 1               ;  2    $8006    J_SERIAL_OUT  - transmit A over serial
000000r 1               ;  3    $8009    J_SERIAL_IN   - receive a byte (carry set if data)
000000r 1               ;  4    $800C    J_SERIAL_STR  - transmit null-terminated string @ PTR_TX
000000r 1               ;  5    $800F    J_SERIAL_HEX  - transmit A as two ASCII hex digits
000000r 1               ;  6    $8012    J_OUT_CRLF    - transmit CR+LF
000000r 1               ;  7    $8015    J_SERIAL_POLL - receive a byte, no echo (carry set if data)
000000r 1               ;
000000r 1               ; The equates for these addresses live in bios_jumptable.inc for programs to
000000r 1               ; include. Keep that file in sync when appending entries here.
000000r 1               .segment "HEADER"
000000r 1  4C rr rr     J_COLD_START: jmp reset          ; slot 0  $8000
000003r 1  4C rr rr     J_MONITOR:    jmp WOZMON         ; slot 1  $8003
000006r 1  4C rr rr     J_SERIAL_OUT: jmp serial_out     ; slot 2  $8006
000009r 1  4C rr rr     J_SERIAL_IN:  jmp serial_in      ; slot 3  $8009
00000Cr 1  4C rr rr     J_SERIAL_STR: jmp serial_out_str ; slot 4  $800C
00000Fr 1  4C rr rr     J_SERIAL_HEX: jmp serial_out_hex ; slot 5  $800F
000012r 1  4C rr rr     J_OUT_CRLF:   jmp out_crlf       ; slot 6  $8012
000015r 1  4C rr rr     J_SERIAL_POLL: jmp serial_poll   ; slot 7  $8015
000018r 1               
000018r 1               ; Keep MONITOR as an alias for existing code that referenced it.
000018r 1               MONITOR = J_MONITOR
000018r 1               
000018r 1               ; ## BIOS Start ##
000018r 1               .segment "BIOS"
000000r 1  73 69 6D 70    .byte "simple6502 BIOS Ver: "
000004r 1  6C 65 36 35  
000008r 1  30 32 20 42  
000015r 1  30 2E 36 2E    .byte VERSION
000019r 1  31           
00001Ar 1               
00001Ar 1               ; Reset Vector Start
00001Ar 1               reset:
00001Ar 1  78             sei               ; 78      disable interrupts
00001Br 1  D8             cld               ; D8      turn decimal mode off
00001Cr 1               
00001Cr 1                 ; --- Early memory POST: Zero Page and Stack (Page 1) ---
00001Cr 1                 ; These run BEFORE the stack is used (no JSR yet) so we can test Page 1
00001Cr 1                 ; without clobbering a live return address. We use ONLY the A and X
00001Cr 1                 ; registers and immediate values - no ZP variables, no stack. A mismatch
00001Cr 1                 ; jumps to post_fail (which signals on the data bus since serial is down).
00001Cr 1               
00001Cr 1                 ; Test Zero Page ($0000-$00FF): checkerboard $55 then $AA
00001Cr 1  A2 00          ldx #0
00001Er 1               @zp_55:
00001Er 1  A9 55          lda #$55
000020r 1  95 00          sta $00,x
000022r 1  D5 00          cmp $00,x
000024r 1  D0 4C          bne post_fail
000026r 1  E8             inx
000027r 1  D0 F5          bne @zp_55
000029r 1               @zp_aa:
000029r 1  A9 AA          lda #$AA
00002Br 1  95 00          sta $00,x         ; x wrapped back to 0
00002Dr 1  D5 00          cmp $00,x
00002Fr 1  D0 41          bne post_fail
000031r 1  E8             inx
000032r 1  D0 F5          bne @zp_aa
000034r 1               
000034r 1                 ; Test Stack page / Page 1 ($0100-$01FF): safe to clobber, nothing pushed yet
000034r 1  A2 00          ldx #0
000036r 1               @sp_55:
000036r 1  A9 55          lda #$55
000038r 1  9D 00 01       sta $0100,x
00003Br 1  DD 00 01       cmp $0100,x
00003Er 1  D0 32          bne post_fail
000040r 1  E8             inx
000041r 1  D0 F3          bne @sp_55
000043r 1               @sp_aa:
000043r 1  A9 AA          lda #$AA
000045r 1  9D 00 01       sta $0100,x       ; x wrapped back to 0
000048r 1  DD 00 01       cmp $0100,x
00004Br 1  D0 25          bne post_fail
00004Dr 1  E8             inx
00004Er 1  D0 F3          bne @sp_aa
000050r 1               
000050r 1                 ; ZP and stack are good - establish the stack pointer and carry on.
000050r 1  A2 FF          ldx #$FF          ; A2 FF
000052r 1  9A             txs               ; 9A      set the stack start
000053r 1  20 rr rr       jsr post          ; do the rest of POST (RAM walk)
000056r 1  20 rr rr       jsr init_serial   ; init ACIA # IO_8
000059r 1                 ; Print startup message
000059r 1  A9 rr          lda #<startupMessage
00005Br 1  85 E7          sta PTR_TX
00005Dr 1  A9 rr          lda #>startupMessage
00005Fr 1  85 E8          sta PTR_TX_H
000061r 1  20 rr rr       jsr serial_out_str
000064r 1                ; Print woz message
000064r 1  A9 rr          lda #<wozmonMessage
000066r 1  85 E7          sta PTR_TX
000068r 1  A9 rr          lda #>wozmonMessage
00006Ar 1  85 E8          sta PTR_TX_H
00006Cr 1  20 rr rr       jsr serial_out_str
00006Fr 1  4C rr rr       jmp WOZMON        ; go to the monitor
000072r 1               
000072r 1               
000072r 1               
000072r 1               ; ### Subrutines ###
000072r 1               
000072r 1               ; post_fail:
000072r 1               ; Reached when the early ZP or Stack test fails. Serial is NOT up yet and we
000072r 1               ; have no onboard failure indicator (LED/beeper) in rev 1.6 - that hardware is
000072r 1               ; TODO. As a placeholder, we signal the fault on the DATA BUS: repeatedly
000072r 1               ; writing $01 then $00 to a Zero Page location drives D0 with a steady ~1 kHz
000072r 1               ; pattern (D1-D7 idle low) that can be caught with a scope or logic probe.
000072r 1               ; This never returns - a failed ZP/stack test is terminal.
000072r 1               ; Placed right before the POST tests so the reset-vector ZP/stack checks can
000072r 1               ; reach it with a direct conditional branch (no trampoline needed).
000072r 1               ;
000072r 1               ; Timing: target ~1 kHz (1 ms period, 500 us per half) at 1.8432 MHz
000072r 1               ; (~922 cycles per half-period). Each half is a write (~5 cyc) plus the
000072r 1               ; delay loop dex/bne (5 cyc per iteration): X=$B6 (182) -> ~910 loop cycles
000072r 1               ; + overhead ~= 920 cycles ~= 499 us -> ~1.0 kHz. Exact frequency is not
000072r 1               ; important for a fault beacon; this just lands it near 1 kHz on a probe.
000072r 1               ; Uses only the A and X registers - no ZP variables, no stack (it may be
000072r 1               ; entered before the stack is trusted).
000072r 1               post_fail:
000072r 1  A9 01          lda #$01
000074r 1  85 00          sta ZP_START          ; write 1 -> D0 high on the bus
000076r 1  A2 B6          ldx #$B6              ; 182 -> ~half period delay (~500 us)
000078r 1               @fh:
000078r 1  CA             dex
000079r 1  D0 FD          bne @fh
00007Br 1  A9 00          lda #$00
00007Dr 1  85 00          sta ZP_START          ; write 0 -> D0 low on the bus
00007Fr 1  A2 B6          ldx #$B6
000081r 1               @fl:
000081r 1  CA             dex
000082r 1  D0 FD          bne @fl
000084r 1  80 EC          bra post_fail         ; loop forever (fault beacon)
000086r 1               
000086r 1               ; post:
000086r 1               ; Power on Self Test
000086r 1               ; first thing will run on boot
000086r 1               ; post runs after the early ZP/stack test (done in the reset vector), so the
000086r 1               ; stack is already trusted here and we may use subroutines/registers freely.
000086r 1               post:
000086r 1                 ; --- Walk RAM from $0200 up, store top of RAM in RAM_SIZE ---
000086r 1                 ; Checkerboard-test each byte ($55 then $AA) and read it back. Stop at the
000086r 1                 ; first byte that fails or when we reach the I/O space at $7F00 (we must
000086r 1                 ; NOT write into $7F00+ which would hit real hardware registers). RAM_SIZE
000086r 1                 ; holds the first non-RAM address, i.e. (top usable RAM address + 1).
000086r 1                 ; This is destructive, which is fine at cold boot (RAM is undefined anyway).
000086r 1  A9 00          lda #$00
000088r 1  85 E9          sta POST_PTR          ; pointer low  = $00
00008Ar 1  A9 02          lda #$02
00008Cr 1  85 EA          sta POST_PTR+1        ; pointer high = $02  -> start at $0200
00008Er 1               @ram_walk:
00008Er 1                 ; stop once we reach I/O space ($7F00)
00008Er 1  A5 EA          lda POST_PTR+1
000090r 1  C9 7F          cmp #$7F
000092r 1  F0 1E          beq @ram_done         ; high byte $7F and low byte $00 -> at $7F00
000094r 1  A0 00          ldy #0
000096r 1  A9 55          lda #$55              ; pattern 1
000098r 1  91 E9          sta (POST_PTR),y
00009Ar 1  B1 E9          lda (POST_PTR),y
00009Cr 1  C9 55          cmp #$55
00009Er 1  D0 12          bne @ram_done         ; readback failed -> end of RAM
0000A0r 1  A9 AA          lda #$AA              ; pattern 2
0000A2r 1  91 E9          sta (POST_PTR),y
0000A4r 1  B1 E9          lda (POST_PTR),y
0000A6r 1  C9 AA          cmp #$AA
0000A8r 1  D0 08          bne @ram_done         ; readback failed -> end of RAM
0000AAr 1                 ; byte good, advance pointer
0000AAr 1  E6 E9          inc POST_PTR
0000ACr 1  D0 E0          bne @ram_walk
0000AEr 1  E6 EA          inc POST_PTR+1
0000B0r 1  80 DC          bra @ram_walk
0000B2r 1               @ram_done:
0000B2r 1                 ; POST_PTR now points one past the last good RAM byte -> store as RAM_SIZE
0000B2r 1  A5 E9          lda POST_PTR
0000B4r 1  85 E3          sta RAM_SIZE_L
0000B6r 1  A5 EA          lda POST_PTR+1
0000B8r 1  85 E4          sta RAM_SIZE_H
0000BAr 1               
0000BAr 1                 ; --- VIA1 Timer 1 periodic tick (TOCKS jiffy clock) ---
0000BAr 1                 ; STUB: left for when the VIA routines are implemented. This will configure
0000BAr 1                 ; VIA1 Timer 1 for a ~10ms periodic IRQ and the IRQ handler will increment
0000BAr 1                 ; the 3-byte TOCKS counter. The VIA is on the external I/O card (not onboard
0000BAr 1                 ; in rev 1.6), so this stays a stub for now.
0000BAr 1  EA             nop
0000BBr 1  60             rts
0000BCr 1               
0000BCr 1               ; ### Serial Routines ###
0000BCr 1               
0000BCr 1               ; init_serial:
0000BCr 1               ; Initializes the on board serial interface
0000BCr 1               ; Reset and set config for the ACIA. Init the RX buffer pointer
0000BCr 1               init_serial:
0000BCr 1  A9 03          lda #ACIA_RESET
0000BEr 1  8D 72 7F       sta ACIA_CONTROL
0000C1r 1  A9 16          lda #ACIA_CFG_28    ; 28800 8,N,1, see defines file for options
0000C3r 1  8D 72 7F       sta ACIA_CONTROL
0000C6r 1                 ; Init the RX buffer pointers
0000C6r 1  A9 00          lda #0
0000C8r 1  85 E5          sta PTR_RD_RX_BUF
0000CAr 1  85 E6          sta PTR_WR_RX_BUF
0000CCr 1  60             rts
0000CDr 1               
0000CDr 1               ; serial_out:
0000CDr 1               ; Transmit the char in the A Register via the on board
0000CDr 1               ; serial ACIA TTL-RS232
0000CDr 1               ; This routine uses pooling mode and will wait until the ACIA
0000CDr 1               ; TX Data Register (TXDR) bit 1 is Empty to send the character.
0000CDr 1               serial_out:
0000CDr 1  48             pha
0000CEr 1                 pool_acia: ; pulling mode until ready to TX
0000CEr 1  AD 72 7F         lda ACIA_STATUS
0000D1r 1  29 02            and #ACIA_TDRE     ; looking at Bit 1 TX Data Register Empty > High = Empty
0000D3r 1  F0 F9            beq pool_acia     ; pooling loop if empty
0000D5r 1  68             pla
0000D6r 1  8D 73 7F       sta ACIA_DATA       ; output char in A to TDRE
0000D9r 1  60             rts
0000DAr 1               
0000DAr 1               ; serial_poll:
0000DAr 1               ; Non-blocking, NON-echoing read of the ACIA. Checks whether a byte is
0000DAr 1               ; waiting and returns immediately either way.
0000DAr 1               ; - Byte waiting: byte in A, Carry set
0000DAr 1               ; - Nothing waiting: Carry clear (A is undefined)
0000DAr 1               ; - X, Y preserved
0000DAr 1               ; Intended for programs that poll the keyboard (BASIC GET / Ctrl-C check,
0000DAr 1               ; games, editors) and do their own echoing.
0000DAr 1               serial_poll:
0000DAr 1  AD 72 7F       lda ACIA_STATUS
0000DDr 1  29 01          and #ACIA_RDRF    ; look at Bit 0 RX Data Register Full > High = Full
0000DFr 1  F0 05          beq @no_data      ; nothing in the RX Buffer
0000E1r 1  AD 73 7F       lda ACIA_DATA     ; load the byte to A
0000E4r 1  38             sec               ; we have data set Carry
0000E5r 1  60             rts
0000E6r 1               @no_data:
0000E6r 1  18             clc               ; no data RX clear carry
0000E7r 1  60             rts
0000E8r 1               
0000E8r 1               ; serial_in:
0000E8r 1               ; Takes the byte recived by that ACIA and returns it in A (acumulator)
0000E8r 1               ; if a byte was received sets the Carry Flag, if not it clears it
0000E8r 1               ; Same as serial_poll, but echoes the received byte back to the terminal.
0000E8r 1               ;
0000E8r 1               serial_in:
0000E8r 1  20 rr rr       jsr serial_poll   ; non-blocking read, no echo
0000EBr 1  90 04          bcc @no_data      ; nothing received, carry already clear
0000EDr 1  20 rr rr       jsr serial_out    ; echo back (returns the byte in A)
0000F0r 1  38             sec               ; we have data set Carry
0000F1r 1               @no_data:
0000F1r 1  60             rts
0000F2r 1               
0000F2r 1               ; serial_in_raw:
0000F2r 1               ; Blocking read of one byte from the ACIA into A. No echo, no buffering.
0000F2r 1               ; Spins until a byte is available in the RX Data Register.
0000F2r 1               ; Used by the Intel HEX loader where we parse before echoing.
0000F2r 1               ; - A holds the received byte on return
0000F2r 1               ; - X, Y preserved
0000F2r 1               serial_in_raw:
0000F2r 1  AD 72 7F       lda ACIA_STATUS
0000F5r 1  29 01          and #ACIA_RDRF    ; Bit 0 RX Data Register Full > High = Full
0000F7r 1  F0 F9          beq serial_in_raw ; wait for a byte
0000F9r 1  AD 73 7F       lda ACIA_DATA     ; load the byte to A
0000FCr 1  60             rts
0000FDr 1               
0000FDr 1               ; serial_out_str:
0000FDr 1               ; Sends the a null terminated string via serial
0000FDr 1               ; uses the ZP variable PTR_TX (PTR_TX_L + PTR_TX_H) as the pointer
0000FDr 1               ; to the string memory location
0000FDr 1               ; - Y register is not preserved
0000FDr 1               serial_out_str:
0000FDr 1  A0 00          ldy #0
0000FFr 1                 @loop:
0000FFr 1  B1 E7            lda (PTR_TX),y
000101r 1  F0 06            beq @null_found
000103r 1  20 rr rr         jsr serial_out
000106r 1  C8               iny
000107r 1  80 F6            bra @loop
000109r 1                 @null_found:
000109r 1  60             rts
00010Ar 1               
00010Ar 1               ; # Helper Routines for Serial comms
00010Ar 1               
00010Ar 1               ; serial_out_hex:
00010Ar 1               ; Transmit the value of the A Register as ASCII HEX byte
00010Ar 1               ; Need to check this routine, can be optimized
00010Ar 1               serial_out_hex:
00010Ar 1  48             pha             ; keep the register for further manipulation
00010Br 1  4A             lsr             ; process the high nibble (MSD) shifting it to the low nibble
00010Cr 1  4A             lsr
00010Dr 1  4A             lsr
00010Er 1  4A             lsr
00010Fr 1  29 0F          and #$0F        ; Mask LSD for hex print.
000111r 1  09 30          ora #$30        ; this is like adding $30 > ASCII numbers start at $30 the OR %00110000 sets the high bits shifting the hex value to the right place.
000113r 1  C9 3A          cmp #$3A        ; is less than '9' $39
000115r 1  90 02          bcc @done       ; A is < 9 ($3A) so we already have the ASCII of the number
000117r 1  69 06          adc #$06        ; A is > 9 ($3A) so add 6 + carry (carry is set by CMP) to offset for letters (A $41 - F $46)
000119r 1               @done:
000119r 1  20 rr rr       jsr serial_out  ; send the MSD since its ready
00011Cr 1  68             pla             ; get the original value back
00011Dr 1  29 0F          and #$0F        ; process the low nibble (LSD)
00011Fr 1  09 30          ora #$30
000121r 1  C9 3A          cmp #$3A
000123r 1  90 02          bcc @done2
000125r 1  69 06          adc #$06
000127r 1               @done2:
000127r 1  20 rr rr       jsr serial_out
00012Ar 1  60             rts
00012Br 1               
00012Br 1               ; out_crlf
00012Br 1               ; Transmit a CR+LF > $0D,$0A
00012Br 1               ; Preserves all registers
00012Br 1               out_crlf:
00012Br 1  48             pha
00012Cr 1  A9 0D          lda #CR
00012Er 1  20 rr rr       jsr serial_out
000131r 1  A9 0A          lda #LF
000133r 1  20 rr rr       jsr serial_out
000136r 1  68             pla
000137r 1  60             rts
000138r 1               
000138r 1               ; ### Monitor Command Dispatch & Intel HEX Load/Save ###
000138r 1               
000138r 1               ; cmd_dispatch:
000138r 1               ; Called from WozMon's command parser with the current input char in A.
000138r 1               ; Decodes the single-letter commands R (run), L (load Intel HEX) and
000138r 1               ; S (save Intel HEX). If the char is none of these, returns with A and X
000138r 1               ; unchanged so WozMon can continue its normal hex parse.
000138r 1               ; For R/L/S the command is executed and control returns to WozMon
000138r 1               ; (WARMWOZ) rather than back to the caller.
000138r 1               ; - On no match: A and X preserved, RTS
000138r 1               cmd_dispatch:
000138r 1  C9 52          cmp #'R'          ; run program at XAM address?
00013Ar 1  F0 09          beq @run
00013Cr 1  C9 4C          cmp #'L'          ; load Intel HEX?
00013Er 1  F0 0E          beq @load
000140r 1  C9 53          cmp #'S'          ; save Intel HEX?
000142r 1  F0 10          beq @save
000144r 1  60             rts               ; not a command, back to WozMon hex parse (A,X intact)
000145r 1               @run:
000145r 1  20 rr rr       jsr @run_sub      ; JSR so an RTS from the user program returns here
000148r 1  4C rr rr       jmp WARMWOZ       ; then warm-start the monitor
00014Br 1               @run_sub:
00014Br 1  6C 24 00       jmp (XAML)        ; run at the last XAM address
00014Er 1               @load:
00014Er 1  20 rr rr       jsr load_ihex
000151r 1  4C rr rr       jmp WARMWOZ
000154r 1               @save:
000154r 1  20 rr rr       jsr save_ihex
000157r 1  4C rr rr       jmp WARMWOZ
00015Ar 1               
00015Ar 1               ; load_ihex:
00015Ar 1               ; Receive an Intel HEX stream from the serial port and store it in memory.
00015Ar 1               ; Each data record (type 00) is written at the 16-bit address carried in the
00015Ar 1               ; record itself, so no manual deposit address is needed. A record checksum is
00015Ar 1               ; verified; on mismatch the load aborts with an error message. An EOF record
00015Ar 1               ; (type 01) ends the load with "OK".
00015Ar 1               ; Record: ':' LL AAAA TT <data...> CC   (all hex ASCII)
00015Ar 1               ; Uses IHEX_* zero page scratch. Clobbers A, X, Y.
00015Ar 1               load_ihex:
00015Ar 1                 ; prompt
00015Ar 1  A9 rr          lda #<loadMsg
00015Cr 1  85 E7          sta PTR_TX
00015Er 1  A9 rr          lda #>loadMsg
000160r 1  85 E8          sta PTR_TX_H
000162r 1  20 rr rr       jsr serial_out_str
000165r 1               @next_record:
000165r 1  20 rr rr       jsr serial_in_raw     ; wait for start-of-record
000168r 1  C9 3A          cmp #':'
00016Ar 1  D0 F9          bne @next_record      ; ignore anything until a ':' (CR/LF between records)
00016Cr 1  64 34          stz IHEX_SUM          ; reset running checksum (65C02 stz)
00016Er 1  20 rr rr       jsr get_hex_byte      ; LL  byte count
000171r 1  85 32          sta IHEX_LEN
000173r 1  20 rr rr       jsr get_hex_byte      ; AAAA high byte of address
000176r 1  85 31          sta IHEX_ADDR_H
000178r 1  20 rr rr       jsr get_hex_byte      ; AAAA low byte of address
00017Br 1  85 30          sta IHEX_ADDR_L
00017Dr 1  20 rr rr       jsr get_hex_byte      ; TT  record type
000180r 1  85 33          sta IHEX_TYPE
000182r 1                 ; data bytes. Only type 00 records are written to memory; any other record
000182r 1                 ; type (e.g. 04 extended linear address) is still read so its checksum is
000182r 1                 ; validated, but the bytes are discarded.
000182r 1  A0 00          ldy #0
000184r 1               @data_loop:
000184r 1  C4 32          cpy IHEX_LEN
000186r 1  F0 0C          beq @read_checksum
000188r 1  20 rr rr       jsr get_hex_byte      ; one data byte (also folds into IHEX_SUM)
00018Br 1  A6 33          ldx IHEX_TYPE         ; store only for data records (type 00)
00018Dr 1  D0 02          bne @skip_store
00018Fr 1  91 30          sta (IHEX_ADDR),y     ; store at record address + index
000191r 1               @skip_store:
000191r 1  C8             iny
000192r 1  80 F0          bra @data_loop
000194r 1               @read_checksum:
000194r 1  20 rr rr       jsr get_hex_byte      ; CC  record checksum byte
000197r 1                 ; At this point IHEX_SUM = (sum of all record bytes incl checksum) & $FF.
000197r 1                 ; A valid record makes that total zero.
000197r 1  A5 34          lda IHEX_SUM
000199r 1  D0 14          bne @bad_checksum
00019Br 1                 ; record good - was it the EOF record?
00019Br 1  A5 33          lda IHEX_TYPE
00019Dr 1  C9 01          cmp #$01
00019Fr 1  F0 02          beq @done
0001A1r 1  80 C2          bra @next_record
0001A3r 1               @done:
0001A3r 1  A9 rr          lda #<okMsg
0001A5r 1  85 E7          sta PTR_TX
0001A7r 1  A9 rr          lda #>okMsg
0001A9r 1  85 E8          sta PTR_TX_H
0001ABr 1  20 rr rr       jsr serial_out_str
0001AEr 1  60             rts
0001AFr 1               @bad_checksum:
0001AFr 1  A9 rr          lda #<errMsg
0001B1r 1  85 E7          sta PTR_TX
0001B3r 1  A9 rr          lda #>errMsg
0001B5r 1  85 E8          sta PTR_TX_H
0001B7r 1  20 rr rr       jsr serial_out_str
0001BAr 1  60             rts
0001BBr 1               
0001BBr 1               ; save_ihex:
0001BBr 1               ; Emit memory as an Intel HEX stream over the serial port.
0001BBr 1               ; Range comes from WozMon's parsed block syntax: type "START.END" then "S".
0001BBr 1               ;   XAML/XAMH = start address, L/H = end address (inclusive).
0001BBr 1               ; Writes 16-byte type 00 data records followed by a type 01 EOF record.
0001BBr 1               ; Uses IHEX_* zero page scratch. Clobbers A, X, Y.
0001BBr 1               save_ihex:
0001BBr 1                 ; WozMon's block-XAM ("START.END") leaves the start address in STL/STH and
0001BBr 1                 ; the end address in L/H, but it advances XAML/XAMH to the end while dumping.
0001BBr 1                 ; Re-seed our working pointer (XAML/XAMH) from STL/STH so we start at START.
0001BBr 1  A5 26          lda STL
0001BDr 1  85 24          sta XAML
0001BFr 1  A5 27          lda STH
0001C1r 1  85 25          sta XAMH
0001C3r 1  20 rr rr       jsr out_crlf
0001C6r 1               @line:
0001C6r 1                 ; bytes remaining = end - start ; stop once start > end
0001C6r 1  A5 25          lda XAMH
0001C8r 1  C5 29          cmp H
0001CAr 1  90 0C          bcc @emit_line        ; start high < end high -> more to do
0001CCr 1  D0 4E          bne @eof              ; start high > end high -> done
0001CEr 1  A5 24          lda XAML
0001D0r 1  C5 28          cmp L
0001D2r 1  F0 04          beq @emit_line        ; equal: still one byte to emit this pass
0001D4r 1  90 02          bcc @emit_line        ; start low < end low -> more to do
0001D6r 1  80 44          bra @eof              ; start > end -> done
0001D8r 1               @emit_line:
0001D8r 1                 ; decide this record's length: min(16, end-start+1)
0001D8r 1                 ; compute remaining low estimate; simplest robust approach: emit up to 16
0001D8r 1                 ; bytes but stop at end address inside the loop.
0001D8r 1  64 34          stz IHEX_SUM
0001DAr 1  A9 3A          lda #':'
0001DCr 1  20 rr rr       jsr serial_out
0001DFr 1                 ; byte count placeholder handling: we count as we go, so first figure length
0001DFr 1  20 rr rr       jsr @calc_len         ; -> IHEX_LEN (1..16)
0001E2r 1  A5 32          lda IHEX_LEN
0001E4r 1  20 rr rr       jsr put_hex_byte      ; LL
0001E7r 1  A5 25          lda XAMH
0001E9r 1  20 rr rr       jsr put_hex_byte      ; AAAA hi
0001ECr 1  A5 24          lda XAML
0001EEr 1  20 rr rr       jsr put_hex_byte      ; AAAA lo
0001F1r 1  A9 00          lda #$00
0001F3r 1  20 rr rr       jsr put_hex_byte      ; TT = 00 data
0001F6r 1  A0 00          ldy #0
0001F8r 1               @save_data:
0001F8r 1  C4 32          cpy IHEX_LEN
0001FAr 1  F0 08          beq @save_cksum
0001FCr 1  B1 24          lda (XAML),y
0001FEr 1  20 rr rr       jsr put_hex_byte
000201r 1  C8             iny
000202r 1  80 F4          bra @save_data
000204r 1               @save_cksum:
000204r 1                 ; checksum = two's complement of sum so far
000204r 1  A5 34          lda IHEX_SUM
000206r 1  49 FF          eor #$FF
000208r 1  1A             inc
000209r 1  20 rr rr       jsr put_hex_byte
00020Cr 1  20 rr rr       jsr out_crlf
00020Fr 1                 ; advance start by IHEX_LEN
00020Fr 1  A5 24          lda XAML
000211r 1  18             clc
000212r 1  65 32          adc IHEX_LEN
000214r 1  85 24          sta XAML
000216r 1  90 AE          bcc @line
000218r 1  E6 25          inc XAMH
00021Ar 1  80 AA          bra @line
00021Cr 1               @eof:
00021Cr 1                 ; EOF record :00000001FF
00021Cr 1  A9 rr          lda #<eofRec
00021Er 1  85 E7          sta PTR_TX
000220r 1  A9 rr          lda #>eofRec
000222r 1  85 E8          sta PTR_TX_H
000224r 1  20 rr rr       jsr serial_out_str
000227r 1  60             rts
000228r 1               ; @calc_len: how many bytes to emit this record (1..16), bounded by end addr
000228r 1               @calc_len:
000228r 1                 ; remaining = end - start (16-bit). If remaining+1 >= 16 use 16 else remaining+1
000228r 1                 ; compute end - start
000228r 1  A5 28          lda L
00022Ar 1  38             sec
00022Br 1  E5 24          sbc XAML
00022Dr 1  85 35          sta IHEX_TMP          ; low of (end-start)
00022Fr 1  A5 29          lda H
000231r 1  E5 25          sbc XAMH              ; high of (end-start)
000233r 1  D0 06          bne @full             ; high byte nonzero -> at least 256 left, use 16
000235r 1  A5 35          lda IHEX_TMP
000237r 1  C9 0F          cmp #15               ; remaining low >= 15 ? (remaining+1 >= 16)
000239r 1  90 05          bcc @partial
00023Br 1               @full:
00023Br 1  A9 10          lda #16
00023Dr 1  85 32          sta IHEX_LEN
00023Fr 1  60             rts
000240r 1               @partial:
000240r 1  A5 35          lda IHEX_TMP          ; remaining (end-start), bytes left-1
000242r 1  1A             inc                   ; +1 to make it inclusive count
000243r 1  85 32          sta IHEX_LEN
000245r 1  60             rts
000246r 1               
000246r 1               ; get_hex_byte:
000246r 1               ; Read two ASCII hex characters from serial (raw, no echo) and return the
000246r 1               ; assembled byte in A. The byte is also added into IHEX_SUM for checksum
000246r 1               ; verification. Clobbers A; preserves X, Y.
000246r 1               get_hex_byte:
000246r 1  DA             phx
000247r 1  20 rr rr       jsr serial_in_raw     ; high nibble char
00024Ar 1  20 rr rr       jsr ascii_to_nib
00024Dr 1  0A             asl
00024Er 1  0A             asl
00024Fr 1  0A             asl
000250r 1  0A             asl
000251r 1  85 35          sta IHEX_TMP          ; high nibble in place
000253r 1  20 rr rr       jsr serial_in_raw     ; low nibble char
000256r 1  20 rr rr       jsr ascii_to_nib
000259r 1  05 35          ora IHEX_TMP          ; combine nibbles
00025Br 1  AA             tax                   ; keep byte in X
00025Cr 1  18             clc
00025Dr 1  65 34          adc IHEX_SUM          ; fold into running checksum
00025Fr 1  85 34          sta IHEX_SUM
000261r 1  8A             txa                   ; return byte in A
000262r 1  FA             plx
000263r 1  60             rts
000264r 1               
000264r 1               ; ascii_to_nib:
000264r 1               ; Convert ASCII hex char in A ('0'-'9','A'-'F','a'-'f') to nibble value 0-15.
000264r 1               ; No validation - assumes well-formed input. Clobbers A.
000264r 1               ascii_to_nib:
000264r 1  C9 3A          cmp #'9'+1
000266r 1  90 04          bcc @digit            ; '0'-'9'
000268r 1  29 DF          and #$DF              ; fold lower to upper case
00026Ar 1  E9 07          sbc #$07              ; 'A'(after carry) maps to 10 ; carry set from cmp path
00026Cr 1               @digit:
00026Cr 1  29 0F          and #$0F
00026Er 1  60             rts
00026Fr 1               
00026Fr 1               ; put_hex_byte:
00026Fr 1               ; Transmit the byte in A as two ASCII hex chars and fold it into IHEX_SUM.
00026Fr 1               ; Clobbers A; preserves X, Y.
00026Fr 1               put_hex_byte:
00026Fr 1  48             pha
000270r 1  18             clc
000271r 1  65 34          adc IHEX_SUM          ; checksum tracks raw byte value
000273r 1  85 34          sta IHEX_SUM
000275r 1  68             pla
000276r 1  20 rr rr       jsr serial_out_hex    ; reuse BIOS hex printer
000279r 1  60             rts
00027Ar 1               
00027Ar 1               ; ROM Data
00027Ar 1               ; Startup Messages
00027Ar 1               startupMessage:
00027Ar 1  0C 0D 0A 23    .byte	$0C,$0D,$0A,"## Simple6502 ##",$0D,$0A,"-- v"
00027Er 1  23 20 53 69  
000282r 1  6D 70 6C 65  
000293r 1  30 2E 36 2E    .byte VERSION
000297r 1  31           
000298r 1  0D 0A 4F 4B    .byte	$0D,$0A,"OK"
00029Cr 1  0D 0A 00       .byte $0D,$0A,$00
00029Fr 1               wozmonMessage:
00029Fr 1  0D 0A 3E 20    .byte	CR,LF,"> WozMon <"
0002A3r 1  57 6F 7A 4D  
0002A7r 1  6F 6E 20 3C  
0002ABr 1  0D 0A 00       .byte CR,LF,$00
0002AEr 1               ; Intel HEX loader/saver messages
0002AEr 1               loadMsg:
0002AEr 1  0D 0A 50 61    .byte CR,LF,"Paste Intel HEX..",CR,LF,$00
0002B2r 1  73 74 65 20  
0002B6r 1  49 6E 74 65  
0002C4r 1               okMsg:
0002C4r 1  0D 0A 4F 4B    .byte CR,LF,"OK",CR,LF,$00
0002C8r 1  0D 0A 00     
0002CBr 1               errMsg:
0002CBr 1  0D 0A 43 4B    .byte CR,LF,"CKSUM ERR",CR,LF,$00
0002CFr 1  53 55 4D 20  
0002D3r 1  45 52 52 0D  
0002D9r 1               eofRec:
0002D9r 1  3A 30 30 30    .byte ":00000001FF",CR,LF,$00
0002DDr 1  30 30 30 30  
0002E1r 1  31 46 46 0D  
0002E7r 1               
0002E7r 1               ; ### Interrupt Handlers ###
0002E7r 1               
0002E7r 1               ; # IRQ Handler
0002E7r 1               irq_handler:
0002E7r 1  EA               nop       ; EA
0002E8r 1                   ; BIT  VIA1_STATUS   ; Check 6522 VIA1's status register without loading.
0002E8r 1                   ; BMI  SERVICE_VIA1  ; If it caused the interrupt, branch to service it.
0002E8r 1                   ; BIT  VIA2_STATUS   ; Otherwise, check VIA2's status register.
0002E8r 1                   ; BMI  SERVICE_VIA2  ; If that one did the interrupt, branch to service it.
0002E8r 1                   ; JMP  SERVICE_ACIA  ; If both VIAs say "not me," it had to be the 6551 ACIA.
0002E8r 1  40               rti       ; 40
0002E9r 1               
0002E9r 1               ; # NMI Handler Vector
0002E9r 1               nmi_handler:
0002E9r 1  EA               nop       ; EA
0002EAr 1  40               rti       ; 40
0002EBr 1               
0002EBr 1               ; -- MONITOR --
0002EBr 1               ; .org $FF00
0002EBr 1               ; ## WozMon ##
0002EBr 1               .segment "WOZMON"
000000r 1               .include "wozmon_sbc.s"
000000r 2               ;  The WOZ Monitor for the Apple 1
000000r 2               ;  Written by Steve Wozniak in 1976
000000r 2               ;  Adapted to the simple6502 SBC with MC60B50 ACIA by Mariano Luna
000000r 2               ;
000000r 2               ; Changelog:
000000r 2               ; - 5 bytes less
000000r 2               ; - updated to use BIOS ruitines for Serial int and some I/O
000000r 2               ; - moved Variables to defines_[platfrom].s
000000r 2               ; - updates to use standard ASCII (not Apple 1 bit 7 set)
000000r 2               ; - input now case insensitive
000000r 2               ; -
000000r 2               
000000r 2               ; TEST PROGRAM
000000r 2               ; 0400: A9 20 20 77 80 18 69 01 C9 7F 30 F6 4C 00 04
000000r 2               ;
000000r 2               ;                            * = $0400
000000r 2               ; 0400   A9 20      L0400     LDA #$20
000000r 2               ; 0402   20 77 80   L0402     JSR $8077
000000r 2               ; 0405   18                   CLC
000000r 2               ; 0406   69 01                ADC #$01
000000r 2               ; 0408   C9 7F                CMP #$7F
000000r 2               ; 040A   30 F6                BMI L0402
000000r 2               ; 040C   4C 00 04             JMP L0400
000000r 2               ;                             .END
000000r 2               ; Page 0 Variables (XAML..MODE) are defined in defines_simple6502.s so that
000000r 2               ; the BIOS Intel HEX routines can share them as zero page.
000000r 2               
000000r 2               ; Other Variables
000000r 2               
000000r 2               IN              = $0200         ;  Input buffer to $027F
000000r 2               
000000r 2               WOZMON:
000000r 2                               ; Run out of mem so assuming serial is inizialized by BIOS
000000r 2                               ; with only one of this JSRs 'WOZMON' overflows the
000000r 2                               ; 'MONITOR' segment memory area by 1 byte
000000r 2                               ; if you are running this independently of the bios you
000000r 2                               ; will need to uncomment the next line or 2 lines if you fancy a CR + LF
000000r 2                               ; JSR     init_serial    ; Initialize ACIA
000000r 2                               ; JSR     out_crlf       ; send CR+LF
000000r 2  A9 1B        WARMWOZ:        LDA     #$1B           ; Begin with escape.
000002r 2               NOTCR:
000002r 2  C9 08                        CMP     #$08           ; Backspace key? * Changed to the actual BS key
000004r 2  F0 11                        BEQ     BACKSPACE      ; Yes.
000006r 2  C9 1B                        CMP     #$1B           ; ESC?
000008r 2  F0 03                        BEQ     ESCAPE         ; Yes.
00000Ar 2  C8                           INY                    ; Advance text index.
00000Br 2  10 0D                        BPL     NEXTCHAR       ; Auto ESC if line longer than 127.
00000Dr 2               ESCAPE:
00000Dr 2  A9 5C                        LDA     #$5C           ; "\".
00000Fr 2  20 rr rr                     JSR     ECHO           ; Output it.
000012r 2               GETLINE:
000012r 2  20 rr rr                     JSR     out_crlf       ; * Send CR+LF
000015r 2  A0 01                        LDY     #$01           ; Initialize text index.
000017r 2  88           BACKSPACE:      DEY                    ; Back up text index.
000018r 2  30 F8                        BMI     GETLINE        ; Beyond start of line, reinitialize.
00001Ar 2               NEXTCHAR:
00001Ar 2  AD 72 7F                     LDA     ACIA_STATUS    ; Check AICIA status.
00001Dr 2  29 01                        AND     #ACIA_RDRF     ; Key ready?
00001Fr 2  F0 F9                        BEQ     NEXTCHAR       ; Loop until ready.
000021r 2  AD 73 7F                     LDA     ACIA_DATA      ; Load character. B7 will be '0'.
000024r 2  C9 60                        CMP     #$60           ;* Lower case?
000026r 2  30 02                        BMI     GO_ON          ;* Nope, go on
000028r 2  29 5F                        AND     #$5F           ;* convert to Upper case ASCII
00002Ar 2  99 00 02     GO_ON:          STA     IN,Y           ; Add to text buffer.
00002Dr 2  20 rr rr                     JSR     ECHO           ; Display character.
000030r 2  C9 0D                        CMP     #$0D           ; CR?
000032r 2  D0 CE                        BNE     NOTCR          ; No.
000034r 2  A0 FF                        LDY     #$FF           ; Reset text index.
000036r 2  A9 00                        LDA     #$00           ; For XAM mode.
000038r 2  AA                           TAX                    ; 0->X.
000039r 2               SETBLOCK:
000039r 2  0A                           ASL
00003Ar 2               SETSTOR:
00003Ar 2  0A                           ASL                    ; Leaves $7B if setting STOR mode.
00003Br 2  85 2B                        STA     MODE           ; $00 = XAM, $74 = STOR, $B8 = BLOCK XAM.
00003Dr 2               BLSKIP:
00003Dr 2  C8                           INY                    ; Advance text index.
00003Er 2               NEXTITEM:
00003Er 2  B9 00 02                     LDA     IN,Y           ; Get character.
000041r 2  C9 0D                        CMP     #$0D           ; CR?
000043r 2  F0 CD                        BEQ     GETLINE        ; Yes, done this line.
000045r 2  C9 2E                        CMP     #$2E           ; "."?
000047r 2  90 F4                        BCC     BLSKIP         ; Skip delimiter.
000049r 2  F0 EE                        BEQ     SETBLOCK       ; Set BLOCK XAM mode.
00004Br 2  C9 3A                        CMP     #$3A           ; ":"?
00004Dr 2  F0 EB                        BEQ     SETSTOR        ; Yes, set STOR mode.
00004Fr 2  20 rr rr                     JSR     cmd_dispatch   ;* Handle R/L/S letter commands in BIOS.
000052r 2                                                      ;* Returns (A,X preserved) if not a command.
000052r 2  86 28                        STX     L              ; $00 -> L. * Woz is relying on X being zero
000054r 2  86 29                        STX     H              ;    and H.
000056r 2  84 2A                        STY     YSAV           ; Save Y for comparison
000058r 2               NEXTHEX:
000058r 2  B9 00 02                     LDA     IN,Y           ; Get character for hex test.
00005Br 2  49 30                        EOR     #$30           ; Map digits to $0-9.
00005Dr 2  C9 0A                        CMP     #$0A           ; Digit?
00005Fr 2  90 06                        BCC     DIG            ; Yes.
000061r 2  69 88                        ADC     #$88           ; Map letter "A"-"F" to $FA-FF.
000063r 2  C9 FA                        CMP     #$FA           ; Hex letter?
000065r 2  90 11                        BCC     NOTHEX         ; No, character not hex.
000067r 2               DIG:
000067r 2  0A                           ASL
000068r 2  0A                           ASL                    ; Hex digit to MSD of A.
000069r 2  0A                           ASL
00006Ar 2  0A                           ASL
00006Br 2  A2 04                        LDX     #$04           ; Shift count.
00006Dr 2               HEXSHIFT:
00006Dr 2  0A                           ASL                    ; Hex digit left, MSB to carry.
00006Er 2  26 28                        ROL     L              ; Rotate into LSD.
000070r 2  26 29                        ROL     H              ; Rotate into MSD's.
000072r 2  CA                           DEX                    ; Done 4 shifts?
000073r 2  D0 F8                        BNE     HEXSHIFT       ; No, loop.
000075r 2  C8                           INY                    ; Advance text index.
000076r 2  D0 E0                        BNE     NEXTHEX        ; Always taken. Check next character for hex.
000078r 2               NOTHEX:
000078r 2  C4 2A                        CPY     YSAV           ; Check if L, H empty (no hex digits).
00007Ar 2  F0 91                        BEQ     ESCAPE         ; Yes, generate ESC sequence.
00007Cr 2  24 2B                        BIT     MODE           ; Test MODE byte.
00007Er 2  50 0D                        BVC     NOTSTOR        ; B6=0 is STOR, 1 is XAM and BLOCK XAM.
000080r 2  A5 28                        LDA     L              ; LSD's of hex data.
000082r 2  81 26                        STA     (STL,X)        ; Store current 'store index'.
000084r 2  E6 26                        INC     STL            ; Increment store index.
000086r 2  D0 B6                        BNE     NEXTITEM       ; Get next item (no carry).
000088r 2  E6 27                        INC     STH            ; Add carry to 'store index' high order.
00008Ar 2  4C rr rr     TONEXTITEM:     JMP     NEXTITEM       ; Get next command item.
00008Dr 2               ; R (run), L (Intel HEX load) and S (Intel HEX save) commands are now
00008Dr 2               ; handled by cmd_dispatch in the BIOS segment. This frees WozMon space and
00008Dr 2               ; lets those routines be reused from other code. See BIOS.s.
00008Dr 2               NOTSTOR:
00008Dr 2  30 29                        BMI     XAMNEXT        ; B7 = 0 for XAM, 1 for BLOCK XAM.
00008Fr 2  A2 02                        LDX     #$02           ; Byte count.
000091r 2  B5 27        SETADR:         LDA     L-1,X          ; Copy hex data to
000093r 2  95 25                        STA     STL-1,X        ;  'store index'.
000095r 2  95 23                        STA     XAML-1,X       ; And to 'XAM index'.
000097r 2  CA                           DEX                    ; Next of 2 bytes.
000098r 2  D0 F7                        BNE     SETADR         ; Loop unless X = 0.
00009Ar 2               NXTPRNT:
00009Ar 2  D0 12                        BNE     PRDATA         ; NE means no address to print.
00009Cr 2  20 rr rr                     JSR     out_crlf       ; Send CR+LF
00009Fr 2  A5 25                        LDA     XAMH           ; 'Examine index' high-order byte.
0000A1r 2  20 rr rr                     JSR     PRBYTE         ; Output it in hex format.
0000A4r 2  A5 24                        LDA     XAML           ; Low-order 'examine index' byte.
0000A6r 2  20 rr rr                     JSR     PRBYTE         ; Output it in hex format.
0000A9r 2  A9 3A                        LDA     #$3A           ; ":".
0000ABr 2  20 rr rr                     JSR     ECHO           ; Output it.
0000AEr 2               PRDATA:
0000AEr 2  A9 20                        LDA     #$20           ; Blank.
0000B0r 2  20 rr rr                     JSR     ECHO           ; Output it.
0000B3r 2  A1 24                        LDA     (XAML,X)       ; Get data byte at 'examine index'.
0000B5r 2  20 rr rr                     JSR     PRBYTE         ; Output it in hex format.
0000B8r 2  86 2B        XAMNEXT:        STX     MODE           ; 0 -> MODE (XAM mode).
0000BAr 2  A5 24                        LDA     XAML
0000BCr 2  C5 28                        CMP     L              ; Compare 'examine index' to hex data.
0000BEr 2  A5 25                        LDA     XAMH
0000C0r 2  E5 29                        SBC     H
0000C2r 2  B0 C6                        BCS     TONEXTITEM     ; Not less, so no more data to output.
0000C4r 2  E6 24                        INC     XAML
0000C6r 2  D0 02                        BNE     MOD8CHK        ; Increment 'examine index'.
0000C8r 2  E6 25                        INC     XAMH
0000CAr 2               MOD8CHK:
0000CAr 2  A5 24                        LDA     XAML           ; Check low-order 'examine index' byte
0000CCr 2  29 0F                        AND     #$0F           ; * Changed to diesplay 16 bytes per line AND #$07 ; For MOD 8 = 0  #%0000.0111
0000CEr 2  10 CA                        BPL     NXTPRNT        ; Always taken.
0000D0r 2               PRBYTE:
0000D0r 2  48                           PHA                    ; Save A for LSD.
0000D1r 2  4A                           LSR
0000D2r 2  4A                           LSR
0000D3r 2  4A                           LSR                    ; MSD to LSD position.
0000D4r 2  4A                           LSR
0000D5r 2  20 rr rr                     JSR     PRHEX          ; Output hex digit.
0000D8r 2  68                           PLA                    ; Restore A.
0000D9r 2               PRHEX:
0000D9r 2  29 0F                        AND     #$0F           ; Mask LSD for hex print.
0000DBr 2  09 30                        ORA     #$30           ; Add "0".
0000DDr 2  C9 3A                        CMP     #$3A           ; Digit?
0000DFr 2  90 02                        BCC     ECHO           ; Yes, output it.
0000E1r 2  69 06                        ADC     #$06           ; Add offset for letter.
0000E3r 2               ECHO:
0000E3r 2  48                           PHA                    ; Save A.
0000E4r 2  8D 73 7F                     STA     ACIA_DATA      ; Output character.
0000E7r 2  A9 FF                        LDA     #$FF           ; Initialize delay loop.
0000E9r 2  3A           TXDELAY:        DEC                    ; Decrement A.
0000EAr 2  D0 FD                        BNE     TXDELAY        ; Until A gets to 0.
0000ECr 2  68                           PLA                    ; Restore A.
0000EDr 2  60                           RTS                    ; Return.
0000EEr 2               
0000EEr 2               
0000EEr 2               
0000EEr 1               
0000EEr 1               ; -- VECTORS --
0000EEr 1               ;.org $fffa
0000EEr 1               .segment "RESETVECTORS"
000000r 1  rr rr          .word nmi_handler ; NMI
000002r 1  rr rr          .word reset       ; RESET
000004r 1  rr rr          .word irq_handler ; IRQ/BRK
000004r 1               
